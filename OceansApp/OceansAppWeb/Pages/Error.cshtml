@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}
<div class="container" style="display:flex;justify-content:center;">
    <div id="access-denied-cont">
<h1 class="text-danger">¡Hubo un error!</h1>
<h2 class="text-danger">Se produjo un error al procesar su solicitud, por favor ponte en contacto con el administrador para solucionar el problema.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<p id="error-message">
   
</p>

</div>
</div>