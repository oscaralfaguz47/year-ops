@using OceansApp.Utility
@model Pagination
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="~/css/Shared/pagination.css" />

<div class="pagination-container">
    <div style="display: flex; align-items: center;">
        <label style="margin-right: 10px;">Total Resultados: @Model.TotalResults</label>

        <button type="submit" name="PageIndex" value="1" class="btn btn-sm btn-primary mr-1" disabled="@(Model.PageIndex == 1)">
            &laquo;&laquo;
        </button>

        <button type="submit" name="PageIndex" value="@Model.PageIndex - 1" class="btn btn-sm btn-primary mr-1" disabled="@(Model.PageIndex == 1)">
            &laquo;
        </button>

        <select name="PageSize" class="form-control form-control-sm mr-1" onchange="submitForm('filtersPaginationForm')">
            <option value="5" selected>5</option>
            <option value="10">10</option>
            <option value="20">20</option>
        </select>

        <label class="mr-1">items per page</label>

        @if (ViewData["TotalPages"] != null)
        {
            int totalPages = (int)ViewData["TotalPages"];
            <button type="submit" name="PageIndex" value="@Model.PageIndex + 1" class="btn btn-sm btn-primary mr-1" disabled="@(Model.PageIndex >= totalPages)">
                &raquo;
            </button>

            <button type="submit" name="PageIndex" value="@totalPages" class="btn btn-sm btn-primary mr-1" disabled="@(Model.PageIndex >= totalPages)">
                &raquo;&raquo;
            </button>

        }
    </div>
</div>

<script>
    function submitForm(formId) {
        var form = document.getElementById(formId);
        form.submit();
    }
</script>