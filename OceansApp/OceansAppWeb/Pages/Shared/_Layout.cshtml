@using OceansApp.Utility
@using Microsoft.AspNetCore.Identity
@using OceansApp.Utility.ConstantData.Claims
@using OceansApp.Utility.ConstantData.Claims.AdminCenter
@using OceansApp.Utility.ConstantData.Claims.Finances
@using OceansApp.Utility.ConstantData.Claims.General
@using OceansApp.Utility.ConstantData.Claims.AccountManagement
@using OceansApp.Utility.ConstantData.Claims.Recruiting
@using OceansApp.Utility.ConstantData.Claims.TrackingTool
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Oceans App</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon-oceans.webp" />
    <link rel="stylesheet" href="~/css/bootswatchTheme.css" />

    @*Custom styles*@
    <link rel="stylesheet" href="~/css/site.css?v=@DateTime.Now.Ticks" asp-append-version="true" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <script src="https://kit.fontawesome.com/a609136563.js" crossorigin="anonymous"></script>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <header>
            @{
                var twoFactor = ViewData["TwoFactorNoEnabled"];
                if (twoFactor == null || twoFactor.ToString().ToLower() == "false")
                {
                    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
                        <div class="container-fluid">

                            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Dashboard"><img class="img-logo" src="/img/logo-white.png" /></a>
                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                                <span class="navbar-toggler-icon"></span>
                            </button>

                            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                                <ul class="navbar-nav flex-grow-1">
                                    @if (SignInManager.IsSignedIn(User))
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
                                        </li>
                                         @if (User.HasClaim(c => c.Type == TrackingToolClaimsCD.Reporting_My_Time_Basic_Access_ClaimType && c.Value == TrackingToolClaimsCD.Reporting_My_Time_Basic_Access_ClaimValue))
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link" asp-area="TrackingTool" asp-controller="ReportingMyTime" asp-action="Index"><i class="bi bi-stopwatch"></i> Timesheet</a>
                                            </li>
                                        }
                                        @if (User.HasClaim(c => c.Type == FinancesClaimsCD.Financial_Calculator_ClaimType && c.Value == FinancesClaimsCD.Financial_Calculator_ClaimValue))
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link" asp-area="Finances" asp-controller="Calculator" asp-action="Index"><i class="bi bi-calculator"></i> Calculator</a>
                                            </li>
                                        }
                                        @if (User.IsAuthorizedForGeneral())
                                        {
                                            <li class="nav-item dropdown">
                                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false"><i class="bi bi-house-heart-fill"></i> General</a>
                                                <div class="dropdown-menu">
                                                    @if (User.IsAuthorizedForConsultantsPage())
                                                    {
                                                        <a id="manage" class="nav-link text-dark" asp-area="General" asp-controller="Consultants" asp-action="Index">Consultants</a>
                                                    }
                                                    @if (User.HasClaim(c => c.Type == HolidaysClaimsCD.Holidays_Page_ClaimType && c.Value == HolidaysClaimsCD.Holidays_Page_ClaimValue))
                                                    {
                                                        <a id="holidays" class="nav-link text-dark" asp-area="General" asp-controller="ConsultantHolidays" asp-action="Index">Holidays</a>
                                                    }
                                                    @if (User.HasClaim(c => c.Type == ConsultantReimbursedBenefitsClaimsCD.Manage_Consultant_Reimbursed_Benefits_ClaimType && c.Value == ConsultantReimbursedBenefitsClaimsCD.Manage_Consultant_Reimbursed_Benefits_ClaimValue))
                                                    {
                                                        <a id="consultant-reimbursed-benefits" class="nav-link text-dark" asp-area="General" asp-controller="ConsultantReimbursedBenefits" asp-action="Index">Benefit Reimbursements</a>
                                                    }
                                                </div>
                                            </li>
                                        }
                                        @if (User.IsAuthorizedForAccountManagement())
                                        {
                                            <li class="nav-item dropdown">
                                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false"><i class="bi bi-journal-check"></i> Account Management</a>

                                                <div class="dropdown-menu">
                                                    @if (User.HasClaim(c => c.Type == ClientsClaimsCD.Clients_Page_ClaimType && c.Value == ClientsClaimsCD.Clients_Page_ClaimValue))
                                                    {
                                                        <a class="nav-link text-dark" asp-area="AccountManagement" asp-controller="Clients" asp-action="Index">Clients</a>
                                                    }
                                                    @if (User.HasClaim(c => c.Type == ProjectsClaimsCD.Projects_Page_ClaimType && c.Value == ProjectsClaimsCD.Projects_Page_ClaimValue))
                                                    {
                                                        <a class="nav-link text-dark" asp-area="AccountManagement" asp-controller="Projects" asp-action="Index">Projects</a>
                                                    }
                                                </div>
                                            </li>
                                        }
                                        @if (User.IsAuthorizedForFinances())
                                        {
                                            <li class="nav-item dropdown">
                                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false"><i class="bi bi-bank2"></i> Finances</a>
                                                <div class="dropdown-menu">
                                                    @if (User.HasClaim(c => c.Type == FinancesClaimsCD.Manage_Payment_Debits_Credits_ClaimType && c.Value == FinancesClaimsCD.Manage_Payment_Debits_Credits_ClaimValue))
                                                    {
                                                        <a id="payment-debits-credits" class="nav-link text-dark" asp-area="Finances" asp-controller="ConsultantPaymentsDebitsCredits" asp-action="Index">Consultant Payments, Debits & Credits</a>
                                                    }
                                                    @if (User.HasClaim(c => c.Type == FinancesClaimsCD.Accounts_Receivable_ClaimType && c.Value == FinancesClaimsCD.Accounts_Receivable_ClaimValue))
                                                    {
                                                        <a id="manage" class="nav-link text-dark" asp-area="Finances" asp-controller="DocumentsCC" asp-action="Index">Receivables</a>
                                                    }
                                                    @if (User.HasClaim(c => c.Type == FinancesClaimsCD.Manage_Basic_Payment_Sheets_ClaimType && c.Value == FinancesClaimsCD.Manage_Basic_Payment_Sheets_ClaimValue))
                                                    {
                                                        <a id="manage" class="nav-link text-dark" asp-area="Finances" asp-controller="PaymentSheets" asp-action="Index">Payment Sheets</a>
                                                    }
                                                </div>
                                            </li>
                                        }
                                        @if (User.IsAuthorizedForRecruiting())
                                        {
                                            <li class="nav-item dropdown">
                                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false"><i class="bi bi-person-hearts"></i> Recruiting</a>
                                                <div class="dropdown-menu">
                                                    @if (User.HasClaim(c => c.Type == InterviewsClaimsCD.Manage_Interviews_Page_ClaimType && c.Value == InterviewsClaimsCD.Manage_Interviews_ClaimValue))
                                                    {
                                                        <a id="interviews" class="nav-link text-dark" asp-area="Recruiting" asp-controller="Interviews" asp-action="Index">Interviews</a>
                                                    }
                                                </div>
                                            </li>
                                        }
                                        @if (User.IsAuthorizedForAdminCenter())
                                        {
                                            <li class="nav-item dropdown">
                                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false"><i class="bi bi-gear-fill"></i> Admin Center</a>
                                                <div class="dropdown-menu">
                                                    @if (User.HasClaim(c => c.Type == AdminCenterClaimsCD.Actualizar_Datos_Softland_ClaimType && c.Value == AdminCenterClaimsCD.Actualizar_Datos_Softland_ClaimValue))
                                                    {
                                                        <a id="manage" class="nav-link text-dark" asp-area="AdminCenter" asp-controller="DataFromSoftland" asp-action="Index">Update Data From Softland</a>
                                                    }
                                                    @if (User.HasClaim(c => c.Type == AdminCenterClaimsCD.Roles_Permisos_Usuarios_ClaimType && c.Value == AdminCenterClaimsCD.Roles_Permisos_Usuarios_ClaimValue))
                                                    {
                                                        <a id="manage" class="nav-link text-dark" asp-area="AdminCenter" asp-controller="UserRolesPermissions" asp-action="Index">User Roles and Permissions</a>
                                                    }
                                                    @if (User.HasClaim(c => c.Type == ConsultantPositionsClaimsCD.Manage_Consultant_Positions_ClaimType && c.Value == ConsultantPositionsClaimsCD.Manage_Consultant_Positions_ClaimValue))
                                                    {
                                                        <a id="manage" class="nav-link text-dark" asp-area="AdminCenter" asp-controller="ConsultantPositions" asp-action="Index">Consultant Positions Accounting Config</a>
                                                    }
                                                </div>
                                            </li>
                                        }
                                    }
                                </ul>

                                <partial name="_LoginPartialCustom" />
                            </div>
                        </div>
                    </nav>
                }
            }

        </header>
    }
    <div>
        <br /><br /><br /><br />
        <main role="main" class="">
            <partial name="_Notification" />
            <div>
                @RenderBody()
            </div>
        </main>
    </div>

    <div id="loading-spinner" class="spinner-page">
        <div class="spinner-container">
            <div>
                <div class="spinner-border" role="status">
                    <span class="sr-only"></span>
                </div>
                <div>
                    <span><i class="bi bi-hourglass-split"></i> Processing data, wait.... </span>
                </div>
            </div>
        </div>
    </div>

    @if (!SignInManager.IsSignedIn(User))
    {
        <footer>
            <div>
                Warning: This platform constitutes proprietary software of Oceans Code Experts and its unauthorized use, copying, or distribution
                for uses outside the operation of Oceans Code Experts is strictly prohibited. All rights reserved. Oceans Code Experts <span id="copyright-year"></span>.
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script src="~/js/site.js?v=@DateTime.Now.Ticks" asp-append-version="true"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
