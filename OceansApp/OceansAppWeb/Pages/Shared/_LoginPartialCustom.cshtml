@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropstart">
            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">
                @await Component.InvokeAsync("ProfileImage")
            </a>
            <div class="dropdown-menu" style="">
                <a id="manage" class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Profile" title="Manage"><i class="bi bi-person-gear"></i> My Account</a>
                <div class="dropdown-divider"></div>
                <form id="logoutForm" class="form-inline" asp-area="" asp-controller="Account" asp-action="LogOff">
                    <button id="logout" type="submit" class="nav-link btn btn-link text-dark"><i class="bi bi-x-lg"></i> Sign off</button>
                </form>
            </div>
        </li>
    }
</ul>


