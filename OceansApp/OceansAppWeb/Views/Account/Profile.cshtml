<link rel="stylesheet" href="~/css/Account/profile.css?v=@DateTime.Now.Ticks" />

<div class="container">
    <div class="row container">
        <div class="col-lg-12 text-center">
            <div class="profile-picture-container">
                <form id="profile-picture-form" enctype="multipart/form-data">
                    <div class="profile-picture-preview">
                        <img id="profile-picture-image" src="/icons/Shared/profile-user.svg" />
                    </div>
                    <input type="file" id="profile-picture-input" accept="image/*" style="display: none;" />
                    <button type="button" id="upload-button" class="btn-secondary">Change Photo</button>
                    <button type="button" id="save-button" class="btn-secondary" disabled>Save</button>
                </form>
            </div>
        </div>
        <div class="col-lg-12 text-center">
            <h2 class="section-heading"><strong>Personal Information</strong></h2>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-floating mb-4">
                            <input id="NamePI" class="form-control" />
                            <label>Name</label>
                        </div>
                        <div class="form-floating mb-4">
                            <input id="LastNamePI" class="form-control" />
                            <label>Last Name</label>
                        </div>
                        <div class="form-floating mb-4">
                            <input id="OccupationPI" class="form-control" />
                            <label>Occupation</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-4">
                            <input id="EmailPI" disabled class="form-control" />
                            <label>Email</label>
                        </div>
                        <div class="form-floating mb-4">
                            <input id="PhoneNumberPI" class="form-control" />
                            <label>Phone Number</label>
                        </div>
                    </div>
                    <div class="col-12 text-center">
                        <button id="SaveBtnPI" class="btn-primary-submit">Save Changes</button>
                    </div>
                </div>
        </div>
    </div>

</div>

<script src="~/js/Account/profile.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/inputValidations.js?v=@DateTime.Now.Ticks"></script>

