@using OceansApp.Models.ViewModels
@model TwoFactorAuthenticationVM

<partial name="_LoginStylesPartial" />

<div class="text-center">
    <div class="custom-box">
        <div class="sub-box">
            <div>
                <h2>Por favor configura tu autenticación de dos factores para poder continuar con tu cuenta.</h2>
                <p>
                    Ingresa el código de abajo en tu applicación de Autenticación de dos factores.
                </p>
                <p style="color: var(--clr-blueLight)">
                    @Model.Token
                </p>
                <p>
                    O bien puedes escanear el código QR a continuación con tu teléfono móvil.
                </p>
                <div class="row">
                    <div class="col-lg-6">
                        <div id="qr-Container">
                            <div id="qrCode"></div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                         <form method="post">
                    <input hidden asp-for="Token" />
                    <div class="form-group">
                        <input hidden asp-for="QRCodeUrl" />
                        <label> Ingresa el Código que se muestra en tu aplicación móvil:</label>
                        <input type="text" placeholder="Código" class="form-control" asp-for="Code" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                        <br />
                    </div>
                    <button style="width:100%" type="submit" class="btn-primary-submit">Enviar</button>
                </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    @section Scripts{
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
<script src="~/js/qrcode.js"></script>
<script type="text/javascript">
     new QRCode(document.getElementById("qrCode"), "@Model.QRCodeUrl");
    // new enableAuthenticatorStyles();
</script>
    }
