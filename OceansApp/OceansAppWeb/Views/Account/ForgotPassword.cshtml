@using OceansApp.Models.ViewModels
@model ForgotPasswordVM

<partial name="_LoginStylesPartial" />

<div class="text-center">
    <div class="custom-box">
        <div class="sub-box">
            <div>
                <h2 class="text-center">¿Olvidaste tu contraseña?</h2>
                <form asp-controller="Account" asp-action="ForgotPassword" method="post" role="form">
                    <p>Ingresa tu correo.</p>
                    <div class="form-group">
                        <div>
                            <input placeholder="Correo Electrónico" asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                    <br />
                    <div>
                        <div>
                            <a asp-area="" asp-controller="Home" asp-action="Dashboard" class="btn cancel-btn" style="width:120px">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">Enviar solicitud</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
 }
}