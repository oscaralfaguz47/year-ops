@using OceansApp.Models.ViewModels
@model ForgotPasswordVM

<partial name="_LoginStylesPartial" />

<div class="text-center">
    <div class="custom-box">
        <div class="sub-box">
            <div>
                <h2 class="text-center">Did you forget your password?</h2>
                <form asp-controller="Account" asp-action="ForgotPassword" method="post" role="form">
                    <p>No worries!, Enter your email.</p>
                    <div class="form-group">
                        <div class="input-container">
                            <input placeholder="Email" asp-for="Email" class="form-control" />
                            <img src="~/img/profile-icon-oc.png" alt="Placeholder Image" class="placeholder-image" />

                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <br />
                    <div>
                        <div>
                            <a asp-area="" asp-controller="Home" asp-action="Dashboard" class="cancel-btn">
                                Cancel
                            </a> &nbsp;
                            <button type="submit" class="btn-primary-submit">Request Password Change</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
 }
}