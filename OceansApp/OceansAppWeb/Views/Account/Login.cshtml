@model LoginVM
@using Microsoft.AspNetCore.Identity
@using OceansApp.Models.ViewModels
@inject SignInManager<IdentityUser> signInManager

<div class="text-center">
    <div class="custom-box">
        <div class="sub-box">
           <div>
                <h2 class="text-center">INICIO DE SESIÓN</h2>
            <div asp-validation-summary="ModelOnly" class="text-danger validation-item"></div>
            <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" role="form">
                <div class="text-lg-left">
                    <div class="form-group">
                        <label asp-for="Email"></label>
                        <div class="">
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Password"></label>
                        <div class="">
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="">
                            <div class="custom-checkbox">
                                <label asp-for="RememberMe">
                                    <input asp-for="RememberMe" />
                                    @Html.DisplayNameFor(m => m.RememberMe)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <br />
                <div class="form-group">
                    <div class="">
                        <button type="submit" class="btn btn-primary form-control">Iniciar Sesión</button>
                    </div>
                </div>
                <br />
                <p>
                    <a asp-action="ForgotPassword"> ¿Olvidaste tu contraseña?</a>
                </p>
            </form>
           </div>
        </div>
    </div>
</div>

@section Scripts{
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
 }
}