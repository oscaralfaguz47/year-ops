@model LoginVM
@using Microsoft.AspNetCore.Identity
@using OceansApp.Models.ViewModels
@inject SignInManager<IdentityUser> signInManager

<partial name="_LoginStylesPartial" />

<div class="text-center">
    <div class="custom-box">
        <div class="sub-box">
            <div>
                <h2 class="text-center">¡HOLA!</h2>
                <p class="sub-title">INICIO DE SESIÓN</p>
                <div asp-validation-summary="ModelOnly" class="text-danger validation-item"></div>
                <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" role="form">
                    <div class="text-lg-left">
                        <div class="form-group">
                            <div class="input-container">
                                <input placeholder="" id="username-input" asp-for="Email" class="form-control input-short" />
                                <img src="~/img/profile-icon-oc.png" alt="Placeholder Image" class="placeholder-image" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <div class="input-container">
                                <input placeholder="" asp-for="Password" class="form-control input-short" />
                                <img src="~/img/lock-icon-oc.png" alt="Placeholder Image" class="placeholder-image" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                                                <br />
                        <div class="form-group">
                            <div class="text-center">
                                <button type="submit" class="btn-primary-submit">INICIAR SESIÓN</button>
                            </div>
                        </div>
                        <hr />
                        <div class="form-group">
                            <div class="">
                                <div class="custom-checkbox">
                                    <label asp-for="RememberMe">
                                        <input type="checkbox" asp-for="RememberMe" />
                                        @Html.DisplayNameFor(m => m.RememberMe)
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <p>
                        <a asp-action="ForgotPassword">Olvidé mi contraseña</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
 }
}

