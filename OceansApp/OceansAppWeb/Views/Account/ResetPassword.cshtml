@using OceansApp.Models.ViewModels
@model ResetPasswordVM
<partial name="_LoginStylesPartial" />

<div class="text-center">
    <div class="custom-box">
        <div class="sub-box">
            <div>
                <h2 class="text-center">Cambio de Contraseña</h2>
                <form asp-controller="Account" asp-action="ResetPassword" method="post" role="form">
                    <p>Ingresa los datos y cambia tu contraseña.</p>
                    <input asp-for="Code" hidden />
                    <div class="form-group">
                        <div>
                            <input placeholder="Correo" asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                    <br />
                    <div class="form-group">
                        <div>
                            <input placeholder="Contraseña" asp-for="Password" class="form-control" />
                           <div class="validation-item">
                                <span asp-validation-for="Password" class="text-danger"></span>
                           </div>
                        </div>
                    </div>
                    <br />
                    <div class="form-group">
                        <div>
                            <input placeholder="Confirma Contraseña" asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                    <br />
                    <div class="">
                        <div>
                             <a asp-area="" asp-controller="Home" asp-action="Dashboard" class="btn cancel-btn" style="width:120px">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">Cambiar Contraseña</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
 }
}