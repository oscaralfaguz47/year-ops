@using OceansApp.Models.ViewModels
@model VerifyAuthenticatorVM

<partial name="_LoginStylesPartial" />

<div class="text-center">
    <div class="custom-box">
        <div class="sub-box verify-auth-box">
            <div>
                <h2 class="text-center">Authentication Code Verification</h2>
                <form asp-controller="Account" asp-action="VerifyAuthenticatorCode" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" role="form">
                   <div>
                    <p>To continue, verify your identity by entering the 6-digit code from your authenticator app.</p>
                   </div>
                    <input asp-for="RememberMe" type="hidden" />
                    <hr />
                    <div>
                        <div class="form-group">
                            <div class="">
                                <label>6-digit authenticator code</label>
                                <input placeholder="000000" asp-for="Code" class="form-control" autocomplete="off" />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-group verify-btn-cont">
                            <div class="">
                                <button type="submit" class="btn-primary-submit">Submit</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}