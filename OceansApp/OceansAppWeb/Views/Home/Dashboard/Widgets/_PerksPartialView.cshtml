@model List<string>

<link rel="stylesheet" href="~/css/Home/Dashboard/Widgets/perks.css?v=@DateTime.Now.Ticks" />

<div class="section">
    <h2 class="section-title">PERKS</h2>

    @foreach (var sectionName in Model)
    {
        <div class="card">
            <div class="card-title">
                <label id="@sectionName.Substring(1)-title"></label>
            </div>
            <div class="card-content">
                <div id="@sectionName.Substring(1)-cont">
                    @sectionName
                </div>
            </div>
        </div>
    }
</div>

<script src="~/js/Home/Dashboard/Widgets/perks.js?v=@DateTime.Now.Ticks"></script>