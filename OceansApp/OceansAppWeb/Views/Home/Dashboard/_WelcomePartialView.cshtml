@using OceansApp.Models.ViewModels.Dashboard
@model WelcomeVM

<link rel="stylesheet" href="~/css/Home/Dashboard/welcome.css?v=@DateTime.Now.Ticks" />

<div id="welcomeCont">
    <div class="consName">
        <label>Welcome, <span> @Model.ConsultantName</span></label>
    </div>
    @if (@Model.StartDate != null)
    {
        <div id="timeInCompany" data-start-date="@Model.StartDate?.ToString("yyyy-MM-dd") ?? " "">
        </div>
    }
</div>

<script src="~/js/Home/Dashboard/welcome.js?v=@DateTime.Now.Ticks"></script>