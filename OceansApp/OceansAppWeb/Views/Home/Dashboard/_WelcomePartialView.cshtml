@using OceansApp.Models.ViewModels.Dashboard
@model WelcomeVM

<link rel="stylesheet" href="~/css/Home/Dashboard/welcome.css?v=@DateTime.Now.Ticks" />

<div id="welcomeCont">
    <div class="consName">
        <label>Welcome, <span> @Model.ConsultantName</span></label>
    </div>
    @if (@Model.ActiveTime != null)
    {
        <div id="timeInCompany">
            <p>You have been with us for <span>@Model.ActiveTime.Years years</span>, <span>@Model.ActiveTime.Months months</span>, and <span>@Model.ActiveTime.Days days</span>!</p>
        </div>
    }
</div>

<script src="~/js/Home/Dashboard/welcome.js?v=@DateTime.Now.Ticks"></script>