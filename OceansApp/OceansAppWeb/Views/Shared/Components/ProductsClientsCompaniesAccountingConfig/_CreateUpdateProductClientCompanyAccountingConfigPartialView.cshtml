<link rel="stylesheet" href="~/css/Shared/ProductsClientsCompaniesAccountingConfig/createUpdateProductClientCompanyAccountingConfig.css" />

<div id="@ViewData["ModalId"]" class="product-client-config-modal global-modal" style="display: none;">
    <div class="global-modal-content">
        <div class="container">
            <div class="close-btn-container"><button class="product-client-config-cancel-btn">x</button></div>
            <p class="product-client-config-message"></p>
            <input type="hidden" class="product-client-config-hidden-product-id" />

            @await Html.PartialAsync("~/Views/Shared/Components/GlobalComponents/_GlobalSearchComponentPartialView.cshtml", ("search-client-element-prod-config", "Search and select a client...", "Clients", "/AccountManagement/Clients/SearchClientsByName", "clientsList"))

            <div class="row prod-config-section-container">
                <div class="col-md-6">
                    <label>Company <span class="required-asterisk">*</span></label>
                    <div class="custom-select">
                        <span class="arrow-down"></span>
                        <select class="form-select companyId">
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <label>Movement Type <label class="optional-span">(Optional)</label></label>
                    <div class="custom-select">
                        <span class="arrow-down"></span>
                        <select class="form-select movementTypeId">
                        </select>
                    </div>
                </div>
            </div>
            <div class="row prod-config-section-container">
                <label class="prod-config-subtitles">SALES</label>
                <div class="col-md-6">
                    <label>Cost Center <span class="required-asterisk">*</span></label>
                    <div class="custom-select">
                        <span class="arrow-down"></span>
                        <select class="form-select costCenterSalesId cost-center-select">
                        </select>
                    </div>
                    <div class="validation-message">Required.</div>
                </div>
                <div class="col-md-6">
                    <label>Accounting Account <span class="required-asterisk">*</span></label>
                    <div class="custom-select">
                        <span class="arrow-down"></span>
                        <select class="form-select accountingAccountSalesId">
                        </select>
                    </div>
                    <div class="validation-message">Required.</div>
                </div>
            </div>

            <div class="row prod-config-section-container">
                <label class="prod-config-subtitles">SALES RETURNS</label>
                <div class="col-md-6">
                    <label>Cost Center <span class="required-asterisk">*</span></label>
                    <div class="custom-select">
                        <span class="arrow-down"></span>
                        <select class="form-select costCenterSalesReturnId cost-center-select">
                        </select>
                    </div>
                    <div class="validation-message">Required.</div>
                </div>
                <div class="col-md-6">
                    <label>Accounting Account <span class="required-asterisk">*</span></label>
                    <div class="custom-select">
                        <span class="arrow-down"></span>
                        <select class="form-select accountingAccountSalesReturnId">
                        </select>
                    </div>
                    <div class="validation-message">Required.</div>
                </div>
            </div>

            <div class="row prod-config-section-container">
                <label class="prod-config-subtitles">SALES DISCOUNTS</label>
                <div class="col-md-6">
                    <label>Cost Center <span class="required-asterisk">*</span></label>
                    <div class="custom-select">
                        <span class="arrow-down"></span>
                        <select class="form-select costCenterSalesDiscountId cost-center-select">
                        </select>
                    </div>
                    <div class="validation-message">Required.</div>
                </div>
                <div class="col-md-6">
                    <label>Accounting Account <span class="required-asterisk">*</span></label>
                    <div class="custom-select">
                        <span class="arrow-down"></span>
                        <select class="form-select accountingAccountSalesDiscountId">
                        </select>
                    </div>
                    <div class="validation-message">Required.</div>
                </div>
            </div>

            <div class="row prod-config-section-container">
                <label class="prod-config-subtitles">SALES TAX <label class="optional-span">(Optional)</label></label>
                <div class="col-md-2">
                    <label>% Tax</label>
                    <input type="number" min="0" step="0.01" value="0.00" class="product-client-config-tax-input form-control" />
                </div>
                <div class="col-md-5">
                    <label>Cost Center</label>
                    <div class="custom-select">
                        <span class="arrow-down"></span>
                        <select class="form-select costCenterSalesTaxId cost-center-select">
                        </select>
                    </div>
                    <div class="validation-message">Required.</div>
                </div>
                <div class="col-md-5">
                    <label>Accounting Account</label>
                    <div class="custom-select">
                        <span class="arrow-down"></span>
                        <select class="form-select accountingAccountSalesTaxId">
                        </select>
                    </div>
                    <div class="validation-message">Required.</div>
                </div>
            </div>

            <div style="margin-top: 1rem; display: flex; justify-content: center; gap: 10px;">
                <button class="product-client-config-cancel-btn cancel-btn">Cancel</button>
                <button class="product-client-config-save-btn btn-primary-submit">Save Configuration</button>
            </div>
        </div>
    </div>
</div>


<script src="~/js/Shared/ProductsClientsCompaniesAccountingConfig/createUpdateProductClientCompanyAccountingConfig.js"></script>
<script src="~/js/Shared/ReportingMyTimeMovementTypes/getMovementTypesForSelect.js"></script>
<script src="~/js/Finances/CostCenters/costsCentersHttpRequests.js"></script>
<script src="~/js/Finances/AccountingAccounts/accountingAccountsHttpRequests.js"></script>