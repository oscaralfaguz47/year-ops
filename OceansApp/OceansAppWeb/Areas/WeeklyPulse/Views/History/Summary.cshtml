@using OceansApp.Models.Models
@using OceansApp.Models.ViewModels.WeeklyPulse
@model WeeklySummaryVM

@functions {
    static string PriorityBadge(IssuePriority p) => p switch
    {
        IssuePriority.Critical => "bg-danger",
        IssuePriority.High => "bg-warning text-dark",
        IssuePriority.Med => "bg-secondary",
        _ => "bg-light text-dark"
    };
}

@{
    ViewData["PulseCrumbs"] = new List<(string, string?)>
    {
        ("History", Url.Action("Index")),
        ($"Week of {Model.WeekStart:yyyy-MM-dd}", Url.Action("Week", new { weekStart = Model.WeekStart.ToString("yyyy-MM-dd") })),
        ("Summary", null),
    };
}

<div class="text-center">
    <h2 style="font-weight: bold">Weekly Summary</h2>
    <p class="text-muted">Week of @Model.WeekStart.ToString("yyyy-MM-dd") — derived, read-only.</p>

    <div class="container text-start" style="max-width: 820px;">
        <div class="alert alert-info" role="alert">@Model.DerivedHint</div>

        @if (!Model.Teams.Any())
        {
            <p class="text-muted">No teams to summarise for this Week.</p>
        }
        else
        {
            @foreach (var team in Model.Teams)
            {
                var s = team.Summary;
                <div class="card mb-4">
                    <div class="card-header">
                        <strong>@team.Team.Name</strong>
                    </div>
                    <div class="card-body">
                        <p class="fst-italic">@s.SummaryText</p>

                        <h6 class="text-uppercase text-muted small">Decisions <span class="text-muted">(issues solved this week)</span></h6>
                        @if (!s.Decisions.Any())
                        {
                            <p class="text-muted small">No issues solved this week.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush mb-3">
                                @foreach (var d in s.Decisions)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@d.Title</span>
                                        <span class="badge @PriorityBadge(d.Priority)">@d.Priority</span>
                                    </li>
                                }
                            </ul>
                        }

                        <h6 class="text-uppercase text-muted small">Actions <span class="text-muted">(to-dos raised this week)</span></h6>
                        @if (!s.Actions.Any())
                        {
                            <p class="text-muted small">No to-dos raised this week.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush mb-3">
                                @foreach (var a in s.Actions)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@a.Title</span>
                                        <span class="text-muted small">due @a.DueDate.ToString("yyyy-MM-dd")</span>
                                    </li>
                                }
                            </ul>
                        }

                        <h6 class="text-uppercase text-muted small">Risks <span class="text-muted">(risk headlines + open High/Critical issues)</span></h6>
                        @if (!s.RiskHeadlines.Any() && !s.RiskIssues.Any())
                        {
                            <p class="text-muted small">No risks flagged this week.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var h in s.RiskHeadlines)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@h.Text</span>
                                        <span class="badge bg-danger">Risk headline</span>
                                    </li>
                                }
                                @foreach (var i in s.RiskIssues)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@i.Title</span>
                                        <span class="badge @PriorityBadge(i.Priority)">@i.Priority &middot; open</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
