@*
    Shared card / badge styling for the Weekly Pulse surfaces (Dashboard board + guided Review).
    Kept in one partial so the two surfaces — and the Flatly badge-contrast overrides — never drift.
*@
<style>
    /* Full-bleed board — minimal outer margins, one horizontal scroll. */
    .kb-wrap { padding: 0 6px; }
    .kb-board {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding: 6px 2px 14px;
        align-items: flex-start;
    }
    .kb-col {
        flex: 0 0 300px;
        width: 300px;
        background: #f1f3f5;
        border-radius: 10px;
        padding: 8px;
        max-height: 78vh;
        display: flex;
        flex-direction: column;
    }
    .kb-col-head {
        font-weight: 600;
        font-size: .9rem;
        padding: 2px 4px 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .kb-col-body { overflow-y: auto; flex: 1 1 auto; }
    .kb-card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 1px 2px rgba(0,0,0,.12);
        padding: 8px 10px;
        margin-bottom: 8px;
        font-size: .85rem;
        text-align: left;
    }
    /* Title row: content left, the readiness pill pinned top-right. */
    .kb-card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 6px; }
    .kb-card-main { min-width: 0; word-break: break-word; }
    .kb-readiness { flex: 0 0 auto; }
    /* Badges sit below the title, bottom-left. */
    .kb-badges { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }
    /* Footer row: badges bottom-left, the ↩ conversion glyph bottom-right. */
    .kb-card-foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 6px; margin-top: 6px; }
    .kb-origin { color: #adb5bd; font-size: 1.05rem; line-height: 1; flex: 0 0 auto; align-self: flex-end; }
    /* Badge text stays white; the Flatly fills are too light for that, so deepen each fill
       within the board/modals to a shade that clears ~4.5:1 against white. */
    .kb-badges .badge, .kb-card-head .kb-readiness, .modal-body .badge { color: #fff !important; }
    .kb-badges .badge.bg-success, .kb-card-head .kb-readiness.bg-success, .modal-body .badge.bg-success { background-color: #157347 !important; }
    .kb-badges .badge.bg-warning, .kb-card-head .kb-readiness.bg-warning, .modal-body .badge.bg-warning { background-color: #b26a00 !important; }
    .kb-badges .badge.bg-secondary, .kb-card-head .kb-readiness.bg-secondary, .modal-body .badge.bg-secondary { background-color: #566573 !important; }
    .kb-badges .badge.bg-danger, .modal-body .badge.bg-danger { background-color: #c0392b !important; }
    .kb-badges .badge.bg-info, .modal-body .badge.bg-info { background-color: #2471a3 !important; }
    .kb-badges .badge.bg-light, .modal-body .badge.bg-light { background-color: #566573 !important; border-color: transparent; }
    .kb-count { color: #868e96; font-weight: 500; }
    .kb-add {
        background: transparent;
        border: 1px dashed #adb5bd;
        color: #495057;
        border-radius: 8px;
        padding: 6px;
        width: 100%;
        font-size: .85rem;
        margin-top: 4px;
    }
    .kb-add:hover { background: #e9ecef; }
    .kb-empty { color: #868e96; font-size: .8rem; padding: 2px 4px; }
    .kb-click { cursor: pointer; }
    .kb-click:hover { outline: 2px solid #0d6efd33; }
    .team-chip {
        display: inline-block;
        width: 10px; height: 10px;
        border-radius: 50%;
        margin-right: 6px;
        vertical-align: middle;
    }
</style>
