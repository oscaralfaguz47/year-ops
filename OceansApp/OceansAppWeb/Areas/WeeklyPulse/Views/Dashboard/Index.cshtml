@using OceansApp.Models.Models
@using OceansApp.Models.ViewModels.WeeklyPulse
@model DashboardVM

<div class="text-center">
    <h2 style="font-weight: bold">Weekly Pulse Dashboard</h2>
    <p class="text-muted">Week of @Model.WeekStart.ToString("yyyy-MM-dd")</p>
    <hr />

    <div class="container">
        <table class="table">
            <thead>
                <tr>
                    <th>Meeting Order</th>
                    <th>Team</th>
                    <th>Check-in</th>
                    <th>Issues</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Teams)
                {
                    <tr>
                        <td>@row.Team.DisplayOrder</td>
                        <td>@row.Team.Name</td>
                        <td class="text-start">
                            <form asp-action="RecordCheckIn" method="post" class="d-flex flex-column gap-2">
                                <input type="hidden" name="teamId" value="@row.Team.TeamId" />
                                <select name="type" class="form-select">
                                    @foreach (var t in Enum.GetValues<CheckInType>())
                                    {
                                        if (row.CheckIn != null && row.CheckIn.Type == t)
                                        {
                                            <option value="@t" selected>@t</option>
                                        }
                                        else
                                        {
                                            <option value="@t">@t</option>
                                        }
                                    }
                                </select>
                                <textarea name="note" class="form-control" rows="2" placeholder="Note">@(row.CheckIn?.Note)</textarea>
                                <button type="submit" class="btn btn-primary btn-sm">Save check-in</button>
                            </form>
                        </td>
                        <td class="text-start">
                            @foreach (var issueRow in row.Issues)
                            {
                                <div class="border rounded p-2 mb-2">
                                    <div>
                                        <strong>@issueRow.Issue.Title</strong>
                                        <span class="badge bg-secondary">@issueRow.Issue.Priority</span>
                                        <span class="badge bg-info text-dark">@issueRow.State</span>
                                    </div>

                                    <form asp-action="TransitionIssue" method="post" class="d-flex gap-1 mt-1">
                                        <input type="hidden" name="issueId" value="@issueRow.Issue.IssueId" />
                                        <select name="status" class="form-select form-select-sm">
                                            @foreach (var s in Enum.GetValues<IssueStatus>())
                                            {
                                                if (s == issueRow.State)
                                                {
                                                    <option value="@s" selected>@s</option>
                                                }
                                                else
                                                {
                                                    <option value="@s">@s</option>
                                                }
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-outline-primary btn-sm">Set status</button>
                                    </form>

                                    <form asp-action="CommentIssue" method="post" class="d-flex gap-1 mt-1">
                                        <input type="hidden" name="issueId" value="@issueRow.Issue.IssueId" />
                                        <input type="text" name="comment" class="form-control form-control-sm" placeholder="IDS comment" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Comment</button>
                                    </form>
                                </div>
                            }

                            <form asp-action="RaiseIssue" method="post" class="d-flex flex-column gap-1 mt-2">
                                <input type="hidden" name="teamId" value="@row.Team.TeamId" />
                                <input type="text" name="title" class="form-control form-control-sm" placeholder="New issue" />
                                <select name="priority" class="form-select form-select-sm">
                                    @foreach (var p in Enum.GetValues<IssuePriority>())
                                    {
                                        if (p == IssuePriority.Med)
                                        {
                                            <option value="@p" selected>@p</option>
                                        }
                                        else
                                        {
                                            <option value="@p">@p</option>
                                        }
                                    }
                                </select>
                                <button type="submit" class="btn btn-success btn-sm">Raise issue</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
