@using OceansApp.Models.Domain.WeeklyPulse
@using OceansApp.Models.Models
@using OceansApp.Models.ViewModels.WeeklyPulse
@using OceansApp.Utility.ConstantData.Claims.WeeklyPulse
@model DashboardVM

@functions {
    // Background class only. The app theme (Bootswatch "Flatly") uses badge fills too light
    // for its default white text; the board keeps the text white and deepens each fill to a
    // darker shade (see the scoped CSS below) so every badge clears ~4.5:1 contrast.
    static (string Css, string Label) ReadinessBadge(ReadinessState state) => state switch
    {
        ReadinessState.Ready => ("bg-success", "Ready"),
        ReadinessState.NotReady => ("bg-warning", "Not ready"),
        _ => ("bg-secondary", "Not configured")
    };

    // Risk reads loud, Highlight reads quiet — same emphasis as the Review news round.
    static string HeadlineCss(HeadlineType type) =>
        type == HeadlineType.Risk ? "bg-danger" : "bg-success";

    // Converted entities carry a "[from <origin>] " title prefix; the board shows a ↩ glyph
    // instead, so strip the textual prefix for display (heading + card title).
    static string StripOrigin(string title)
    {
        if (string.IsNullOrEmpty(title) || !title.StartsWith("[from ")) { return title; }
        var end = title.IndexOf("] ", StringComparison.Ordinal);
        return end >= 0 ? title[(end + 2)..] : title;
    }

    // Human label for a conversion origin, revealed when the card's modal opens.
    static string OriginLabel(OriginType type) => type switch
    {
        OriginType.CheckIn => "check-in",
        OriginType.Headline => "headline",
        _ => "issue"
    };

    // A stable accent colour per team slot, so a team's cards read the same colour in
    // every column of the pooled board.
    static string TeamColor(int index)
    {
        string[] palette = { "#0d6efd", "#6f42c1", "#d63384", "#fd7e14", "#198754", "#20c997" };
        return palette[index % palette.Length];
    }
}

@{
    // The filter is URL-driven so a team view is bookmarkable. "All selected" is the
    // unfiltered default; from there a chip click focuses to that one team, and once a
    // subset is active each chip toggles its own membership.
    var allTeamIds = Model.Teams.Select(r => r.Team.TeamId).ToList();
    var selected = Model.SelectedTeamIds;
    var allSelected = selected.Count == allTeamIds.Count;

    // Colour by position in the full (unfiltered) team order, so a team keeps its colour
    // regardless of which subset the filter is showing.
    var teamColor = Model.Teams
        .Select((r, i) => (r.Team.TeamId, Color: TeamColor(i)))
        .ToDictionary(x => x.TeamId, x => x.Color);

    // The teams currently in view; every column, card and add-picker draws from this set,
    // so an excluded team contributes nothing anywhere (server-side filter).
    var shown = Model.Teams.Where(r => selected.Contains(r.Team.TeamId)).ToList();

    // The full team list (every team, not just the filtered view) for the edit-form Team
    // pickers — an edit can reassign a card to a team that is currently filtered out.
    var teamOptions = Model.Teams
        .Select(r => new TeamOptionVM { TeamId = r.Team.TeamId, Name = r.Team.Name })
        .ToList();

    // A clean URL when every team shows (drop the param), otherwise ?teams=<csv>.
    string HrefFor(IEnumerable<int> ids)
    {
        var list = ids.Distinct().ToList();
        return list.Count == 0 || list.Count == allTeamIds.Count
            ? Url.Action("Index")
            : Url.Action("Index", new { teams = string.Join(",", list) });
    }
}

<partial name="_BoardStyles" />

<div class="text-center">
    <h2 style="font-weight: bold">Weekly Pulse Dashboard</h2>
    <p class="text-muted">Week of @Model.WeekStart.ToString("yyyy-MM-dd")</p>
    <a asp-action="Review" class="btn btn-primary btn-sm mb-2">Start Review</a>
    <a asp-action="Index" asp-controller="History" class="btn btn-outline-secondary btn-sm mb-2">Meeting History</a>
    @if (User.HasClaim(c => c.Type == WeeklyPulseClaimsCD.Administer_ClaimType && c.Value == WeeklyPulseClaimsCD.Administer_ClaimValue))
    {
        <a asp-action="Index" asp-controller="Settings" class="btn btn-outline-secondary btn-sm mb-2">Settings</a>
    }
    <hr />

    @* Bookmarkable team filter — plain links, so every state is a shareable URL. The
       colour swatch doubles as the legend for the team-tagged cards below. *@
    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-center mb-2" id="team-filter">
        <span class="text-muted small me-1">Teams:</span>
        @foreach (var row in Model.Teams)
        {
            var id = row.Team.TeamId;
            var isOn = selected.Contains(id);
            IEnumerable<int> target;
            if (allSelected)
            {
                target = new[] { id };                  // focus to only this team
            }
            else if (isOn)
            {
                target = selected.Where(x => x != id);  // remove from the view
            }
            else
            {
                target = selected.Append(id);           // add to the view
            }
            <a href="@HrefFor(target)" class="btn btn-sm @(isOn ? "btn-primary" : "btn-outline-primary")">
                <span class="team-chip" style="background:@teamColor[id]"></span>@row.Team.Name
            </a>
        }
        <a href="@Url.Action("Index")" class="btn btn-sm @(allSelected ? "btn-secondary" : "btn-outline-secondary")">Show all</a>
        <span class="text-muted small ms-1">Showing @selected.Count of @allTeamIds.Count teams</span>
    </div>
</div>

@* ---- Cross-team category board: 5 fixed columns, all shown teams pooled into each,
       each card colour-tagged by team. Cards and "+" open the modals rendered below. ---- *@
<div class="kb-wrap">
    <div class="kb-board">
        @* KPIs — no add affordance (KPIs are configured in Settings); cards record a result. *@
        <div class="kb-col">
            <div class="kb-col-head">KPIs <span class="kb-count">@shown.Sum(r => r.Kpis.Count)</span></div>
            <div class="kb-col-body">
                @foreach (var row in shown)
                {
                    var color = teamColor[row.Team.TeamId];
                    foreach (var kpiRow in row.Kpis)
                    {
                        <div class="kb-card kb-click" data-bs-toggle="modal" data-bs-target="#kpi-modal-@kpiRow.Kpi.KpiDefinitionId">
                            <div class="kb-card-head">
                                <span class="kb-card-main"><span class="team-chip" style="background:@color"></span><strong>@kpiRow.Kpi.Name</strong></span>
                            </div>
                            <div class="kb-badges mt-1">
                                @if (kpiRow.Result != null)
                                {
                                    <span class="badge @KpiBadge.Css(kpiRow.Result.Status)">@kpiRow.Result.Status</span>
                                    <span class="text-muted small">@kpiRow.Result.Value</span>
                                }
                                else
                                {
                                    <span class="badge bg-light border">No result yet</span>
                                }
                            </div>
                        </div>
                    }
                }
                @if (shown.Sum(r => r.Kpis.Count) == 0)
                {
                    <div class="kb-empty">No KPIs configured</div>
                }
            </div>
        </div>

        @* Readiness — one pill per shown team (KPI-derived; reported, not healthy). *@
        <div class="kb-col">
            <div class="kb-col-head">Readiness</div>
            <div class="kb-col-body">
                @foreach (var row in shown)
                {
                    var color = teamColor[row.Team.TeamId];
                    var badge = ReadinessBadge(row.Readiness);
                    <div class="kb-card">
                        <div class="kb-card-head">
                            <span class="kb-card-main"><span class="team-chip" style="background:@color"></span><strong>@row.Team.Name</strong></span>
                            <span class="badge rounded-pill kb-readiness @badge.Css">@badge.Label</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Headlines — snapshot news round; cards convert to issue, "+" posts a new one. *@
        <div class="kb-col">
            <div class="kb-col-head">Headlines <span class="kb-count">@shown.Sum(r => r.Headlines.Count)</span></div>
            <div class="kb-col-body">
                @foreach (var row in shown)
                {
                    var color = teamColor[row.Team.TeamId];
                    foreach (var headline in row.Headlines)
                    {
                        <div class="kb-card kb-click" data-bs-toggle="modal" data-bs-target="#headline-modal-@headline.HeadlineId">
                            <div class="kb-card-head">
                                <span class="kb-card-main"><span class="team-chip" style="background:@color"></span>@headline.Text</span>
                            </div>
                            <div class="kb-badges mt-1"><span class="badge @HeadlineCss(headline.Type)">@headline.Type</span></div>
                        </div>
                    }
                }
                @if (shown.Sum(r => r.Headlines.Count) == 0)
                {
                    <div class="kb-empty">No headlines yet</div>
                }
            </div>
            <button type="button" class="kb-add" data-bs-toggle="modal" data-bs-target="#add-headline-modal">+ Post headline</button>
        </div>

        @* Issues — living; card hosts the full lifecycle, "+" raises a new one. *@
        <div class="kb-col">
            <div class="kb-col-head">Issues <span class="kb-count">@shown.Sum(r => r.Issues.Count)</span></div>
            <div class="kb-col-body">
                @foreach (var row in shown)
                {
                    var color = teamColor[row.Team.TeamId];
                    foreach (var issueRow in row.Issues)
                    {
                        <div class="kb-card kb-click" data-bs-toggle="modal" data-bs-target="#issue-modal-@issueRow.Issue.IssueId">
                            <div class="kb-card-head">
                                <span class="kb-card-main"><span class="team-chip" style="background:@color"></span><strong>@StripOrigin(issueRow.Issue.Title)</strong></span>
                            </div>
                            <div class="kb-card-foot">
                                <div class="kb-badges">
                                    <span class="badge bg-secondary">@issueRow.Issue.Priority</span>
                                    <span class="badge bg-info">@issueRow.State</span>
                                    @if (issueRow.Issue.Pinned)
                                    {
                                        <span class="badge bg-warning">Pinned</span>
                                    }
                                </div>
                                @if (issueRow.Issue.OriginType != null)
                                {
                                    <span class="kb-origin" title="Converted from a @OriginLabel(issueRow.Issue.OriginType.Value)">↩</span>
                                }
                            </div>
                        </div>
                    }
                }
                @if (shown.Sum(r => r.Issues.Count) == 0)
                {
                    <div class="kb-empty">No issues</div>
                }
            </div>
            <button type="button" class="kb-add" data-bs-toggle="modal" data-bs-target="#add-issue-modal">+ Raise issue</button>
        </div>

        @* To-Dos — living; card sets status, "+" adds a new one. *@
        <div class="kb-col">
            <div class="kb-col-head">To-Dos <span class="kb-count">@shown.Sum(r => r.ToDos.Count)</span></div>
            <div class="kb-col-body">
                @foreach (var row in shown)
                {
                    var color = teamColor[row.Team.TeamId];
                    foreach (var toDoRow in row.ToDos)
                    {
                        <div class="kb-card kb-click" data-bs-toggle="modal" data-bs-target="#todo-modal-@toDoRow.ToDo.ToDoId">
                            <div class="kb-card-head">
                                <span class="kb-card-main"><span class="team-chip" style="background:@color"></span><strong>@StripOrigin(toDoRow.ToDo.Title)</strong></span>
                            </div>
                            <div class="text-muted small mt-1">Due @toDoRow.ToDo.DueDate.ToString("yyyy-MM-dd")</div>
                            <div class="kb-card-foot">
                                <div class="kb-badges">
                                    @if (toDoRow.State == ToDoStatus.Blocked)
                                    {
                                        <span class="badge bg-danger">@toDoRow.State</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">@toDoRow.State</span>
                                    }
                                </div>
                                @if (toDoRow.ToDo.OriginType != null)
                                {
                                    <span class="kb-origin" title="Converted from a @OriginLabel(toDoRow.ToDo.OriginType.Value)">↩</span>
                                }
                            </div>
                        </div>
                    }
                }
                @if (shown.Sum(r => r.ToDos.Count) == 0)
                {
                    <div class="kb-empty">No open to-dos</div>
                }
            </div>
            <button type="button" class="kb-add" data-bs-toggle="modal" data-bs-target="#add-todo-modal">+ Add to-do</button>
        </div>
    </div>
</div>

@*
    Modals — server-rendered per entity so each carries its real IDs and (via the Form
    Tag Helper) an antiforgery token, and the existing [ValidateAntiForgeryToken] POST
    actions work unchanged. Each POST reloads the page; RedirectToDashboard preserves the
    ?teams= filter via Referer. Rendered here (outside the scrolling columns) so Bootstrap's
    fixed-position overlays are never clipped by a column's overflow.
*@

@* ---- Add modals (led by a team picker — the pooled board carries no per-column team) ---- *@

<div class="modal fade" id="add-headline-modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Post headline</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="PostHeadline" method="post">
                <div class="modal-body text-start">
                    <label class="form-label small mb-1">Team</label>
                    <select name="teamId" class="form-select form-select-sm mb-2">
                        @foreach (var row in shown)
                        {
                            <option value="@row.Team.TeamId">@row.Team.Name</option>
                        }
                    </select>
                    <label class="form-label small mb-1">Type</label>
                    <select name="type" class="form-select form-select-sm mb-2">
                        @foreach (var t in Enum.GetValues<HeadlineType>())
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                    <label class="form-label small mb-1">Headline</label>
                    <input type="text" name="text" class="form-control form-control-sm" placeholder="Headline" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-sm btn-primary">Post headline</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="add-issue-modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Raise issue</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RaiseIssue" method="post">
                <div class="modal-body text-start">
                    <label class="form-label small mb-1">Team</label>
                    <select name="teamId" class="form-select form-select-sm mb-2">
                        @foreach (var row in shown)
                        {
                            <option value="@row.Team.TeamId">@row.Team.Name</option>
                        }
                    </select>
                    <label class="form-label small mb-1">Title</label>
                    <input type="text" name="title" class="form-control form-control-sm mb-2" placeholder="New issue" />
                    <label class="form-label small mb-1">Priority</label>
                    <select name="priority" class="form-select form-select-sm">
                        @foreach (var p in Enum.GetValues<IssuePriority>())
                        {
                            if (p == IssuePriority.Med)
                            {
                                <option value="@p" selected>@p</option>
                            }
                            else
                            {
                                <option value="@p">@p</option>
                            }
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-sm btn-success">Raise issue</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="add-todo-modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add to-do</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RaiseToDo" method="post">
                <div class="modal-body text-start">
                    <label class="form-label small mb-1">Team</label>
                    <select name="teamId" class="form-select form-select-sm mb-2">
                        @foreach (var row in shown)
                        {
                            <option value="@row.Team.TeamId">@row.Team.Name</option>
                        }
                    </select>
                    <label class="form-label small mb-1">Title</label>
                    <input type="text" name="title" class="form-control form-control-sm mb-2" placeholder="New to-do" />
                    <label class="form-label small mb-1">Owner</label>
                    <select name="ownerId" class="form-select form-select-sm mb-2">
                        @foreach (var person in Model.People)
                        {
                            <option value="@person.Id">@person.DisplayName</option>
                        }
                    </select>
                    <label class="form-label small mb-1">Due date</label>
                    <input type="date" name="dueDate" class="form-control form-control-sm" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-sm btn-success">Add to-do</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ---- Edit modals (one per entity, prefilled, no team picker) ---- *@

@foreach (var row in shown)
{
    @* KPI — record result (value + manual status + notes). *@
    foreach (var kpiRow in row.Kpis)
    {
        <div class="modal fade" id="kpi-modal-@kpiRow.Kpi.KpiDefinitionId" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@kpiRow.Kpi.Name <span class="text-muted small">· @row.Team.Name</span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form asp-action="RecordKpiResult" method="post">
                        <input type="hidden" name="kpiDefinitionId" value="@kpiRow.Kpi.KpiDefinitionId" />
                        <div class="modal-body text-start">
                            <p class="text-muted small mb-2">Target: @kpiRow.Kpi.Target</p>
                            <label class="form-label small mb-1">Result</label>
                            <input type="text" name="value" class="form-control form-control-sm mb-2" placeholder="e.g. 92%" value="@(kpiRow.Result?.Value)" />
                            <label class="form-label small mb-1">Status</label>
                            <select name="status" class="form-select form-select-sm mb-2">
                                @foreach (var s in Enum.GetValues<KpiStatus>())
                                {
                                    if (kpiRow.Result != null && kpiRow.Result.Status == s)
                                    {
                                        <option value="@s" selected>@s</option>
                                    }
                                    else
                                    {
                                        <option value="@s">@s</option>
                                    }
                                }
                            </select>
                            <div class="form-check mb-2">
                                @* Per-Week decision: whether this result surfaces in the Review. Defaults checked. *@
                                <input class="form-check-input" type="checkbox" name="includeInReview" value="true"
                                       id="include-@kpiRow.Kpi.KpiDefinitionId" @((kpiRow.Result?.IncludeInReview ?? true) ? "checked" : "") />
                                <label class="form-check-label small" for="include-@kpiRow.Kpi.KpiDefinitionId">Include in Weekly Pulse Review</label>
                            </div>
                            <label class="form-label small mb-1">Notes</label>
                            <textarea name="notes" class="form-control form-control-sm" rows="2" placeholder="Notes">@(kpiRow.Result?.Notes)</textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-sm btn-primary">Save result</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }


    @* Headline — snapshot; the only action is additive convert-to-issue. *@
    foreach (var headline in row.Headlines)
    {
        <div class="modal fade" id="headline-modal-@headline.HeadlineId" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Headline <span class="text-muted small">· @row.Team.Name</span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-start">
                        @* Click-to-edit: type / text / Team (the headline stays in its Week). *@
                        <form asp-action="EditHeadline" method="post" class="d-flex flex-column gap-2 mb-2">
                            <input type="hidden" name="headlineId" value="@headline.HeadlineId" />
                            <div>
                                <label class="form-label small mb-1">Headline</label>
                                <input type="text" name="text" class="form-control form-control-sm" value="@headline.Text" maxlength="2000" required />
                            </div>
                            <div class="d-flex gap-2">
                                <div class="flex-fill">
                                    <label class="form-label small mb-1">Type</label>
                                    <select name="type" class="form-select form-select-sm">
                                        @foreach (var t in Enum.GetValues<HeadlineType>())
                                        {
                                            if (t == headline.Type)
                                            {
                                                <option value="@t" selected>@t</option>
                                            }
                                            else
                                            {
                                                <option value="@t">@t</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="flex-fill">
                                    <label class="form-label small mb-1">Team</label>
                                    <select name="teamId" class="form-select form-select-sm">
                                        @foreach (var team in teamOptions)
                                        {
                                            if (team.TeamId == headline.TeamId)
                                            {
                                                <option value="@team.TeamId" selected>@team.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@team.TeamId">@team.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary align-self-start">Save changes</button>
                        </form>
                        <hr />
                        @* Additive conversion: raises a pre-filled Issue, the headline stays intact. *@
                        <form asp-action="ConvertHeadlineToIssue" method="post">
                            <input type="hidden" name="headlineId" value="@headline.HeadlineId" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Convert to issue</button>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Issue — full lifecycle in one modal: status, IDS comment, pin, convert-to-to-do. *@
    foreach (var issueRow in row.Issues)
    {
        <div class="modal fade" id="issue-modal-@issueRow.Issue.IssueId" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            @StripOrigin(issueRow.Issue.Title)
                            <span class="text-muted small">· @row.Team.Name</span>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-start">
                        <p class="mb-2">
                            <span class="badge bg-secondary">@issueRow.Issue.Priority</span>
                            <span class="badge bg-info">@issueRow.State</span>
                            @if (issueRow.Issue.Pinned)
                            {
                                <span class="badge bg-warning">Pinned</span>
                            }
                        </p>
                        @if (issueRow.Issue.OriginType != null)
                        {
                            <p class="text-muted small mb-2">↩ Converted from a @OriginLabel(issueRow.Issue.OriginType.Value)</p>
                        }

                        @* Shared edit form: title / Team / priority / status in one save.
                           Factored to _IssueEditForm so the Review (WP-CR4) reuses it. *@
                        @await Html.PartialAsync("_IssueEditForm", new IssueEditFormVM
                        {
                            IssueId = issueRow.Issue.IssueId,
                            TeamId = issueRow.Issue.TeamId,
                            Title = StripOrigin(issueRow.Issue.Title),
                            Priority = issueRow.Issue.Priority,
                            State = issueRow.State,
                            Teams = teamOptions
                        })

                        <hr />
                        <form asp-action="CommentIssue" method="post" class="d-flex gap-1 mb-2">
                            <input type="hidden" name="issueId" value="@issueRow.Issue.IssueId" />
                            <input type="text" name="comment" class="form-control form-control-sm" placeholder="IDS comment" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Add</button>
                        </form>

                        @* Pin is offered only on Deferred issues — it un-parks them for Review. *@
                        @if (issueRow.State == IssueStatus.Deferred)
                        {
                            <form asp-action="SetPin" method="post" class="mb-2">
                                <input type="hidden" name="issueId" value="@issueRow.Issue.IssueId" />
                                <input type="hidden" name="pinned" value="@((!issueRow.Issue.Pinned).ToString().ToLower())" />
                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                    @(issueRow.Issue.Pinned ? "Unpin from Review" : "Pin to Review")
                                </button>
                            </form>
                        }

                        <hr />
                        @* Additive conversion: raises a pre-filled To-Do (owner + due required), the issue stays intact. *@
                        <label class="form-label small mb-1">Convert to to-do</label>
                        <form asp-action="ConvertIssueToToDo" method="post" class="d-flex flex-column gap-1">
                            <input type="hidden" name="issueId" value="@issueRow.Issue.IssueId" />
                            <select name="ownerId" class="form-select form-select-sm">
                                @foreach (var person in Model.People)
                                {
                                    <option value="@person.Id">@person.DisplayName</option>
                                }
                            </select>
                            <input type="date" name="dueDate" class="form-control form-control-sm" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Convert to to-do</button>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* To-Do — set status. *@
    foreach (var toDoRow in row.ToDos)
    {
        <div class="modal fade" id="todo-modal-@toDoRow.ToDo.ToDoId" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@StripOrigin(toDoRow.ToDo.Title) <span class="text-muted small">· @row.Team.Name</span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-start">
                        @if (toDoRow.ToDo.OriginType != null)
                        {
                            <p class="text-muted small mb-2">↩ Converted from a @OriginLabel(toDoRow.ToDo.OriginType.Value)</p>
                        }

                        @* Shared edit form: owner / title / Team / due date. Factored to
                           _ToDoEditForm so the Review (WP-CR4) reuses it. *@
                        @await Html.PartialAsync("_ToDoEditForm", new ToDoEditFormVM
                        {
                            ToDoId = toDoRow.ToDo.ToDoId,
                            TeamId = toDoRow.ToDo.TeamId,
                            Title = StripOrigin(toDoRow.ToDo.Title),
                            OwnerId = toDoRow.ToDo.OwnerId,
                            DueDate = toDoRow.ToDo.DueDate,
                            Teams = teamOptions,
                            People = Model.People
                        })

                        <hr />
                        @* Status is the To-Do's own lifecycle (Open -> Blocked -> Done), separate
                           from the editable fields above. *@
                        <form asp-action="TransitionToDo" method="post" class="d-flex gap-1">
                            <input type="hidden" name="toDoId" value="@toDoRow.ToDo.ToDoId" />
                            <select name="status" class="form-select form-select-sm">
                                @foreach (var s in Enum.GetValues<ToDoStatus>())
                                {
                                    if (s == toDoRow.State)
                                    {
                                        <option value="@s" selected>@s</option>
                                    }
                                    else
                                    {
                                        <option value="@s">@s</option>
                                    }
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Set status</button>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
}
