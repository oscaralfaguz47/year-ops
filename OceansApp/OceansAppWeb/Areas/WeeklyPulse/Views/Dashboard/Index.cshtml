@using OceansApp.Models.Domain.WeeklyPulse
@using OceansApp.Models.Models
@using OceansApp.Models.ViewModels.WeeklyPulse
@using OceansApp.Utility.ConstantData.Claims.WeeklyPulse
@model DashboardVM

@functions {
    static (string Css, string Label) ReadinessBadge(ReadinessState state) => state switch
    {
        ReadinessState.Ready => ("bg-success", "Ready"),
        ReadinessState.NotReady => ("bg-warning text-dark", "Not ready"),
        _ => ("bg-secondary", "Not configured")
    };

    static string StatusCss(KpiStatus status) => status switch
    {
        KpiStatus.Green => "bg-success",
        KpiStatus.Yellow => "bg-warning text-dark",
        _ => "bg-danger"
    };

    // Risk reads loud, Highlight reads quiet — same emphasis as the Review news round.
    static string HeadlineCss(HeadlineType type) =>
        type == HeadlineType.Risk ? "bg-danger" : "bg-success";
}

<div class="text-center">
    <h2 style="font-weight: bold">Weekly Pulse Dashboard</h2>
    <p class="text-muted">Week of @Model.WeekStart.ToString("yyyy-MM-dd")</p>
    <a asp-action="Review" class="btn btn-primary btn-sm mb-2">Start Review</a>
    @if (User.HasClaim(c => c.Type == WeeklyPulseClaimsCD.Administer_ClaimType && c.Value == WeeklyPulseClaimsCD.Administer_ClaimValue))
    {
        <a asp-action="Index" asp-controller="Settings" class="btn btn-outline-secondary btn-sm mb-2">Settings</a>
    }
    <hr />

    <div class="container">
        <table class="table">
            <thead>
                <tr>
                    <th>Meeting Order</th>
                    <th>Team</th>
                    <th>Readiness</th>
                    <th>KPIs</th>
                    <th>Check-in</th>
                    <th>Headlines</th>
                    <th>Issues</th>
                    <th>To-Dos</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Teams)
                {
                    <tr>
                        <td>@row.Team.DisplayOrder</td>
                        <td>@row.Team.Name</td>
                        <td>
                            @{
                                var badge = ReadinessBadge(row.Readiness);
                            }
                            <span class="badge @badge.Css">@badge.Label</span>
                        </td>
                        <td class="text-start">
                            @* KPI result is a frictionless everyday edit — value + manual status + notes. *@
                            @foreach (var kpiRow in row.Kpis)
                            {
                                <div class="border rounded p-2 mb-2">
                                    <div>
                                        <strong>@kpiRow.Kpi.Name</strong>
                                        <span class="text-muted">(target @kpiRow.Kpi.Target)</span>
                                        @if (kpiRow.Result != null)
                                        {
                                            <span class="badge @StatusCss(kpiRow.Result.Status)">@kpiRow.Result.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">No result yet</span>
                                        }
                                    </div>
                                    <form asp-action="RecordKpiResult" method="post" class="d-flex flex-column gap-1 mt-1">
                                        <input type="hidden" name="kpiDefinitionId" value="@kpiRow.Kpi.KpiDefinitionId" />
                                        <input type="text" name="value" class="form-control form-control-sm" placeholder="Result (e.g. 92%)" value="@(kpiRow.Result?.Value)" />
                                        <select name="status" class="form-select form-select-sm">
                                            @foreach (var s in Enum.GetValues<KpiStatus>())
                                            {
                                                if (kpiRow.Result != null && kpiRow.Result.Status == s)
                                                {
                                                    <option value="@s" selected>@s</option>
                                                }
                                                else
                                                {
                                                    <option value="@s">@s</option>
                                                }
                                            }
                                        </select>
                                        <textarea name="notes" class="form-control form-control-sm" rows="1" placeholder="Notes">@(kpiRow.Result?.Notes)</textarea>
                                        <button type="submit" class="btn btn-outline-primary btn-sm">Save result</button>
                                    </form>
                                </div>
                            }
                            @if (row.Kpis.Count == 0)
                            {
                                <span class="text-muted">No KPIs configured</span>
                            }
                        </td>
                        <td class="text-start">
                            <form asp-action="RecordCheckIn" method="post" class="d-flex flex-column gap-2">
                                <input type="hidden" name="teamId" value="@row.Team.TeamId" />
                                <select name="type" class="form-select">
                                    @foreach (var t in Enum.GetValues<CheckInType>())
                                    {
                                        if (row.CheckIn != null && row.CheckIn.Type == t)
                                        {
                                            <option value="@t" selected>@t</option>
                                        }
                                        else
                                        {
                                            <option value="@t">@t</option>
                                        }
                                    }
                                </select>
                                <textarea name="note" class="form-control" rows="2" placeholder="Note">@(row.CheckIn?.Note)</textarea>
                                <button type="submit" class="btn btn-primary btn-sm">Save check-in</button>
                            </form>

                            @* Additive conversion: raises a pre-filled Issue, the check-in stays intact. *@
                            @if (row.CheckIn != null)
                            {
                                <form asp-action="ConvertCheckInToIssue" method="post" class="mt-2">
                                    <input type="hidden" name="checkInId" value="@row.CheckIn.CheckInId" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Convert to issue</button>
                                </form>
                            }
                        </td>
                        <td class="text-start">
                            @* Headlines are a snapshot news round — many per Team/Week, blank each Week. *@
                            @foreach (var headline in row.Headlines)
                            {
                                <div class="border rounded p-2 mb-2">
                                    <span class="badge @HeadlineCss(headline.Type)">@headline.Type</span>
                                    <span>@headline.Text</span>

                                    @* Additive conversion: raises a pre-filled Issue, the headline stays intact. *@
                                    <form asp-action="ConvertHeadlineToIssue" method="post" class="mt-1">
                                        <input type="hidden" name="headlineId" value="@headline.HeadlineId" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Convert to issue</button>
                                    </form>
                                </div>
                            }
                            @if (row.Headlines.Count == 0)
                            {
                                <span class="text-muted">No headlines yet</span>
                            }

                            @* Post a headline — Highlight (a win) or Risk (a concern). Not pinnable. *@
                            <form asp-action="PostHeadline" method="post" class="d-flex flex-column gap-1 mt-2">
                                <input type="hidden" name="teamId" value="@row.Team.TeamId" />
                                <select name="type" class="form-select form-select-sm">
                                    @foreach (var t in Enum.GetValues<HeadlineType>())
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                                <input type="text" name="text" class="form-control form-control-sm" placeholder="Headline" />
                                <button type="submit" class="btn btn-outline-primary btn-sm">Post headline</button>
                            </form>
                        </td>
                        <td class="text-start">
                            @foreach (var issueRow in row.Issues)
                            {
                                <div class="border rounded p-2 mb-2">
                                    <div>
                                        <strong>@issueRow.Issue.Title</strong>
                                        <span class="badge bg-secondary">@issueRow.Issue.Priority</span>
                                        <span class="badge bg-info text-dark">@issueRow.State</span>
                                        @if (issueRow.Issue.Pinned)
                                        {
                                            <span class="badge bg-warning text-dark">Pinned</span>
                                        }
                                    </div>

                                    @* Pin is offered only on Deferred issues — it un-parks them for Review. *@
                                    @if (issueRow.State == IssueStatus.Deferred)
                                    {
                                        <form asp-action="SetPin" method="post" class="mt-1">
                                            <input type="hidden" name="issueId" value="@issueRow.Issue.IssueId" />
                                            <input type="hidden" name="pinned" value="@((!issueRow.Issue.Pinned).ToString().ToLower())" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm">
                                                @(issueRow.Issue.Pinned ? "Unpin from Review" : "Pin to Review")
                                            </button>
                                        </form>
                                    }

                                    <form asp-action="TransitionIssue" method="post" class="d-flex gap-1 mt-1">
                                        <input type="hidden" name="issueId" value="@issueRow.Issue.IssueId" />
                                        <select name="status" class="form-select form-select-sm">
                                            @foreach (var s in Enum.GetValues<IssueStatus>())
                                            {
                                                if (s == issueRow.State)
                                                {
                                                    <option value="@s" selected>@s</option>
                                                }
                                                else
                                                {
                                                    <option value="@s">@s</option>
                                                }
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-outline-primary btn-sm">Set status</button>
                                    </form>

                                    <form asp-action="CommentIssue" method="post" class="d-flex gap-1 mt-1">
                                        <input type="hidden" name="issueId" value="@issueRow.Issue.IssueId" />
                                        <input type="text" name="comment" class="form-control form-control-sm" placeholder="IDS comment" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Comment</button>
                                    </form>

                                    @* Additive conversion: raises a pre-filled To-Do (owner + due required), the issue stays intact. *@
                                    <form asp-action="ConvertIssueToToDo" method="post" class="d-flex flex-column gap-1 mt-1">
                                        <input type="hidden" name="issueId" value="@issueRow.Issue.IssueId" />
                                        <select name="ownerId" class="form-select form-select-sm">
                                            @foreach (var person in Model.People)
                                            {
                                                <option value="@person.Id">@person.DisplayName</option>
                                            }
                                        </select>
                                        <input type="date" name="dueDate" class="form-control form-control-sm" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Convert to to-do</button>
                                    </form>
                                </div>
                            }

                            <form asp-action="RaiseIssue" method="post" class="d-flex flex-column gap-1 mt-2">
                                <input type="hidden" name="teamId" value="@row.Team.TeamId" />
                                <input type="text" name="title" class="form-control form-control-sm" placeholder="New issue" />
                                <select name="priority" class="form-select form-select-sm">
                                    @foreach (var p in Enum.GetValues<IssuePriority>())
                                    {
                                        if (p == IssuePriority.Med)
                                        {
                                            <option value="@p" selected>@p</option>
                                        }
                                        else
                                        {
                                            <option value="@p">@p</option>
                                        }
                                    }
                                </select>
                                <button type="submit" class="btn btn-success btn-sm">Raise issue</button>
                            </form>
                        </td>
                        <td class="text-start">
                            @* Living To-Dos surface here until Done; Blocked reads loud. *@
                            @foreach (var toDoRow in row.ToDos)
                            {
                                <div class="border rounded p-2 mb-2">
                                    <div>
                                        <strong>@toDoRow.ToDo.Title</strong>
                                        @if (toDoRow.State == ToDoStatus.Blocked)
                                        {
                                            <span class="badge bg-danger">@toDoRow.State</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">@toDoRow.State</span>
                                        }
                                    </div>
                                    <div class="text-muted small">
                                        Owner: @(toDoRow.ToDo.Owner is null ? toDoRow.ToDo.OwnerId : $"{toDoRow.ToDo.Owner.Name} {toDoRow.ToDo.Owner.LastName}".Trim())
                                        · Due @toDoRow.ToDo.DueDate.ToString("yyyy-MM-dd")
                                    </div>

                                    <form asp-action="TransitionToDo" method="post" class="d-flex gap-1 mt-1">
                                        <input type="hidden" name="toDoId" value="@toDoRow.ToDo.ToDoId" />
                                        <select name="status" class="form-select form-select-sm">
                                            @foreach (var s in Enum.GetValues<ToDoStatus>())
                                            {
                                                if (s == toDoRow.State)
                                                {
                                                    <option value="@s" selected>@s</option>
                                                }
                                                else
                                                {
                                                    <option value="@s">@s</option>
                                                }
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-outline-primary btn-sm">Set status</button>
                                    </form>
                                </div>
                            }
                            @if (row.ToDos.Count == 0)
                            {
                                <span class="text-muted">No open to-dos</span>
                            }

                            <form asp-action="RaiseToDo" method="post" class="d-flex flex-column gap-1 mt-2">
                                <input type="hidden" name="teamId" value="@row.Team.TeamId" />
                                <input type="text" name="title" class="form-control form-control-sm" placeholder="New to-do" />
                                <select name="ownerId" class="form-select form-select-sm">
                                    @foreach (var person in Model.People)
                                    {
                                        <option value="@person.Id">@person.DisplayName</option>
                                    }
                                </select>
                                <input type="date" name="dueDate" class="form-control form-control-sm" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                                <button type="submit" class="btn btn-success btn-sm">Add to-do</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
