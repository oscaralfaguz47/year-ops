@using OceansApp.Models.Models
@using OceansApp.Models.ViewModels.WeeklyPulse
@model IssueEditFormVM

@*
    Shared Issue edit form — the Issue's own fields (Team, title, priority) plus its derived
    status, saved together via EditIssue. Factored as a partial so the Review's live-edit
    moments (WP-CR4) render the exact same form. A required title guards the submit.
*@
<form asp-action="EditIssue" method="post" class="d-flex flex-column gap-2">
    <input type="hidden" name="issueId" value="@Model.IssueId" />
    <div>
        <label class="form-label small mb-1">Title</label>
        <input type="text" name="title" class="form-control form-control-sm" value="@Model.Title" maxlength="2000" required />
    </div>
    <div>
        <label class="form-label small mb-1">Team</label>
        <select name="teamId" class="form-select form-select-sm">
            @foreach (var team in Model.Teams)
            {
                if (team.TeamId == Model.TeamId)
                {
                    <option value="@team.TeamId" selected>@team.Name</option>
                }
                else
                {
                    <option value="@team.TeamId">@team.Name</option>
                }
            }
        </select>
    </div>
    <div class="d-flex gap-2">
        <div class="flex-fill">
            <label class="form-label small mb-1">Priority</label>
            <select name="priority" class="form-select form-select-sm">
                @foreach (var p in Enum.GetValues<IssuePriority>())
                {
                    if (p == Model.Priority)
                    {
                        <option value="@p" selected>@p</option>
                    }
                    else
                    {
                        <option value="@p">@p</option>
                    }
                }
            </select>
        </div>
        <div class="flex-fill">
            <label class="form-label small mb-1">Status</label>
            <select name="status" class="form-select form-select-sm">
                @foreach (var s in Enum.GetValues<IssueStatus>())
                {
                    if (s == Model.State)
                    {
                        <option value="@s" selected>@s</option>
                    }
                    else
                    {
                        <option value="@s">@s</option>
                    }
                }
            </select>
        </div>
    </div>
    <button type="submit" class="btn btn-sm btn-primary align-self-start">Save changes</button>
</form>
