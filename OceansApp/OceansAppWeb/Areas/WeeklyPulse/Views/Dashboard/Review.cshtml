@using OceansApp.Models.Domain.WeeklyPulse
@using OceansApp.Models.Models
@using OceansApp.Models.ViewModels.WeeklyPulse
@model ReviewVM

<div class="text-center">
    <h2 style="font-weight: bold">Weekly Pulse Review</h2>
    <p class="text-muted">Week of @Model.WeekStart.ToString("yyyy-MM-dd")</p>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">Back to Dashboard</a>

    <div class="alert alert-info text-start" role="note">
        @Model.HiddenHint
    </div>
    <hr />

    <div class="container">
        @foreach (var team in Model.Teams)
        {
            <div class="text-start mb-4">
                <h4>
                    <span class="badge bg-secondary">@team.Team.DisplayOrder</span>
                    @team.Team.Name
                </h4>

                @* News round opens the segment: every headline surfaces — Risk loud, Highlight quiet. *@
                @if (team.Headlines.Any())
                {
                    <div class="mb-3">
                        <h6 class="text-muted">News round</h6>
                        @foreach (var headlineRow in team.Headlines)
                        {
                            var loud = headlineRow.Emphasis == HeadlineEmphasis.Loud;
                            <div class="alert @(loud ? "alert-danger" : "alert-success") py-2 mb-2" role="note">
                                <span class="badge @(loud ? "bg-danger" : "bg-success")">@headlineRow.Headline.Type</span>
                                @if (loud)
                                {
                                    <strong>@headlineRow.Headline.Text</strong>
                                }
                                else
                                {
                                    <span>@headlineRow.Headline.Text</span>
                                }
                            </div>
                        }
                    </div>
                }

                @if (!team.Issues.Any())
                {
                    <p class="text-muted">No issues surface for this team.</p>
                }
                else
                {
                    @foreach (var issueRow in team.Issues)
                    {
                        <div class="border rounded p-2 mb-2">
                            <strong>@issueRow.Issue.Title</strong>
                            <span class="badge bg-secondary">@issueRow.Issue.Priority</span>
                            <span class="badge bg-info text-dark">@issueRow.State</span>
                            @if (issueRow.Issue.Pinned)
                            {
                                <span class="badge bg-warning text-dark">Pinned</span>
                            }

                            @* A pinned-Deferred issue can be un-pinned (re-parked) from Review. *@
                            @if (issueRow.State == IssueStatus.Deferred)
                            {
                                <form asp-action="SetPin" method="post" class="mt-1">
                                    <input type="hidden" name="issueId" value="@issueRow.Issue.IssueId" />
                                    <input type="hidden" name="pinned" value="@((!issueRow.Issue.Pinned).ToString().ToLower())" />
                                    <button type="submit" class="btn btn-outline-warning btn-sm">
                                        @(issueRow.Issue.Pinned ? "Unpin from Review" : "Pin to Review")
                                    </button>
                                </form>
                            }
                        </div>
                    }
                }

                @* To-Dos: every non-Done to-do surfaces, Blocked flagged loud; Done is dropped. *@
                <h6 class="text-muted mt-3">To-Dos</h6>
                @if (!team.ToDos.Any())
                {
                    <p class="text-muted">No to-dos surface for this team.</p>
                }
                else
                {
                    @foreach (var toDoRow in team.ToDos)
                    {
                        var loud = toDoRow.Surfacing == ToDoSurfacing.Loud;
                        <div class="alert @(loud ? "alert-danger" : "alert-secondary") py-2 mb-2" role="note">
                            <span class="badge @(loud ? "bg-danger" : "bg-info text-dark")">@toDoRow.State</span>
                            @if (loud)
                            {
                                <strong>@toDoRow.ToDo.Title</strong>
                            }
                            else
                            {
                                <span>@toDoRow.ToDo.Title</span>
                            }
                            <span class="text-muted small">
                                — @(toDoRow.ToDo.Owner is null ? toDoRow.ToDo.OwnerId : $"{toDoRow.ToDo.Owner.Name} {toDoRow.ToDo.Owner.LastName}".Trim()),
                                due @toDoRow.ToDo.DueDate.ToString("yyyy-MM-dd")
                            </span>
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>
