<div>
    <h2 style="text-align:center">ROLES Y PERMISOS</h2>
    <div style="margin-left: 2rem; margin-bottom:10px">
        <button class="create-btn" onclick="getPermissionsList('modal-create-role')">
            <i class="bi bi-plus"></i> Crear nuevo rol
        </button>
    </div>
    <div id="userRoles">
        <ul id="roles-data-list" style="list-style-type:none"></ul>
    </div>
</div>

<!--MODAL CREATE ROLE -->
<div id="modal-create-role" style="display:none">
    <div id="warning-message">
        <div class="container">
            <div class="warning-message-container">
                <div>
                    <div id="warning-message-cont">
                        <div class="body-mess-cont">
                            <h2>
                                CREAR NUEVO ROL
                            </h2>
                            <form id="form-create-rol">
                                <div class="input-container" style="margin:6px 0 6px 0">
                                    <input name="roleName" type="text" class="form-control" id="roleName" placeholder="Ingresa el nombre del rol">
                                </div>
                                <h4 style="color:#000">Asigna los permisos para este rol:</h4>
                                <div id="permissions-container" style="text-align:left; color: #000;overflow-y: scroll;height: 400px; padding:10px; margin-bottom:10px; border: 1px solid #ccc;">
                                </div>
                            </form>
                            <div style="display:flex; justify-content:center;">
                                <a id="btn-cancel" onclick="hideModal('modal-create-role')" class="cancel-btn">Cancelar</a>&nbsp;
                                <button id="btn-saving" onclick="createRole('modal-create-role')" class="btn-primary-submit">
                                    <div style="display:flex;align-items:center;">
                                        <div style="display:none; margin-right:5px" id="spinner-saving" class="spinner-border" role="status">
                                        </div><span></span>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
        function createRole(modalId) {
       waitingForPostMethod();
        var createRoleForm = $('#form-create-rol');
        var roleName = createRoleForm.find('[name="roleName"]').val();

        var formattedPermissionsList = [];

        createRoleForm.find('input[type="checkbox"]:checked').each(function () {
            formattedPermissionsList.push({
                ClaimId: parseInt($(this).val())
            });
        });
        var token = $('[name="__RequestVerificationToken"]').val();
        var data = {
            roleName: roleName,
            permissionsList: formattedPermissionsList
        };

        $.ajax({
            url: '/AdminCenter/UserRolesPermissions/CreateRole',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                RequestVerificationToken: token
            },
            data: JSON.stringify(data),
            success: function (res) {
                createRoleForm[0].reset();
                hideModal(modalId);
                displayToasterSuccess(res.message);
                displayRolesPermissions();
            },
            error: function (error) {
                displayToasterErrorArray(error.responseJSON.errors);
                inicializeForm();
            }
        });
    }

</script>
<script>
    function waitingForPostMethod(){
     var spinnerSaving = $('#spinner-saving');
        spinnerSaving.show();
        var btnSaving = $('#btn-saving');
        btnSaving.prop('disabled', true);
        var btnCancel = document.getElementById('btn-cancel');
        btnCancel.onclick = null;
        btnCancel.style.cursor = 'not-allowed';
        var spanInsideBtnSaving = $('#btn-saving span');
        spanInsideBtnSaving.text('Espera...');
    }
     function inicializeForm(){
        var spanInsideBtnSaving = $('#btn-saving span');
        spanInsideBtnSaving.text('Guardar');
        var spinnerSaving = $('#spinner-saving');
        spinnerSaving.hide();
        var btnSaving = $('#btn-saving');
        btnSaving.prop('disabled', false);
        var originalClickHandler = function() {
        hideModal('modal-create-role');};
        var btnCancel = document.getElementById('btn-cancel');
        btnCancel.onclick = originalClickHandler;
        btnCancel.style.cursor = 'pointer';
    }
        function getPermissionsList(modalId) {
        inicializeForm();
                var createRoleForm = $('#form-create-rol');
        createRoleForm[0].reset();
            var permissionsContainer = $("#permissions-container");
            permissionsContainer.empty();
                $.ajax({
        type: "GET",
        url: "/AdminCenter/UserRolesPermissions/GetPermissionsList",
        contentType: "application/json",
        success: function (data) {
            showModal(modalId);
            var sysArea = "";
            var sysSubArea = "";
        data.forEach(function (element) {
              if(sysArea != element.systemAreaName){
                     permissionsContainer.append('<h5><strong>' + element.systemAreaName + '</strong> (Area)</h5>');
                 }
                 if(sysSubArea != element.systemAreaName){
                     permissionsContainer.append('<h6 style="margin-left:12px"><strong>' + element.systemSubAreaName + '</strong> (Sub Area)</h6>');
                 }
                  sysArea = element.systemAreaName;
                  sysSubArea = element.systemSubAreaName;
          permissionsContainer.append('<div style="margin-left:24px; color:var(--clr-grayDark);font-size:17px;"><input id="pe-'+element.claimId+'" name="'+ element.permissionDescription +'" type="checkbox" value="'+ element.claimId +'"><label for="pe-'+ element.claimId +'">&nbsp;'+element.permissionDescription+'</label></div>');
        });
        },
        error: function (error) {
            console.error("Error al obtener lista de roles:", error);
        }
        });
    }
</script>
<script>
    function displayRolesPermissions(){
        $.ajax({
        type: "GET",
        url: "/AdminCenter/UserRolesPermissions/GetRolePermissionsList",
        contentType: "application/json",
        success: function (data) {
            var listaDatos = $("#roles-data-list");
            listaDatos.empty();
            data.forEach(function (element) {
                listaDatos.append('<div><button class="link-btn" data-toggle="collapse" data-target="#co-' + element.roleId + '" aria-expanded="false" aria-controls="co-' + element.roleId + '"><span>' + element.roleName + '</span></button><i title="Editar Rol" class="bi bi-pencil-square"></i></div>');
                                        var acordeonSection = $('<div id="co-' + element.roleId + '" class="collapse" data-parent="#userRoles">');
                                                        listaDatos.append(acordeonSection);
                                                        var sysArea = "";
                                                        var sysSubArea = "";
                 element.userClaims.forEach(function (claim){
                 if(sysArea != claim.systemAreaName){
                     acordeonSection.append('<h5 style="margin-left:12px"><strong>' + claim.systemAreaName + '</strong> (Area)</h5>');
                 }
                 if(sysSubArea != claim.systemAreaName){
                     acordeonSection.append('<h6 style="margin-left:24px"><strong>' + claim.systemSubAreaName + '</strong> (Sub Area)</h6>');
                 }
                 sysArea = claim.systemAreaName;
                     sysSubArea = claim.systemSubAreaName;
                     if(claim.isAddedToTheRole){
                         acordeonSection.append('<li style="margin-left:48px"><i style="font-size:22px; color: #21DA15;" class="bi bi-check-lg"></i> ' + claim.claimDescription + '</li>');
                     }else{
                         acordeonSection.append('<li style="margin-left:48px"><i style="font-size:22px; color: red;" class="bi bi-x"></i> ' + claim.claimDescription + '</li>');
                     }

                 });
                 acordeonSection.append("<br>");
            });
        },
        error: function (error) {
            console.error("Error al obtener lista de roles:", error);
        }
    });
    }
    displayRolesPermissions();
</script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>