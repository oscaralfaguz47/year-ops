<div>
    <h2 style="text-align:center">ROLES Y PERMISOS</h2>
    <div style="margin-left: 2rem; margin-bottom:10px">
        <button class="create-btn" onclick="getPermissionsList('modal-create-role')">
            <i class="bi bi-plus"></i> Crear nuevo rol
        </button>
    </div>
    <div id="userRoles">
        <ul id="roles-data-list" style="list-style-type:none"></ul>
    </div>
</div>

<!--MODAL CREATE ROLE -->
<div id="modal-create-role" style="display:none">
    <div id="warning-message">
        <div class="container">
            <div class="warning-message-container">
                <div>
                    <div id="warning-message-cont">
                        <div class="body-mess-cont">
                            <h2>
                                CREAR NUEVO ROL
                            </h2>
                            <form id="form-create-rol">
                                <div class="input-container" style="margin:6px 0 6px 0">
                                    <input type="text" class="form-control" id="roleName" placeholder="Ingresa el nombre del rol">
                                </div>
                                <h4 style="color:#000">Asigna los permisos para este rol:</h4>
                                <div id="permissions-container" style="text-align:left; color: #000;overflow-y: scroll;height: 400px; padding:10px; margin-bottom:10px; border: 1px solid #ccc;">
                                </div>
                                <a onclick="hideModal('modal-create-role')" class="cancel-btn">Cancelar</a>
                                <button onclick="hideModal('modal-create-role')" class="btn-primary-submit">Crear Rol</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
        function getPermissionsList(modalId) {
            var permissionsContainer = $("#permissions-container");
            permissionsContainer.empty();
                $.ajax({
        type: "GET",
        url: "/AdminCenter/UserRolesPermissions/GetPermissionsList",
        contentType: "application/json",
        success: function (data) {
            showModal(modalId);
            var sysArea = "";
            var sysSubArea = "";
        data.forEach(function (element) {
              if(sysArea != element.systemAreaName){
                     permissionsContainer.append('<h5><strong>' + element.systemAreaName + '</strong> (Area)</h5>');
                 }
                 if(sysSubArea != element.systemAreaName){
                     permissionsContainer.append('<h6 style="margin-left:12px"><strong>' + element.systemSubAreaName + '</strong> (Sub Area)</h6>');
                 }
                  sysArea = element.systemAreaName;
                  sysSubArea = element.systemSubAreaName;
          permissionsContainer.append('<div style="margin-left:24px; color:var(--clr-grayDark)"><input id="pe-'+element.claimId+'" name="'+ element.permissionDescription +'" type="checkbox" value="'+ element.claimId +'"><label for="pe-'+ element.claimId +'">&nbsp;'+element.permissionDescription+'</label></div>');
        });
        },
        error: function (error) {
            console.error("Error al obtener lista de roles:", error);
        }
        });

    }
</script>
<script>
    $.ajax({
        type: "GET",
        url: "/AdminCenter/UserRolesPermissions/GetRolePermissionsList",
        contentType: "application/json",
        success: function (data) {
            var listaDatos = $("#roles-data-list");
                   var count = 0;
            data.forEach(function (element) {
                listaDatos.append('<button class="btn btn-link" data-toggle="collapse" data-target="#co-' + element.roleName + '" aria-expanded="false" aria-controls="co-' + element.roleName + '"><h4>' + element.roleName + '</h4></button><br>');
                                        var acordeonSection = $('<div id="co-' + element.roleName + '" class="collapse" data-parent="#userRoles">');
                                        if (count == 0) {
                                          acordeonSection.addClass("show");
                                            }else{
                                              acordeonSection.removeClass("show");
                                             }
                                                        listaDatos.append(acordeonSection);
                                                        var sysArea = "";
                                                        var sysSubArea = "";
                 element.userClaims.forEach(function (claim){
                 if(sysArea != claim.systemAreaName){
                     acordeonSection.append('<h5 style="margin-left:12px"><strong>' + claim.systemAreaName + '</strong> (Area)</h5>');
                 }
                 if(sysSubArea != claim.systemAreaName){
                     acordeonSection.append('<h6 style="margin-left:24px"><strong>' + claim.systemSubAreaName + '</strong> (Sub Area)</h6>');
                 }
                 sysArea = claim.systemAreaName;
                     sysSubArea = claim.systemSubAreaName;
                     if(claim.isAddedToTheRole){
                         acordeonSection.append('<li style="margin-left:48px"><i style="font-size:22px; color: #21DA15;" class="bi bi-check-lg"></i> ' + claim.claimDescription + '</li>');
                     }else{
                         acordeonSection.append('<li style="margin-left:48px"><i style="font-size:22px; color: red;" class="bi bi-x"></i> ' + claim.claimDescription + '</li>');
                     }

                 });
                 acordeonSection.append("<br>");
                count++;
            });
        },
        error: function (error) {
            console.error("Error al obtener lista de roles:", error);
        }
    });
</script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>