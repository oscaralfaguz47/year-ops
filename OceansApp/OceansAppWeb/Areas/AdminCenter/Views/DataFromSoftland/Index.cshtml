@using OceansApp.Models.Models
@model DataFromSoftland
@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="~/css/AdminCenter/dataFromSoftland.css?v=@DateTime.Now.Ticks" asp-append-version="true" />

<div class="text-center">
    <h2 class="" style="font-weight: bold">LOADING DATA FROM SOFTLAND </h2>
    <hr /> <br />

    <div class="container">
        <div class="dates-container">
            <ol>
                <li><strong>Last data update date: </strong> @TempData["globalLastDate"] , en las secciones: @TempData["globalLastDateSection"]</li>
            </ol>
        </div>
        <form asp-action="UpdateData" class="dataToUpdateForm">
            <div class="border p-3">
                <div class="mb-3">
                    <label asp-for="DataToSave"></label>
                    <textarea asp-for="DataToSave" rows="3" class="form-control" placeholder="Insert the JSON {} here with the data to update"></textarea>
                    <span asp-validation-for="DataToSave" class="text-danger"></span>
                </div>
                 <a asp-area="AdminCenter" asp-controller="Home" asp-action="Index" class="cancel-btn">
                    Cancel
                </a> &nbsp;
                <button type="submit" class="btn-primary-submit">Update Data</button> 
            </div>
        </form>
    </div>
</div>


@section Scripts{
	@{
    <partial name="_ValidationScriptsPartial" />
	}
    <script>setAdminCenterItemActive();</script>
}

