@using OceansApp.Models.ViewModels
@model ApplicationUserVM

    <link rel="stylesheet" href="~/css/Account/global.css" asp-append-version="true" />

<div id="register-section" class="container">
    <h2 class="title-h1-account"><i class="bi bi-person-gear"></i> <strong>Editar Usuario</strong></h2>
    <hr />
    <form id="registerForm" asp-action="Update" method="post">
        <div class="row">
            <div class="col-md-6">
                @Html.HiddenFor(m =>m.Id)
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-floating">
                    <input asp-for="Name" class="form-control" aria-required="true" />
                    <label asp-for="Name"></label>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <br />
                <div class="form-floating">
                    <input asp-for="LastName" class="form-control" aria-required="true" />
                    <label asp-for="LastName"></label>
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <br />
                <div class="form-floating">
                    <input asp-for="Ocupation" class="form-control" aria-required="true" />
                    <label asp-for="Ocupation"></label>
                    <span asp-validation-for="Ocupation" class="text-danger"></span>
                </div>
                <br />
            </div>
            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" />
                    <label asp-for="Email"></label>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <br />
                <div class="form-floating">
                    <input asp-for="PhoneNumber" class="form-control" aria-required="true" />
                    <label asp-for="PhoneNumber"></label>
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <br />

                <div class="form-floating">
                    <select asp-for="Role" asp-items="@Model.Roles" class="form-select">
                    </select>
                    <label asp-for="Role">Rol de Usuario</label>
                    <span asp-validation-for="Role" class="text-danger"></span>
                    @for (int i = 0; i < Model.Roles.Count; i++)
                    {
                        <input type="hidden" asp-for="Roles[i].Value" name="Roles[@i].Value" />
                        <input type="hidden" asp-for="Roles[i].Text" name="Roles[@i].Text" />
                    }
                </div><br />
            </div>
            <div class="text-center">
                <a asp-area="AdminCenter" asp-controller="ApplicationUser" asp-action="Index" class="btn cancel-btn">
                    Cancelar
                </a> &nbsp;
                <button id="registerSubmit" type="submit" class="btn-primary-submit">Guardar Cambios</button>
            </div>
        </div>
    </form>
</div>



@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
