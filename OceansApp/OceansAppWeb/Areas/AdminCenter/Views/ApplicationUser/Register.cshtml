@using OceansApp.Models.ViewModels
@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers
@model RegisterVM

@{
    ViewData["Title"] = "Crear Nuevo Usuario";
}

<div id="register-section" class="container">
    <h2 class="title-h1-account"><i class="bi bi-person-fill-add"></i> <strong>@ViewData["Title"]</strong></h2>
    <hr />
    <form id="registerForm" asp-area="AdminCenter"  asp-controller="ApplicationUser" asp-action="Register" method="post" role="form">
        <div class="row">
            <div class="col-md-6">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-floating">
                    <input asp-for="Name" class="form-control" aria-required="true" />
                    <label asp-for="Name"></label>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <br />
                <div class="form-floating">
                    <input asp-for="LastName" class="form-control" aria-required="true" />
                    <label asp-for="LastName"></label>
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <br />
                <div class="form-floating">
                    <input asp-for="Occupation" class="form-control" aria-required="true" />
                    <label asp-for="Occupation"></label>
                    <span asp-validation-for="Occupation" class="text-danger"></span>
                </div>
                <br />
                <div class="form-floating">
                    <input asp-for="PhoneNumber" class="form-control" aria-required="true" />
                    <label asp-for="PhoneNumber"></label>
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <br />
            </div>
            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" />
                    <label asp-for="Email"></label>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <br />
                <div class="form-floating">
                    <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" />
                    <label asp-for="Password"></label>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div><br />
                <div class="form-floating">
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                    <label asp-for="ConfirmPassword"></label>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div><br />
               <div class="form-floating">
                    <select asp-for="Role" asp-items="@Model.RoleList" class="form-select">
                        <option value="">--Selecciona un Rol--</option>
                    </select>
                    <label asp-for="RoleList">Rol de Usuario</label>
                    <span asp-validation-for="Role" class="text-danger"></span>
                     @for (int i = 0; i < Model.RoleList.Count; i++)
                    {
                        <input type="hidden" asp-for="RoleList[i].Value" name="RoleList[@i].Value" />
                        <input type="hidden" asp-for="RoleList[i].Text" name="RoleList[@i].Text" />
                    }
                </div><br />
            </div>
            <div class="text-center">
                 <a asp-area="AdminCenter" asp-controller="ApplicationUser" asp-action="Index" class="cancel-btn">
                    Cancelar
                </a> &nbsp;
                <button id="registerSubmit" type="submit" class="btn-primary-submit">Crear Usuario</button>
            </div>
        </div>
    </form>
</div>

@section Scripts{ 
@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}