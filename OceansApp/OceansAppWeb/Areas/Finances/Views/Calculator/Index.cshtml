                           $('#results-by-consultant').show();
                           switchLabel.textContent = "Apaga para calcular el rate al Consultor";
                       } else {
                           $('#results-by-client').show();
                           $('#results-by-consultant').hide();
                           switchLabel.textContent = "Enciende para calcular el rate al Cliente";
                       }
              },
              error: function (error) {
                  console.error('Error al cambiar el tipo de calculadora', error);
              }
          });
                 });
</script>

