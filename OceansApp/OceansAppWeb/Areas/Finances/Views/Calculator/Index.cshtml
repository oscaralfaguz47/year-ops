@using OceansApp.Models.ViewModels
@using OceansApp.Utility
@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers
@model CalculatorVM

<div class="text-center">
    <div class="container">
        @if (User.IsInRole(SD.Role_User_Master))
        {
            <div class="Manager-container">
                <button onclick="location.href='@Url.Action("Index", "CalculatorGlobalConfiguration")'" id="btn-gc" class="btn btn-no-background"><i class="bi bi-gear"></i>&nbsp; Configuración Global</button>
            </div>
        }
        <form asp-controller="Calculator" asp-action="Calculate" id="calculatorForm">
            <h2 class="" style="font-weight: bold; color: var(--clr-yellow);">CALCULADORA FINANCIERA</h2>

            <div class="row">
                <div class="col-lg-4 checkboxes-box">
                    @if (User.IsInRole(SD.Role_User_Master) || User.IsInRole(SD.Role_User_Admin))
                    {
                        <div style="text-align:left">
                            <label class="title-label"><strong>Areas</strong></label><br />
                            @if (Model.CalculatorCostCenterUserConfigurationVM != null)
                            {
                                int count = 0;
                                for (int i = 0; i < Model.CalculatorCostCenterUserConfigurationVM.Count; i++)
                                { 
                                    @Html.Hidden("CalculatorCostCenterUserConfigurationVM[" + i + "].CostCenterId", Model.CalculatorCostCenterUserConfigurationVM[i].CostCenterId)
                                    @Html.Hidden("CalculatorCostCenterUserConfigurationVM[" + i + "].Description", Model.CalculatorCostCenterUserConfigurationVM[i].Description)
                                    @Html.Hidden("CalculatorCostCenterUserConfigurationVM[" + i + "].Detail", Model.CalculatorCostCenterUserConfigurationVM[i].Detail)
                                    if (!@Model.CalculatorCostCenterUserConfigurationVM[i].Description.Contains("Area"))
                                    {
                                        if (count == 0)
                                        {
                                            <label class="title-label"><strong>Gastos</strong></label>

                                            <br />
                                        }
                                        count++;
                                    }
                                    <label>
                                        <input disabled="@(User.IsInRole(SD.Role_User_Simple) ? "disabled" : null)" type="checkbox" asp-for="@Model.CalculatorCostCenterUserConfigurationVM[i].Active" />
                                        <span class="Some-other-style">@Model.CalculatorCostCenterUserConfigurationVM[i].Description</span>
                                    </label>
                                    <div class="tooltip-container">
                                        <i class="bi bi-question-circle tooltip-target"></i>
                                        <div class="tooltip-content">
                                            <div class="tooltip-arrow"></div>
                                            @Model.CalculatorCostCenterUserConfigurationVM[i].Detail
                                        </div>
                                    </div>
                                    <br />
                                }
                            }
                            <br /><br />
                        </div>
                    }
                    else
                    {
                        <label style="padding: 0 20px 0 20px"><strong>Todos los Costos y Gastos están incluidos para el calculo del precio al cliente.</strong></label>
                       
                    }
                </div>
                <div class="col-lg-4">
                    <fieldset>
                        <div class="">
                            <label for="client" class="form-label mt-4 form-custom-label title-label">Cliente</label>
                            <select id="client" asp-for="Client" asp-items="@Model.ClientList" class="form-select">
                                <option value="">-- Selecciona un cliente --</option>
                            </select>
                            <span asp-validation-for="Client" class="text-danger"></span>
                            @for (int i = 0; i < Model.ClientList.Count; i++)
                            {
                                <input type="hidden" asp-for="ClientList[i].Value" name="ClientList[@i].Value" />
                                <input type="hidden" asp-for="ClientList[i].Text" name="ClientList[@i].Text" />
                            }
                        </div>
                        <div class="form-group">
                            <label for="daysYear" class="form-label mt-4 form-custom-label title-label">Días Feriados del Año</label>
                            <input asp-for="DaysYear" type="number" step="any" class="form-control" id="daysYear" placeholder="Dígita un número">
                            <span asp-validation-for="DaysYear" class="text-danger"></span>
                        </div>
                        @if (User.IsInRole(SD.Role_User_Master) || User.IsInRole(SD.Role_User_Admin))
                        {
                            <div class="form-group">
                                <label for="daysVacations" class="form-label mt-4 form-custom-label title-label">Días de Vacaciones</label>
                                <input asp-for="VacationDays" type="number" step="any" class="form-control" id="daysVacations" placeholder="Dígita un número">
                                <span asp-validation-for="VacationDays" class="text-danger"></span>
                            </div>
                        }
                    </fieldset>
                </div>

                <div class="col-lg-4">
                    <div class="">
                        <label for="role" class="form-label mt-4 form-custom-label title-label">Rol del Consultor</label>
                        <select id="role" asp-for="ConsultantRoleId" asp-items="@Model.ConsultantRoleList" class="form-select">
                            <option value="">-- Selecciona un rol para el consultor --</option>
                        </select>
                        <span asp-validation-for="ConsultantRoleId" class="text-danger"></span>
                        @for (int i = 0; i < Model.ConsultantRoleList.Count; i++)
                        {
                            <input type="hidden" asp-for="ConsultantRoleList[i].Value" name="ConsultantRoleList[@i].Value" />
                            <input type="hidden" asp-for="ConsultantRoleList[i].Text" name="ConsultantRoleList[@i].Text" />
                        }
                    </div>
                    <div class="">
                        <label for="qualityLevel" class="form-label mt-4 form-custom-label title-label">Nivel del Consultor</label>
                        <select id="qualityLevel" asp-for="ConsultantQualityLevelId" asp-items="@Model.ConsultantQualityLevelList" class="form-select">
                            <option value="">-- Selecciona un nivel para el consultor --</option>
                        </select>
                        <span asp-validation-for="ConsultantQualityLevelId" class="text-danger"></span>
                        @for (int i = 0; i < Model.ConsultantQualityLevelList.Count; i++)
                        {
                            <input type="hidden" asp-for="ConsultantQualityLevelList[i].Value" name="ConsultantQualityLevelList[@i].Value" />
                            <input type="hidden" asp-for="ConsultantQualityLevelList[i].Text" name="ConsultantQualityLevelList[@i].Text" />
                        }
                    </div>
                    <div class="form-group">
                        <label for="amountToPay" class="form-label mt-4 form-custom-label title-label">$ Monto a Pagar al Consultor</label>
                        <input asp-for="PaymentAmount" type="number" step="any" class="form-control" id="amountToPay" placeholder="Dígita un monto">
                        <span asp-validation-for="PaymentAmount" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="btns-cont">
                        <button id="submitBtn" type="submit" class="btn btn-primary btn-submit"><i class="bi bi-calculator"></i>&nbsp;CALCULAR</button>
                        <a asp-area="Finances" asp-controller="Calculator" asp-action="Index" class="btn btn-submit cancel-btn"><i class="bi bi-eraser"></i>&nbsp;LIMPIAR DATOS</a>
                    </div>
                </div>
            </div>
        </form>

        @if (TempData["result"] != null)
        {
            @if (TempData["messageProfitLessThanConfig"] != null)
            {
                <div id="warning-message-cont">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div class="body-mess-cont">
                        <p>
                            Valla!, parece que ingresaste un monto muy alto para el rol y el nivel que tiene el consultor, te recomiendo lo siguiente:
                        </p>
                        <ul>
                            <li>
                                <i class="bi bi-check-lg"></i> Ofrecele un monto igual o menor a: <strong>$@TempData["recommendedAmountToPayToConsultant"]</strong> a pagar mensualmente.
                            </li>
                            <li>
                                <i class="bi bi-info-lg"></i> Con ese monto que te recomendé pagaras adicionalmente un monto de <strong>$@TempData["recommendedAmountHolidaysToConsultant"]</strong> anualmente para Holidays.
                            </li>
                            @if (TempData["recommendedAmountVacationsToConsultant"] != null)
                            {
                                <li>
                                    <i class="bi bi-info-lg"></i> Con ese monto que te recomendé pagaras adicionalmente un monto de <strong>$@TempData["recommendedAmountVacationsToConsultant"]</strong> anualmente para días de vacaciones.
                                </li>
                            }
                            <li>
                                <i class="bi bi-exclamation-triangle"></i> Por favor ten presente que esta recomendación aplica solamente si el consultor
                                está pidiendo un monto alto, ya que esta oferta es la mas aceptable para evitar que se baje la utildad.
                            </li>
                        </ul>
                    </div>

                </div>
            }
            <div id="results-section">
                <h4>PRECIOS PARA EL CLIENTE</h4>
            </div>
            <br />
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr class="table-header">
                            <th scope="col">Tipo de Cliente</th>
                            <th scope="col">Rate x Hora Verde</th>
                            <th scope="col">Rate x Hora Amarillo</th>
                            <th scope="col">Rate Mensual Verde</th>
                            <th scope="col">Rate Mensual Amarillo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (@TempData["hourRateGreenAAA"] != null)
                        {
                            <tr class="table-light">
                                <th>Cliente AAA</th>
                                <td class="green-cell">@TempData["hourRateGreenAAA"] <i class="bi bi-arrow-up"></i></td>
                                <td class="yellow-cell">@TempData["hourRateYellowAAA"]</td>
                                <td class="green-cell">@TempData["monthlyRateGreenAAA"] <i class="bi bi-arrow-up"></i></td>
                                <td class="yellow-cell">@TempData["monthlyRateYellowAAA"]</td>
                            </tr>
                        }
                        @if (@TempData["hourRateGreenAA"] != null)
                        {
                            <tr class="table-light">
                                <th>Cliente AA</th>
                                <td class="green-cell">@TempData["hourRateGreenAA"] <i class="bi bi-arrow-up"></i></td>
                                <td class="yellow-cell">@TempData["hourRateYellowAA"]</td>
                                <td class="green-cell">@TempData["monthlyRateGreenAA"] <i class="bi bi-arrow-up"></i></td>
                                <td class="yellow-cell">@TempData["monthlyRateYellowAA"]</td>
                            </tr>
                        }
                        @if (@TempData["hourRateGreenPartner"] != null)
                        {
                            <tr class="table-light">
                                <th scope="row">Partner</th>
                                <td class="green-cell">@TempData["hourRateGreenPartner"] <i class="bi bi-arrow-up"></i></td>
                                <td class="yellow-cell">@TempData["hourRateYellowPartner"]</td>
                                <td class="green-cell">@TempData["monthlyRateGreenPartner"] <i class="bi bi-arrow-up"></i></td>
                                <td class="yellow-cell">@TempData["monthlyRateYellowPartner"]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (User.IsInRole(SD.Role_User_Master))
            {
                <br />
                <div class="table-responsive">
                    <h4>UTILIDADES APROXIMADAS</h4>
                    <br />
                    <table class="table">
                        <thead>
                            <tr class="table-header">
                                <th scope="col">Tipo de Cliente</th>
                                <th scope="col">Utilidad Verde</th>
                                <th scope="col">% Utilidad Verde</th>
                                <th scope="col">Utilidad Aprox. Amarillo</th>
                                <th scope="col">% Utilidad Aprox. Amarillo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (@TempData["greenProfitAAA"] != null)
                            {
                                <tr class="table-light">
                                    <th>Cliente AAA</th>
                                    <td class="green-cell">@TempData["greenProfitAAA"]</td>
                                    <td class="green-cell">@TempData["greenProfitPercentageAAA"]</td>
                                    <td class="yellow-cell">@TempData["averageYellowProfitAAA"]</td>
                                    <td class="yellow-cell">@TempData["yellowProfitPercentageAAA"]</td>
                                </tr>
                            }
                            @if (@TempData["greenProfitAA"] != null)
                            {
                                <tr class="table-light">
                                    <th>Cliente AA</th>
                                    <td class="green-cell">@TempData["greenProfitAA"]</td>
                                    <td class="green-cell">@TempData["greenProfitPercentageAA"]</td>
                                    <td class="yellow-cell">@TempData["averageYellowProfitAA"]</td>
                                    <td class="yellow-cell">@TempData["yellowProfitPercentageAA"]</td>
                                </tr>
                            }
                            @if (@TempData["greenProfitPartner"] != null)
                            {
                                <tr class="table-light">
                                    <th scope="row">Partner</th>
                                    <td class="green-cell">@TempData["greenProfitPartner"]</td>
                                    <td class="green-cell">@TempData["greenProfitPercentagePartner"]</td>
                                    <td class="yellow-cell">@TempData["averageYellowProfitPartner"]</td>
                                    <td class="yellow-cell">@TempData["yellowProfitPercentagePartner"]</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <br />
                <div>
                    <h4>DESGLOSE DE GASTOS APLICADOS</h4>
                    <div style="text-align:left">
                        <p><strong>Total gastos por centros de costo y descuentos:</strong> $@TempData["subtotalExpenses"]</p>
                        <p><strong>Total costos directos (Pago al consultor, Holidays y vacaciones):</strong> $@TempData["totalCosts"]</p>
                        <p><strong>Monto aumento global aplicado:</strong> @TempData["appliedAmountGlobalIncrease"]</p>
                        <p><strong>TOTAL GASTOS Y COSTOS APLICADOS: $@TempData["totalAmountOfExpensesAndCosts"]</strong></p>
                    </div>
                    <h4>DESGLOSE DE GASTOS DETALLADO</h4>
                    <table class="table">
                        <thead>
                            <tr class="table-header">
                                <th scope="col">Cuenta Contable</th>
                                <th scope="col">Descripción</th>
                                <th scope="col">Monto aplicado</th>
                                <th scope="col">% Aumento aplicado al Centro de Costo</th>
                                <th scope="col">$ Aumento aplicado al Centro de Costo</th>
                                <th scope="col">Centro de Costo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CalculatorExpensesCostsDistribution != null)
                            {
                                foreach (var item in Model.CalculatorExpensesCostsDistribution)
                                {
                                    <tr class="table-light">
                                        <td class="">@item.IdAccountingAccount</td>
                                        <td class=""><strong>@item.AccountingAccountName</strong></td>
                                        <td class=""><strong>$@item.Amount.ToString("#,##0.00")</strong></td>
                                        <td class="">@item.increasePercentage.ToString("#,##0.0")%</td>
                                        <td class="">$@item.increaseAmount.ToString("#,##0.00")</td>
                                        <td class="">@item.CostCenterName</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

        </>
    </div>
    @section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />


    }


    }



