@section Scripts{
    @{
    <partial name="_ValidationScriptsPartial" />

    }
<script>
    // Obtén los elementos de la barra de nivel de batería y la etiqueta
    var minProfitSetPercentage = '@Model.MinProfitSetPercentage';
    var maxProfitSetPercentage = '@Model.MaxProfitSetPercentage';
    var greenPercentageInResults = '@Model.GreenPercentageInResults';
    const batteryLevel = document.querySelector('.battery-level');
    const batteryMessage1 = document.querySelector('.baterry-message-box');
    const batteryMessage2 = document.querySelector('.battery-first-message');
    const battery = document.querySelector('.battery');
    const batteryBorder = document.querySelector('.battery-border');


    // Función para actualizar el nivel de la batería y su color
    function updateBatteryLevel(percentage) {

      // Calcula el porcentaje relativo dentro del rango de 16 a 33
      const range = maxProfitSetPercentage - minProfitSetPercentage;
      const relativePercentage = (percentage - minProfitSetPercentage) / range;

      // Calcula el porcentaje de la batería en función del porcentaje relativo
      const batteryPercentage = relativePercentage * 100;

      // Limita el porcentaje dentro del rango entre 0 y 100
      const limitedPercentage = Math.max(0, Math.min(100, batteryPercentage));

      // Calcula el valor de altura en píxeles basado en el porcentaje
      const height = limitedPercentage;

        batteryLevel.style.height = `${height}%`;


      if (batteryPercentage > 55) {
        batteryLevel.style.backgroundColor = '#0bfc08';
        batteryMessage1.textContent += 'Indica el máximo margen de ganancia';
        batteryMessage2.textContent += parseInt(batteryPercentage.toFixed(0)) + '% | Excelente';
       batteryBorder.style.border = '4px solid #0bfc08';
       battery.classList.toggle('greenActive');
      } else if (batteryPercentage > 22) {
        batteryLevel.style.backgroundColor = '#f9f104 ';
        batteryMessage1.textContent += 'Indica una ganancia moderada';
        batteryMessage2.textContent += parseInt(batteryPercentage.toFixed(0)) + '% | Bueno';
       batteryBorder.style.border = '4px solid #f9f104 ';
       battery.classList.toggle('yellowActive');
      } else {
        batteryLevel.style.backgroundColor = '#f5a707';
        batteryMessage1.textContent += 'Indica una ganancia reducida, proceder en última instancia';
        batteryMessage2.textContent += parseInt(batteryPercentage.toFixed(0)) + '% | Malo';
       batteryBorder.style.border = '4px solid #f5a707';
       battery.classList.toggle('orangeActive');
      }
    }

    updateBatteryLevel(greenPercentageInResults);


</script>
<script>
console.log("HOLA" + "@TempData["messageProfitLessThanConfig"]");
    if("@TempData["messageProfitLessThanConfig"]" != ""){
         const modal = document.getElementById("warning-message");
                modal.style.display = "block";
    }
function hideWarningMessage(){
     const modal = document.getElementById("warning-message");
                modal.style.display = "none";
}
</script>


    }



