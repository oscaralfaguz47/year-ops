<script>
    function loadOptionsForSeniority() {
          var dropdown1 = $("#role");
          var dropdown2 = $("#con-seniority");

          // Limpiar el segundo dropdown
          dropdown2.empty().append('<option value="">Senior/Mid</option>');

          // Obtener la opción seleccionada en el primer dropdown
          var roleId = dropdown1.val();

          // Si se selecciona una opción en el primer dropdown, hacer la llamada AJAX
          if (roleId !== "") {
              $.ajax({
                  url: '/Finances/Calculator/GetOptionsForSeniorityDropdown',
                  type: 'GET',
                  data: { roleId: roleId },
                  success: function (data) {
                      // Llenar el segundo dropdown con las opciones recibidas
                      $.each(data, function (index, option) {
                          dropdown2.append('<option value="' + option.value + '">' + option.name + '</option>');
                      });

                      // Habilitar el segundo dropdown
                      dropdown2.prop('disabled', false);
                  },
                  error: function () {
                      console.error('Error al cargar opciones para el segundo dropdown.');
                  }
              });
          } else {
              // Si no se selecciona ninguna opción en el primer dropdown, deshabilitar el segundo dropdown
              dropdown2.prop('disabled', true);
          }
      }
</script>
