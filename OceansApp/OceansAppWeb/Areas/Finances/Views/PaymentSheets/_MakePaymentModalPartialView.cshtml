<link rel="stylesheet" href="~/css/Shared/sharedComponents.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Finances/PaymentSheets/makePayment.css?v=@DateTime.Now.Ticks" />

<div id="modal-make-payment" class="global-modal" style="display:none">
    <div class="global-modal-content">
        <div class="container">
            <div>
                <div class="close-btn-container"><button id="close-payment-modal-x-btn" onclick="hideModal('modal-make-payment')">x</button></div>
                <h2 id="make-payment-modal-title"></h2>
                <div>
                    <div id="consultant-details-div"></div>
                    <div class="fields-container">
                        <input type="hidden" id="ConsultantPaymentInput" />
                        <div class="row">
                            <div class="col-md-4 p-2">
                                <label for="PaymentMethodSelect">Payment Method</label>
                                <div class="custom-select">
                                    <span class="arrow-down"></span>
                                    <select onchange="changePaymentMethod(this)" class="form-select" id="PaymentMethodSelect">
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4 p-2">
                                <label for="BankAccountSelect">Bank Account</label>
                                <div class="custom-select">
                                    <span class="arrow-down"></span>
                                    <select class="form-select" id="BankAccountSelect">
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4 p-2">
                                <label for="PaymentMethodSelect">Company</label>
                                <div id="company-name-div"></div>
                            </div>
                        </div>
                        <div class="inputs-amount-container">
                            <div class="row">
                                <div class="col-md-4">
                                    <label>Accounting Date</label>
                                    <input type="date" class="form-control" id="accounting-date">
                                </div>
                                <div class="col-md-4">
                                    <label>Reference Number</label>
                                    <input class="form-control integer-input" type="number" maxlength="50" id="reference-number" />
                                </div>
                                <div class="col-md-4">
                                    <label>$ Amount to pay</label>
                                    <input oninput="limitDigitsAndDecimals(this)" class="form-control" type="number" id="total-amount-to-pay" />
                                </div>
                                <input type="hidden" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="action-btns-box">
                    <button onclick="hideModal('modal-make-payment')" class="cancel-btn" id="btn-cancel-payment-modal">Cancel</button>
                    <button class="btn-report-payment" onclick="createUpdatePayment('modal-make-payment')" id="btn-save-payment">
                        <div style="display:flex;align-items:center;">
                            <div style="display:none; margin-right:5px" id="spinner-saving" class="spinner-border" role="status">
                            </div><span></span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/Finances/PaymentSheets/makePayment.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/FormElements/selects.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AdminCenter/PaymentMethods/paymentMethodsFillDropdowns.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/inputValidations.js?v=@DateTime.Now.Ticks"></script>