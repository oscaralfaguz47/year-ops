<link rel="stylesheet" href="~/css/Shared/sharedComponents.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Finances/PaymentSheets/reviewForApproval.css?v=@DateTime.Now.Ticks" />

<div id="modal-review-for-approval" class="global-modal" style="display:none">
    <div class="global-modal-content">
        <div class="container">
            <div>
                <div class="close-btn-container"><button id="close-modal-x-btn" onclick="hideModal('modal-review-for-approval')">x</button></div>
                <h2 id="review-for-approval-modal-title"></h2>
                <input type="hidden" id="submissionId-input" />
                <div id="submission-details-container">
                </div>

                <div class="action-btns-box">
                    <button class="cancel-btn" onclick="displayApproveRejectConfirmation('Rejected', 'ReviewForApproval')">Reject</button>
                    <button class="btn-primary-submit" onclick="displayApproveRejectConfirmation('Approved', 'ReviewForApproval')">Approve</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Approve/Reject Submission Modal -->
<div id="modal-approve-reject-submission" class="global-modal" style="display:none">
    <div class="global-modal-content">
        <div class="container">
            <div>
                <div class="close-btn-container"><button id="close-modal-x-btn" onclick="hideModal('modal-approve-reject-submission')">x</button></div>
                <h2 id="review-for-approval-modal-title"></h2>
                <input type="hidden" id="action-input" />
                <div id="body-container">
                </div>

                <div class="action-btns-box">
                    <button onclick="hideModal('modal-approve-reject-submission')" class="cancel-btn">Cancel</button>
                    <button class="btn-primary-submit" id="confirm-approve-reject-btn"></button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/Finances/PaymentSheets/reviewForApproval.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/Dates/datesMethods.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/Blobs/blobsSharedMethods.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/Time/timeMethods.js?v=@DateTime.Now.Ticks"></script>