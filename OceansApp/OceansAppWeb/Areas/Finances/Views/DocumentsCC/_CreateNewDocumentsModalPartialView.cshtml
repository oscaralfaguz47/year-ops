<link rel="stylesheet" href="~/css/General/createUpdateConsultantModal.css?v=@DateTime.Now.Ticks" />

<div id="modal-create-new-documents" class="global-modal" style="display:none">
    <div class="global-modal-content">

        <div class="container">
            <div>
                <div class="close-btn-container"><button id="close-modal-x-btn" onclick="hideModal('modal-create-new-documents')">x</button></div>
                <h2>Create New Document</h2>
  

                <div id="modal-btns-cont" style="display:flex; justify-content:center;">
                    <a id="btn-cancel" onclick="hideModal('modal-create-new-documents')" class="cancel-btn">Cancel</a>&nbsp;
                    <button id="btn-saving" onclick="createUpdateConsultant('modal-create-new-documents')" class="btn-primary-submit">
                        <div style="display:flex;align-items:center;">
                            <div style="display:none; margin-right:5px" id="spinner-saving" class="spinner-border" role="status">
                            </div><span></span>
                        </div>
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>


<script src="~/js/Finances/DocumentsCC/createNewDocuments.js?v=@DateTime.Now.Ticks"></script>


