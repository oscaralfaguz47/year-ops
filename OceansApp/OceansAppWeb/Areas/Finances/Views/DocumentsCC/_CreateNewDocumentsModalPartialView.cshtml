<link rel="stylesheet" href="~/css/Finances/DocumentsCC/createNewDocument.css?v=@DateTime.Now.Ticks" />

<div id="modal-create-new-documents" class="global-modal" style="display:none">
    <div class="global-modal-content">

        <div class="container">
            <div>
                <div class="close-btn-container"><button id="close-modal-x-btn" onclick="hideModal('modal-create-new-documents')">x</button></div>
                <h2>Create New Document</h2>

                <form id="createDocForm" class="global-form">
                    <div>
                        @await Html.PartialAsync("~/Views/Shared/Components/FormElements/_GlobalTooglePartialView.cshtml",
                                 ("client-consultant-toogle", "Client", "Consultant"))
                    </div>

                    @await Html.PartialAsync("~/Views/Shared/Components/GlobalComponents/_GlobalSearchComponentPartialView.cshtml", ("search-client-element", "Search and select a client...", "Clients", "/AccountManagement/Clients/SearchClientsByName", "clientsList"))
                    @await Html.PartialAsync("~/Views/Shared/Components/GlobalComponents/_GlobalSearchComponentPartialView.cshtml", ("search-consultant-element", "Search and select a consultant...", "Consultants", "/General/ConsultantDetails/SearchConsultantsByNameAndShowInactive", "consultantList"))

                    <div class="create-doc-header-cont">

                        @await Html.PartialAsync("~/Views/Shared/Components/FormElements/_GlobalTooglePartialView.cshtml",
                                 ("transaction-Type-toogle", "Debit", "Credit"))

                        <div class="document-number-container">
                            <label for="documentNumberCreateDoc">Document Number</label>
                            <div>
                                <input type="text" id="documentNumberCreateDoc" disabled />
                            </div>
                        </div>
                    </div>

                    <div id="more-form-elements-container">
                        <div class="row">
                            <input type="hidden" id="documentCCIdCreateDoc">
                            <div class="col-md-4">
                                <label for="documentTypeIdCreateDoc">Document Type <span class="required-asterisk">*</span></label>
                                <div class="custom-select">
                                    <span class="arrow-down"></span>
                                    <select class="form-select" id="documentTypeIdCreateDoc">
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label for="subTypeIdCreateDoc">Subtype <span class="required-asterisk">*</span></label>
                                <div class="custom-select">
                                    <span class="arrow-down"></span>
                                    <select class="form-select" id="subTypeIdCreateDoc">
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label for="ActionDate">Document Date <span class="required-asterisk">*</span> </label> <div class="tooltip-container ">
                                    <i class="bi bi-question-circle tooltip-target"></i>
                                    <div class="tooltip-content">
                                        <div class="tooltip-arrow"></div>
                                        Date on which the accounting entry will be created.
                                    </div>
                                </div>
                                <div>
                                    <input type="date" class="form-control" id="documentDateCreateDoc">
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="document-body">
                    <div class="row">
                        <div class="col-md-12" id="description-container">
                            <label>Description <span class="required-asterisk">*</span></label>
                            <div class="input-container">
                                <input type="text" class="form-control" id="applicationDescriptionCreateDoc">
                            </div>
                        </div>
                    </div>

                    <div id="invoice-body-container">
                        <h5>Search for billable hours</h5>
                        <div class="search-hours-elements-container">
                            <div class="search-child-cont">
                                <label for="ActionDate">Start Date <span class="required-asterisk">*</span> </label>
                                <input type="date" class="form-control" id="startDateSearchBillHours">
                            </div>
                            <div class="search-child-cont">
                                <label for="ActionDate">End Date <span class="required-asterisk">*</span> </label>
                                <input type="date" class="form-control" id="endDateSearchBillHours">
                            </div>
                            <div class="search-child-cont search-btn">
                                <button>Search</button>
                            </div>
                        </div>

                        <!-- Top section with Add Line button -->
                        <div class="top-bar">
                            <button id="addLineBtn" class="blue-btn">Add New Line</button>
                        </div>

                        <!-- Scrolls container -->
                        <div class="table-scroll-wrapper">
                            <div class="table-inner">
                                <!-- Header -->
                                <div class="document-lines-header">
                                    <div class="line-number"></div>
                                    <div class="column description">Product Description</div>
                                    <div class="column">Quantity</div>
                                    <div class="column">Unit Price</div>
                                    <div class="column">Discount</div>
                                    <div class="column">Tax</div>
                                    <div class="column">Subtotal</div>
                                    <div class="column">Action</div>
                                </div>

                                <div id="linesContainer">
                                    <!-- Message displayed when there are no lines -->
                                    <div class="empty-message">
                                        No lines found. Please add a line.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Total resume -->
                        <div class="document-summary">
                            <div class="summary-box">
                                <div><strong>Subtotal:</strong> <span id="summary-subtotal">$0.00</span></div>
                                <div><strong>Discount:</strong> <span id="summary-discount">$0.00</span></div>
                                <div><strong>Tax:</strong> <span id="summary-tax">$0.00</span></div>
                                <div class="summary-total-cont"><strong>Total:</strong> <span id="summary-total">$0.00</span></div>
                            </div>
                        </div>

                    </div>
                </div>

                <div id="modal-btns-cont" style="display:flex; justify-content:center;">
                    <a id="btn-cancel" onclick="hideModal('modal-create-new-documents')" class="cancel-btn">Cancel</a>&nbsp;
                    <button id="btn-saving" onclick="createUpdateConsultant('modal-create-new-documents')" class="btn-primary-submit">
                        Save
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

<div id="invoice-body-modal">
    <div id="invoice-body-modal-content">
        <p class="invoice-body-modal-message"></p>
        <input type="hidden" id="invoice-body-hidden-product-id" />
        <label>Accounting configuration</label>
        <input type="number" min="0" step="0.01" class="invoice-body-tax-input" />
        <div style="margin-top: 1rem; display: flex; justify-content: flex-end; gap: 10px;">
            <button class="invoice-body-cancel-btn">Cancel</button>
            <button class="invoice-body-save-btn">Save Configuration</button>
        </div>
    </div>
</div>

<div id="global-dropdown-layer"></div>

<script src="~/js/Finances/DocumentsCC/createNewDocuments.js?v=@DateTime.Now.Ticks"></script>


