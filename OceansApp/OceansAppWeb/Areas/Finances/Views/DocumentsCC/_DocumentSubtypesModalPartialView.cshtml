<link rel="stylesheet" href="~/css/Finances/DocumentsCC/documentCCSubtypes.css?v=@DateTime.Now.Ticks" />

<div id="modal-document-subtypes" class="global-modal" style="display:none">
    <div class="global-modal-content">

        <div class="container">
            <div>
                <div class="close-btn-container"><button id="close-modal-x-btn" onclick="hideModal('modal-document-subtypes')">x</button></div>
                <h2>Document Subtypes</h2>

                @* Create subtypes *@

                <div id="create-subtype-container" class="subtype-containers">
                    <h4>Create new Subtype</h4>
                    <div class="row">
                        <input type="hidden" id="documentCCSubtypeId">
                        <div class="col-md-8">
                            <label>Description <span class="required-asterisk">*</span></label>
                            <div class="input-container">
                                <input type="text" class="form-control" id="description">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label for="documentTypeId">Document Type <span class="required-asterisk">*</span></label>
                            <div class="custom-select">
                                <span class="arrow-down"></span>
                                <select class="form-select" id="documentTypeId">
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <label for="companyId">Company <span class="required-asterisk">*</span></label>
                            <div class="custom-select">
                                <span class="arrow-down"></span>
                                <select class="form-select" id="companyId" onchange="selectCompany(this.value)">
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label for="costCenterId">Cost Center <span class="required-asterisk">*</span></label>
                            <div class="custom-select">
                                <span class="arrow-down"></span>
                                <select class="form-select" id="costCenterId" onchange="selectCostCenter(this.value)">
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label for="accountingAccountId">Accounting Account <span class="required-asterisk">*</span></label>
                            <div class="custom-select">
                                <span class="arrow-down"></span>
                                <select class="form-select" id="accountingAccountId">
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="create-subtype-btns-container">
                        <button class="cancel-btn" id="cancel-btn-create-subtype">Cancel</button>
                        <button onclick="createUpdateDocumentSubtype()" class="btn-primary-submit">Save</button>
                    </div>

                </div>

                @* Subtypes List *@
                <div id="create-subtype-out-btn-cont"><button class="blue-btn">Create new Subtype</button></div>
                <div id="subtypes-list-container" class="subtype-containers">
                    <div class="global-table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th>Document Type</th>
                                    <th>Cost Center</th>
                                    <th>Accounting Account</th>
                                    <th>Company</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                        <div class="no-results"></div>
                    </div>
                </div>
            </div>


            <div id="modal-btns-cont" style="display:flex; justify-content:center;">
                <a onclick="hideModal('modal-document-subtypes')" class="cancel-btn">Close</a>&nbsp;
            </div>
        </div>
    </div>

</div>
</div>

<script src="~/js/Finances/DocumentsCC/documentCCSubtypes.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AdminCenter/Companies/companies.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AdminCenter/DocumentTypes/documentTypes.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Finances/CostsCenters/costsCentersHttpRequests.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Finances/AccountingAccounts/accountingAccountsHttpRequests.js?v=@DateTime.Now.Ticks"></script>