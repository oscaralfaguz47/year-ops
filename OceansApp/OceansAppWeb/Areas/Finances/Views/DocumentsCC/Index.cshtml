@using OceansApp.Models.ViewModels.DocumentsCC
@model DocumentCCGetAllForListVM
@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Reflection;

<link rel="stylesheet" href="~/css/Shared/pagination.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Finances/documentsCC.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/contentPages.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/sharedComponents.css?v=@DateTime.Now.Ticks" />

<div style="margin: 0 10px 0 10px; backgroundcolor: #fff;">
    <div class="principal-header-container">
        <div class="filters-container">
            <div class="header-page">
                <h2>RECEIVABLES / CLIENT INVOICING</h2>
            </div>
            <partial name="_Pagination" />
        </div>
        <div class="table-header-actions">
            <div class="input-container">
                <input id="search-input" onchange="enterInSearch(event)" type="text" placeholder="Search" class="form-control">
                <i class="bi bi-search placeholder-image"></i>
            </div>

            <div class="action-btns-container">
                <button onclick="getInvoicesWithDaysExpired()">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="20">
                        <path d="M224 0c-17.7 0-32 14.3-32 32l0 19.2C119 66 64 130.6 64 208l0 18.8c0 47-17.3 92.4-48.5 127.6l-7.4 8.3c-8.4 9.4-10.4 22.9-5.3 34.4S19.4 416 32 416l384 0c12.6 0 24-7.4 29.2-18.9s3.1-25-5.3-34.4l-7.4-8.3C401.3 319.2 384 273.9 384 226.8l0-18.8c0-77.4-55-142-128-156.8L256 32c0-17.7-14.3-32-32-32zm45.3 493.3c12-12 18.7-28.3 18.7-45.3l-64 0-64 0c0 17 6.7 33.3 18.7 45.3s28.3 18.7 45.3 18.7s33.3-6.7 45.3-18.7z" />
                    </svg>
                </button>
                <button onclick="sendStatusToSM()">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="20">
                        <path d="M16.1 260.2c-22.6 12.9-20.5 47.3 3.6 57.3L160 376l0 103.3c0 18.1 14.6 32.7 32.7 32.7c9.7 0 18.9-4.3 25.1-11.8l62-74.3 123.9 51.6c18.9 7.9 40.8-4.5 43.9-24.7l64-416c1.9-12.1-3.4-24.3-13.5-31.2s-23.3-7.5-34-1.4l-448 256zm52.1 25.5L409.7 90.6 190.1 336l1.2 1L68.2 285.7zM403.3 425.4L236.7 355.9 450.8 116.6 403.3 425.4z" />
                    </svg>
                </button>
                <button title="Create new document" id="openSidebarBtn" onclick="displayUpdateCreateConsultantModal('modal-update-create-consultant',null)"><img src="/icons/Shared/add.svg"></button>
                <button title="See more filters" id="openSidebarBtn" onclick="displayMoreFiltersConsultants()"><img src="/icons/Shared/filter.svg"></button>
            </div>
        </div>
    </div>
    <div class="global-table-container">
        <table>
            <thead>
                <tr>
                    <th onclick="orderByTableList('ClientName', 'ClientNameTableHeader', 'sortArrowClientName')" data-sort="ANY" name="ClientNameTableHeader" class="sortable-col">
                        Client/Person.
                        <span class="sort-arrow" id="sortArrowClientName">
                        </span>
                    </th>
                    <th onclick="orderByTableList('DocumentNumber', 'DocumentNumberTableHeader', 'sortArrowDocumentNumber')" data-sort="ANY" name="DocumentNumberTableHeader" class="sortable-col">
                        # Document
                        <span class="sort-arrow" id="sortArrowDocumentNumber"></span>
                    </th>
                    <th onclick="orderByTableList('DocumentType', 'DocumentTypeTableHeader', 'sortArrowDocumentType')" data-sort="ANY" name="DocumentTypeTableHeader" class="sortable-col">
                        Doc Type
                        <span class="sort-arrow" id="sortArrowDocumentType"></span>
                    </th>
                    <th onclick="orderByTableList('DocumentDate', 'DocumentDateTableHeader', 'sortArrowDocumentDate')" data-sort="ANY" name="DocumentDateTableHeader" class="sortable-col">
                        Date
                        <span class="sort-arrow" id="sortArrowDocumentDate"></span>
                    </th>
                    <th onclick="orderByTableList('ExpirationDate', 'ExpirationDateTableHeader', 'sortArrowExpirationDate')" data-sort="ANY" name="ExpirationDateTableHeader" class="sortable-col">
                        Due Date
                        <span class="sort-arrow" id="sortArrowExpirationDate"></span>
                    </th>
                    <th onclick="orderByTableList('NumDaysToExpire', 'NumDaysToExpireTableHeader', 'sortArrowNumDaysToExpire')" data-sort="ANY" name="NumDaysToExpireTableHeader" class="sortable-col">
                        Days Until Due
                        <span class="sort-arrow" id="sortArrowNumDaysToExpire"></span>
                    </th>
                    <th onclick="orderByTableList('DocumentAmount', 'DocumentAmountTableHeader', 'sortArrowDocumentAmount')" data-sort="ANY" name="DocumentAmountTableHeader" class="sortable-col">
                        Total Amount
                        <span class="sort-arrow" id="sortArrowDocumentAmount"></span>
                    </th>
                    <th onclick="orderByTableList('BalanceAmount', 'BalanceAmountTableHeader', 'sortArrowBalanceAmount')" data-sort="ANY" name="BalanceAmountTableHeader" class="sortable-col">
                        Amount Due
                        <span class="sort-arrow" id="sortArrowBalanceAmount"></span>
                    </th>
                    <th>Description</th>
                    <th>Voided</th>
                    <th>Company</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
        <div class="no-results"></div>
    </div>
</div>
<partial name="_SidebarRightPartial" />


<!--MODAL INVOICES DAYS EXPIRED -->
<div id="invoices-expired-modal" class="modal">
    <div class="modal-content" style="margin: 0.5% auto; width: 88%;">
        <div class="header">
            <h2>Facturas vencidas pendientes de enviar notificación</h2> <span class="close" onclick="closeInvoicesExpiredModal()">&times;</span>
        </div>
        <div class="global-table-container">
            <table class="table light-table invoices-expired-table">
                <thead>
                    <tr class="table-header">
                        <th>Cliente</th>
                        <th>#Factura</th>
                        <th>Fecha Factura</th>
                        <th>Fecha Expiración</th>
                        <th>#Días de Expiración</th>
                        <th>Monto de Factura</th>
                        <th>Saldo Actual</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
            <div class="no-results"></div>
        </div>
    </div>
</div>

<div id="notificationModal" class="modal">
    <div class="modal-content">
        <div class="header">
            <h2>Historial de envío de recordatorios</h2> <span class="close" onclick="closeModal()">&times;</span>
        </div>
        <table id="notificationTable" class="table light-table">
            <thead>
                <tr class="table-header">
                    <th>Fecha de Envío</th>
                    <th>Enviado por</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<script src="~/js/Shared/pagination.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AccountManagement/clientsSectionFillDropdowns.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/sharedComponents.js?v=@DateTime.Now.Ticks"></script>


@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
        <script src="~/js/Finances/documentsCC.js?v=@DateTime.Now.Ticks"></script>
    }
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>






    </script>
}
