@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers

<div id="be-pagination-container">
    <partial name="_Pagination" />
</div>

<div class="global-table-container book-entries-table-cont">
    <table id="book-entries-table" style="display: none">
        <thead>
            <tr>
                <th onclick="orderByTableList('ParentId', 'ParentIdTableHeader', 'sortArrowParentId')" data-sort="ANY" name="ParentIdTableHeader" class="sortable-col">
                    Book Entry Id
                    <span class="sort-arrow" id="sortArrowParentId"></span>
                </th>
                <th onclick="orderByTableList('CreationDate', 'CreationDateTableHeader', 'sortArrowCreationDate')" data-sort="ANY" name="CreationDateTableHeader" class="sortable-col">
                    Creation Date
                    <span class="sort-arrow" id="sortArrowCreationDate">
                    </span>
                </th>
                <th onclick="orderByTableList('CompanyName', 'CompanyNameTableHeader', 'sortArrowCompanyName')" data-sort="ANY" name="CompanyNameTableHeader" class="sortable-col">
                    Company
                    <span class="sort-arrow" id="sortArrowCompanyName"></span>
                </th>
                <th onclick="orderByTableList('TransactionStatusName', 'TransactionStatusNameTableHeader', 'sortArrowTransactionStatusName')" data-sort="ANY" name="TransactionStatusNameTableHeader" class="sortable-col">
                    Status
                    <span class="sort-arrow" id="sortArrowTransactionStatusName"></span>
                </th>
                 <th># Valid Movements</th>
                <th># Voided Movements</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
