@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="~/css/General/consultantReimbursedBenefits.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/pagination.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/sharedComponents.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/Labels/transactionStatuses.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/contentPages.css?v=@DateTime.Now.Ticks" />

<div style="margin: 0 10px 0 10px; backgroundcolor: #fff;">
    <div class="principal-header-container">
        <div class="filters-container">
            <div class="header-page">
                <h2>BENEFIT REIMBURSEMENTS</h2>
            </div>
            @await Html.PartialAsync("_PaginationReusable")

        </div>
        <div class="table-header-actions">
            <div class="input-container">
                <input id="search-input" onchange="enterInSearchReimbursements(event)" type="text" placeholder="Search" class="form-control">
                <i class="bi bi-search placeholder-image"></i>
            </div>
            <div class="action-btns-container">
                <button title="Add new reimbursement" onclick="displayUpdateCreateReimbursementModal('modal-update-create-reimbursement',null)"><img src="/icons/Shared/add.svg"></button>
                <button title="View Consultants Balance" onclick="displayConsultantAndBenefitsBalanceModal('modal-consultants_benefits-balance')"><img src="/icons/Shared/person-circle-question.svg"></button>
                <button title="See more filters" id="openSidebarBtn" onclick="displayMoreFiltersReimbursements()"><img src="/icons/Shared/filter.svg"></button>
            </div>
        </div>
    </div>

    <div class="global-table-container">
        <table>
            <thead>
                <tr>
                    <th onclick="orderByTableList('ConsultantName', 'ConsultantNameTableHeader', 'sortArrowConsultantName', this)" data-sort="ANY" name="ConsultantNameTableHeader" class="sortable-col">
                        Consultant Name
                        <span class="sort-arrow" id="sortArrowConsultantName">
                        </span>
                    </th>
                    <th onclick="orderByTableList('BenefitName', 'BenefitNameTableHeader', 'sortArrowBenefitName', this)" data-sort="ANY" name="BenefitNameTableHeader" class="sortable-col">
                        Benefit Name
                        <span class="sort-arrow" id="sortArrowBenefitName"></span>
                    </th>
                    <th onclick="orderByTableList('BenefitCategoryName', 'BenefitCategoryNameTableHeader', 'sortArrowBenefitCategoryName', this)" data-sort="ANY" name="BenefitCategoryNameTableHeader" class="sortable-col">
                        Category Name
                        <span class="sort-arrow" id="sortArrowBenefitCategoryName"></span>
                    </th>
                    <th>Details</th>
                    <th onclick="orderByTableList('AmountReimbursed', 'AmountReimbursedTableHeader', 'sortArrowAmountReimbursed', this)" data-sort="ANY" name="AmountReimbursedTableHeader" class="sortable-col">
                        Reimbursed Amount
                        <span class="sort-arrow" id="sortArrowAmountReimbursed"></span>
                    </th>
                    <th onclick="orderByTableList('DateToBeReimbursed', 'DateToBeReimbursedTableHeader', 'sortArrowDateToBeReimbursed', this)" data-sort="ANY" name="DateToBeReimbursedTableHeader" class="sortable-col">
                        Reimbursement Date
                        <span class="sort-arrow" id="sortArrowDateToBeReimbursed"></span>
                    </th>
                    <th onclick="orderByTableList('TransactionStatusName', 'TransactionStatusNameTableHeader', 'sortArrowTransactionStatusName', this)" data-sort="ANY" name="TransactionStatusNameTableHeader" class="sortable-col">
                        Status
                        <span class="sort-arrow" id="sortArrowTransactionStatusName"></span>
                    </th>
                    <th onclick="orderByTableList('UserCreatedBy', 'UserCreatedByTableHeader', 'sortArrowUserCreatedBy', this)" data-sort="ANY" name="UserCreatedByTableHeader" class="sortable-col">
                        Created By
                        <span class="sort-arrow" id="sortArrowUserCreatedBy"></span>
                    </th>
                    <th onclick="orderByTableList('CreationDate', 'CreationDateTableHeader', 'sortArrowCreationDate', this)" data-sort="ANY" name="CreationDateTableHeader" class="sortable-col">
                        Creation Date
                        <span class="sort-arrow" id="sortArrowCreationDate"></span>
                    </th>
                    <th onclick="orderByTableList('UserLastUpdatedBy', 'UserLastUpdatedByTableHeader', 'sortArrowUserLastUpdatedBy', this)" data-sort="ANY" name="UserLastUpdatedByTableHeader" class="sortable-col">
                        Last Updated By
                        <span class="sort-arrow" id="sortArrowUserLastUpdatedBy"></span>
                    </th>
                    <th onclick="orderByTableList('LastUpdatedDate', 'LastUpdatedDateTableHeader', 'sortArrowLastUpdatedDate', this)" data-sort="ANY" name="LastUpdatedDateTableHeader" class="sortable-col">
                        Last Updated Date
                        <span class="sort-arrow" id="sortArrowLastUpdatedDate"></span>
                    </th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
        <div class="no-results"></div>
    </div>
</div>

<partial name="_SidebarRightPartial" />
<partial name="_ConsultantsAndBenefitsBalanceModalPartialView" />

<!--CREATE UPDATE REIMBURSEMENT-->
<div>
    <partial name="_CreateUpdateReimbursementBenefitModalPartialView" />
</div>

<script src="~/js/General/consultantReimbursedBenefits.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/Labels/transactionStatuses.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/sharedComponents.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/Dates/datesMethods.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AdminCenter/TransactionStatuses/transactionStatusesFillDropdows.js?v=@DateTime.Now.Ticks"></script>