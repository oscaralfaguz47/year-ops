@using OceansApp.Models.ViewModels.DocumentsCC
@model DocumentCCGetAllForListVM
@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Reflection;


<link rel="stylesheet" href="~/css/General/consultants.css" />
<link rel="stylesheet" href="~/css/Shared/pagination.css" />

<div style="margin: 0 10px 0 10px; backgroundcolor: #fff;">
    <div class="filters-container">
        <div class="row">
            <form id="filtersPaginationForm" asp-controller="DocumentsCC" asp-action="Index">
                @*Send the DocumentsCCList back to the controller*@
               @if (Model.DocumentsCCList != null)
                {
                     for (int i = 0; i < Model.DocumentsCCList.Count; i++)
                {
                    Type documentCCListProp = typeof(DocumentCCGetAllWithFiltersVM);
                    PropertyInfo[] properties = documentCCListProp.GetProperties();

                    for (int v = 0; v < properties.Length; v++)
                    {
                        string propertyName = properties[v].Name;
                        <input type="hidden" name="DocumentsCCList[@i].@propertyName" value="@properties[v].GetValue(Model.DocumentsCCList[i])" />
                    }
                }
                }
                <div class="search-header-container">
                    <div class="input-container">
                        <input onkeypress="enterInSearch(event)" type="text" asp-for="Filters.SearchText" placeholder="Buscar" class="form-control">
                        <i class="bi bi-search placeholder-image"></i>
                    </div>
                    <a onclick="hideShowFilters()"><i class="bi bi-funnel-fill"></i> Mas Filtros </a>
                </div>
                <div class="more-filters-cont">
                    <div id="more-filters" class="@(ViewData["AppliedFilters"] == null ? "hide" : "show")">
                        <div class="row">
                            <div class="col-sm-2">
                                <label for="documentType" class="select-label">Tipo de Documento</label>
                                <div class="">
                                    <span class="arrow-down"></span>
                                    <select onchange="submitFiltersForm()" id="documentType" asp-for="Filters.DocumentType" class="form-select">
                                        <option selected value="">Selecciona un tipo de documento</option>
                                        @foreach (var docType in Model.DocumentTypeList)
                                        {
                                            <option value="@docType.Value">@docType.Name</option>
                                        }
                                    </select>
                                    @foreach (var docType in Model.DocumentTypeList)
                                    {
                                        int index = Model.DocumentTypeList.IndexOf(docType);
                                        <input type="hidden" asp-for="DocumentTypeList[index].Value" name="DocumentTypeList[@index].Value" />
                                        <input type="hidden" asp-for="DocumentTypeList[index].Name" name="DocumentTypeList[@index].Name" />
                                    }
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <label for="client" class="select-label">Cliente/Persona</label>
                                <div class="">
                                    <span class="arrow-down"></span>
                                    <select onchange="submitFiltersForm()" id="client" asp-for="Filters.ClientId" class="form-select">
                                        <option selected value="">Selecciona un Cliente/Persona</option>
                                        @foreach (var client in Model.ClientList)
                                        {
                                            <option value="@client.Value">@client.Name</option>
                                        }
                                    </select>
                                    @foreach (var client in Model.ClientList)
                                    {
                                        int index = Model.ClientList.IndexOf(client);
                                        <input type="hidden" asp-for="ClientList[index].Name" name="ClientList[@index].Name" />
                                        <input type="hidden" asp-for="ClientList[index].Value" name="ClientList[@index].Value" />
                                    }
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="radio-group">
                                    <label class="radio-label">
                                        <input onchange="submitFiltersForm()" asp-for="Filters.CompanyId" type="radio" value="OCE" class="radio-input">
                                        <span class="radio-custom"></span>
                                        &nbsp; Oceans Consulting
                                    </label>
                                    <label class="radio-label">
                                        <input onchange="submitFiltersForm()" asp-for="Filters.CompanyId" type="radio" value="LLC" class="radio-input">
                                        <span class="radio-custom"></span>
                                        &nbsp; OCE, LLC
                                    </label>
                                </div>
                            </div>
                            <div class="col-sm-3 text-center">
                                <div class="row">
                                    <div class="col-sm-6">
                                        <label for="startDate" class="select-label">Fecha Desde</label>
                                        <input onchange="submitFiltersForm()" asp-for="Filters.StartDate" class="form-control" type="date" id="startDate" />
                                    </div>
                                    <div class="col-sm-6">
                                        <label for="endDate" class="select-label">Fecha Hasta</label>
                                        <input onchange="submitFiltersForm()" asp-for="Filters.EndDate" class="form-control" type="date" id="endDate" />
                                    </div>
                                </div>
                                <span style="font-size:15px" class="text-danger">@ViewData["DatePickerValidationMessage"]</span>
                            </div>
                        </div>
                        <div class="principal-buttons">
                            <a asp-area="General" asp-controller="DocumentsCC" asp-action="Index" class="cancel-btn"><i class="bi bi-eraser"></i> Limpiar Filtros</a>
                        </div>
                    </div>
                </div>

                <div class="pagination-container">
                    <div>
                        <input type="hidden" asp-for="Pagination.PageIndex" />
                        <label>Registros por página</label>
                        <div class="">
                            <select asp-for="Pagination.PageSize" class="form-select" onchange="paginationButtonActions('firstPage'); this.form.submit();">
                                @foreach (var item in Model.Pagination.ItemsPerPageList)
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            </select>
                        </div>

                        <button type="submit" name="PageIndex" value="1" class="btn btn-sm btn-primary mr-1 pagination-button" onclick="paginationButtonActions('firstPage')"
                                @(Model.Pagination.PageIndex == 1 ? "disabled" : "")>
                            &laquo;&laquo;
                        </button>

                        <button type="submit" class="btn btn-sm btn-primary mr-1 pagination-button" onclick="paginationButtonActions('decrement')"
                                @(Model.Pagination.PageIndex == 1 ? "disabled" : "")>
                            &laquo;
                        </button>

                        <label>@Model.Pagination.PageIndex de @(Math.Ceiling((double)Model.Pagination.TotalResults / Model.Pagination.PageSize))</label>

                        @if (ViewData["TotalPages"] != null)
                        {
                            <button type="submit" class="btn btn-sm btn-primary mr-1 pagination-button" onclick="paginationButtonActions('increment')"
                                @(Model.Pagination.IsLastPage ? "disabled" : "")>
                                &raquo;
                            </button>

                            <button type="submit" class="btn btn-sm btn-primary mr-1 pagination-button" onclick="paginationButtonActions('lastPage')"
                                @(Model.Pagination.IsLastPage ? "disabled" : "")>
                                &raquo;&raquo;
                            </button>
                        }
                        <label><strong>Total Resultados: @Model.Pagination.TotalResults</strong></label>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="global-table-container">
        <table class="">
            <thead>
                <tr>
                    <th class="table-col-big">Cliente/Persona</th>
                    <th class="table-col-little"># Documento</th>
                    <th class="table-col-little">Tipo Doc</th>
                    <th class="table-col-medium">Fecha Documento</th>
                    <th class="table-col-medium">Fecha Vencimiento</th>
                    <th class="table-col-little"># Días a vencer</th>
                    <th class="table-col-little">Monto Total</th>
                    <th class="table-col-little">Saldo</th>
                    <th class="table-col-big">Descripción</th>
                    <th class="table-col-little">Doc Anulado</th>
                    <th class="table-col-little">Empresa</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DocumentsCCList != null)
                {
                    @foreach (var documentCC in Model.DocumentsCCList)
                    {
                        <tr>
                            <td>@documentCC.ClientName</td>
                            <td>@documentCC.DocumentNumber</td>
                            <td>@documentCC.DocumentType</td>
                            <td>@documentCC.DocumentDate.ToString("dd/MM/yyyy")</td>
                            <td>@documentCC.ExpirationDate.ToString("dd/MM/yyyy")</td>
                            <td class="@(documentCC.NumDaysToExpire < 0 ? "red-label" : "green-label")">@documentCC.NumDaysToExpire</td>
                            <td>@(documentCC.DocumentAmount.ToString("#,##0.00"))</td>
                            <td class="@(documentCC.BalanceAmount > 0 ? "red-label" : "green-label")">@(documentCC.BalanceAmount.ToString("#,##0.00"))</td>
                            <td>@documentCC.ApplicationDescription</td>
                            <td class="@(documentCC.Canceled == "S" ? "red-label" : "green-label")">
                                @if (@documentCC.Canceled == "S")
                                {
                                    <strong> <span>Sí</span></strong>
                                }
                                else
                                {
                                    <strong><span>No</span></strong>
                                }
                            </td>
                            <td>@documentCC.CompanyId</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>



@section Scripts{
    @{
    <partial name="_ValidationScriptsPartial" />

    }
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
      function paginationButtonActions(action) {
          if(action == 'increment'){
               var currentValue = parseInt('@Model.Pagination.PageIndex');
          currentValue++;
          $('[name="Pagination.PageIndex"]').val(currentValue);
          } else if(action == 'decrement'){
               var currentValue = parseInt('@Model.Pagination.PageIndex');
          currentValue--;
           $('[name="Pagination.PageIndex"]').val(currentValue);
          $('[name="Pagination.PageIndex"]').val(currentValue);
          } else if(action == 'firstPage'){
          $('[name="Pagination.PageIndex"]').val(1);
          } else if(action == 'lastPage') {
              var newValue = Math.ceil((parseInt('@Model.Pagination.TotalResults') / parseInt('@Model.Pagination.PageSize')));
              $('[name="Pagination.PageIndex"]').val(newValue);
          }
      }
       var moreFiltersDiv = document.getElementById("more-filters");
      function hideShowFilters() {
      if (moreFiltersDiv.classList.contains('hide')) {
          moreFiltersDiv.classList.remove('hide')
          moreFiltersDiv.classList.add('show')
      } else {
          moreFiltersDiv.classList.add('hide')
          moreFiltersDiv.classList.remove('show')
      }
      }

      function submitFiltersForm(){
          paginationButtonActions('firstPage');
           const form = document.getElementById('filtersPaginationForm');
      form.submit();
      }
      function enterInSearch(event) {
      if (event.keyCode === 13 || event.which === 13) {
        submitFiltersForm();
      }
    }

</script>
    }
