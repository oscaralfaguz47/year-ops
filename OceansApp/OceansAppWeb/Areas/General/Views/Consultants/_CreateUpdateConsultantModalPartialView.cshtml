@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{
    var isAuthorizedForManageAdministrativeUsers = await AuthorizationService.AuthorizeAsync(User, "AccessToManageAdministrativeConsultants");
}

<link rel="stylesheet" href="~/css/Shared/sharedInputs.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/sharedComponents.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/General/createUpdateConsultantModal.css?v=@DateTime.Now.Ticks" />

<!--MODAL UPDATE CREATE CONSULTANT-->
<div id="modal-update-create-consultant" class="global-modal" style="display:none">
    <div class="global-modal-content">
        <div class="container">
            <div>
                <div class="close-btn-container"><button id="close-modal-x-btn" onclick="hideModal('modal-update-create-consultant')">x</button></div>
                <h2 id="create-consultant-modal-title"></h2>
                <form id="form-create-update">
                    <input type="hidden" name="consultantId">
                    <div class="row">
                        <div class="col-md-6">
                            <label>Consultant Name <span class="required-asterisk">*</span></label>
                            <div class="input-container">
                                <input type="text" class="form-control" name="name">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label>Consultant Last Name <span class="required-asterisk">*</span></label>
                            <div class="input-container">
                                <input type="text" class="form-control" name="lastName">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label>Internal Email <span class="required-asterisk">*</span></label>
                            <div class="input-container">
                                <input type="email" class="form-control" name="userName">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label>Personal Email</label>
                            <div class="input-container">
                                <input type="email" class="form-control" name="personalEmail">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label for="Contact">Principal Phone Number</label>
                            <div class="input-container">
                                <input type="text" class="form-control" name="phoneNumber">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="Contact">Phone 2</label>
                            <div class="input-container">
                                <input type="text" class="form-control" name="phone2">
                            </div>
                        </div>
                    </div>
                    @if (isAuthorizedForManageAdministrativeUsers.Succeeded)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <label for="UserCategorySelect">User Category <span class="required-asterisk">*</span></label>
                                <div class="custom-select">
                                    <span class="arrow-down"></span>
                                    <select onchange="selectCategory(this.value)" class="form-select" id="UserCategorySelect" name="userCategoryName">
                                        <option value="Administrative">Administrative</option>
                                        <option selected value="Consultant">Consultant</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="UserRoleSelect">User Role <span class="required-asterisk">*</span></label>
                                <div class="custom-select">
                                    <span class="arrow-down"></span>
                                    <select class="form-select" id="UserRoleSelect" name="userRole">
                                    </select>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="row">
                        <div class="col-md-6">
                            <label for="CountrySelect">Positions <span class="required-asterisk">*</span></label>
                            <div class="dropdown">
                                <div class="position-background">
                                    <div>
                                        <button type="button" class="dropbtn"><i class="bi bi-hand-index-thumb"></i> Select</button>
                                    </div>
                                    <div class="selected-opts-cont">
                                        <span id="selectedCount">Selected Positions: 0</span>
                                    </div>

                                </div>
                                <div class="dropdown-content">
                                    <input type="text" id="filterInput" placeholder="Search...">
                                    <div id="optionsContainer">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="CountrySelect">Country <span class="required-asterisk">*</span></label>
                            <div class="custom-select">
                                <span class="arrow-down"></span>
                                <select class="form-select" id="CountrySelect" name="idCountry">
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label for="CountrySelect">Company <span class="required-asterisk">*</span></label>
                            <div class="custom-select">
                                <span class="arrow-down"></span>
                                <select onchange="selectCompany('CompanySelect', this.value, false)" class="form-select" id="CompanySelect" name="CompanyId">
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="PaymentMethodSelect">Payment Method <span class="required-asterisk">*</span></label>
                            <div class="custom-select">
                                <span class="arrow-down"></span>
                                <select class="form-select" id="PaymentMethodSelect" name="idPaymentMethod">
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label for="PaymentPeriodSelect">Payment Period <span class="required-asterisk">*</span></label>
                            <div class="custom-select">
                                <span class="arrow-down"></span>
                                <select class="form-select" id="PaymentPeriodSelect" name="idPaymentPeriod">
                                    <option value>-Select a Payment Period-</option>
                                    <option value="1">Biweekly</option>
                                    <option value="2">Monthly</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6 other-config-cont">
                            <label onclick="displayOtherConfigModal('modal-other-config')"><i class="fa-solid fa-gears"></i> Other configurations <span>(Optional)</span></label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label for="WorkingModelSelect">Working Model <span class="required-asterisk">*</span></label>
                            <div class="custom-select">
                                <span class="arrow-down"></span>
                                <select class="form-select" id="WorkingModelSelect" name="workingModel">
                                    <option value>-Select a Working Model-</option>
                                    <option value="1">Full-time</option>
                                    <option value="2">Part-time</option>
                                    <option value="3">Hourly</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="StartDate">Start Date  <span class="required-asterisk">*</span></label>
                            <div>
                                <input type="date" class="form-control" name="startDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <label for="Contact">Address</label>
                        <div class="input-container">
                            <input type="text" class="form-control" name="address">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="Contact">Location url (Google Maps, Waze, etc.)</label>
                        <div class="input-container">
                            <input type="text" class="form-control" name="location">
                        </div>
                    </div>
                    <div class="green-label m-3" id="saved-consultant-message" style="text-align: center">
                        <label>Now you can add projects to the consultant <i class="bi bi-check-circle-fill"></i></label>
                    </div>
                    <div id="projects-assigned-section">
                        <div style="display: flex;justify-content: space-between;align-items: center; margin-top:15px;">
                            <label><strong>Assigned Projects <span class="required-asterisk">*</span></strong></label>
                            <a style="padding-right: 10px; margin-bottom: 5px;" class="blue-btn" onclick="displayAddUpdateConsultant('modal-update-create-consultant', null)"><i class="bi bi-plus"></i> Add Project</a>
                        </div>
                        <div id="projects-container" class="modal-scroll-container">
                        </div>
                    </div>
                </form>

                <div id="modal-btns-cont" style="display:flex; justify-content:center;">
                    <a id="btn-cancel" onclick="hideModal('modal-update-create-consultant')" class="cancel-btn">Cancel</a>&nbsp;
                    <button id="btn-saving" onclick="createUpdateConsultant('modal-update-create-consultant')" class="btn-primary-submit">
                        <div style="display:flex;align-items:center;">
                            <div style="display:none; margin-right:5px" id="spinner-saving" class="spinner-border" role="status">
                            </div><span></span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!--MODAL OTHER CONFIGURATIONS -->
<div id="modal-other-config" class="global-modal" style="display:none">
    <div class="global-modal-content">
        <div class="container">
            <div>
                <div class="close-btn-container"><button id="close-modal-x-btn" onclick="hideModal('modal-other-config')">x</button></div>
                <h2>Other Configurations</h2>
                <form id="form-other-config">
                    <div class="row">
                        <strong><label>Select the holidays for this consultant.</label></strong>
                        <div class="col-md-6">
                            <div>
                                <label>Holidays</label>
                                <div>
                                    <div>
                                        <select class="form-select" id="HolidaysSelect" name="idConsultantHoliday">
                                        </select>
                                    </div>
                                </div>
                           </div>
                        </div>
                    </div>
                    <div class="row" style="margin-top: 15px;">
                        <strong><label>Paid Time Off Configuration</label></strong>
                        <div class="col-md-12">
                            <div style="display:flex; align-items:center; gap:8px; margin-top:6px;">
                                <input type="checkbox" id="isPtoEligible" name="isEligibleForPaidTimeOff"
                                    onchange="togglePtoFields()" />
                                <label for="isPtoEligible" style="margin:0; font-weight:400;">Is eligible for Paid Time Off?</label>
                            </div>
                        </div>
                        <div class="col-md-6" id="pto-days-container" style="display:none; margin-top:10px;">
                            <label>Annual Paid Days <span class="required-asterisk">*</span></label>
                            <div>
                                <input type="number" class="form-control" id="annualPaidDays"
                                    name="annualPaidTimeOffDays" min="1" placeholder="e.g. 15" />
                            </div>
                        </div>
                        <div class="col-md-6" id="pto-initial-balance-container" style="display:none; margin-top:10px;">
                            <label>Initial PTO Balance</label>
                            <div>
                                <input type="number" class="form-control" id="initialPtoBalance"
                                    name="initialPtoBalance" min="0" placeholder="e.g. 5" />
                            </div>
                            <small style="color:#6b7280;">Carry-over days from previous system</small>
                        </div>
                    </div>
                </form>

                <div id="modal-btns-cont" style="display:flex; justify-content:center;">
                    <a id="btn-cancel" onclick="hideModal('modal-other-config')" class="cancel-btn">Close</a>&nbsp;
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/General/createUpdateConsultantModal.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/General/ConsultantHolidays/holidaysFillDropdown.js?v=@DateTime.Now.Ticks"></script>

