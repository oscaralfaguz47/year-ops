@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="~/css/General/consultants.css" />
<link rel="stylesheet" href="~/css/Shared/pagination.css" />
<link rel="stylesheet" href="~/css/Shared/sharedComponents.css" />
<link rel="stylesheet" href="~/css/Shared/contentPages.css" />

<div style="margin: 0 10px 0 10px; backgroundcolor: #fff;">
    <div class="filters-container">
        <div class="row">
            <div class="search-header-container">
                <div>
                    <h2>CONSULTANTS.</h2>
                    <div class="input-container">
                        <input id="search-input" onchange="enterInSearch(event)" type="text" placeholder="Search" class="form-control">
                        <i class="bi bi-search placeholder-image"></i>
                    </div>
                    <div class="action-buttons">
                        <a onclick="displayUpdateCreateConsultantModal('modal-update-create-consultant',null)">Add New Consultant</a>
                    </div>
                </div>
                <a id="show-hide-filters-btn" onclick="hideShowFilters()"><i class="bi bi-funnel-fill"></i> Hide Filters </a>
            </div>
            <div class="more-filters-cont">
                <div id="more-filters">
                    <div class="row">
                        <div class="col-sm-1">
                            <div class="radio-group active-inactive-rg">
                                <label class="radio-label">
                                    <input onchange="paginationSubmit(false, true)" name="active-inactive" type="radio" value="true" class="radio-input">
                                    <span class="radio-custom"></span>
                                    &nbsp; Active
                                </label>
                                <label class="radio-label">
                                    <input onchange="paginationSubmit(false, true)" name="active-inactive" type="radio" value="false" class="radio-input">
                                    <span class="radio-custom"></span>
                                    &nbsp; Inactive
                                </label>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="radio-group twoFactor-rg">
                                <label class="radio-label">
                                    <input onchange="paginationSubmit(false, true)" name="two-factor" type="radio" value="true" class="radio-input">
                                    <span class="radio-custom"></span>
                                    &nbsp; Two-Factor Auth Enabled
                                </label>
                                <label class="radio-label">
                                    <input onchange="paginationSubmit(false, true)" name="two-factor" type="radio" value="false" class="radio-input">
                                    <span class="radio-custom"></span>
                                    &nbsp; Two-Factor Auth Disabled
                                </label>
                            </div>
                        </div> <div class="col-sm-2">
                            <div class="radio-group confirmedEmail-rg">
                                <label class="radio-label">
                                    <input onchange="paginationSubmit(false, true)" name="confirmedEmail" type="radio" value="true" class="radio-input">
                                    <span class="radio-custom"></span>
                                    &nbsp; Confirmed Email
                                </label>
                                <label class="radio-label">
                                    <input onchange="paginationSubmit(false, true)" name="confirmedEmail" type="radio" value="false" class="radio-input">
                                    <span class="radio-custom"></span>
                                    &nbsp; Unconfirmed Email
                                </label>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label for="year" class="select-label">Country</label>
                            <div class="">
                                <span class="arrow-down"></span>
                                <select id="CountrySelect" class="form-select" onfocus="fillCountriesSelectForFilters(this, 'Select a country')" onchange="paginationSubmit(false, true)">
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="principal-buttons">
                        <a asp-area="General" asp-controller="Consultants" asp-action="Index" class="cancel-btn"><i class="bi bi-eraser"></i> Clear Filters</a>
                    </div>
                </div>
            </div>
            <partial name="_Pagination" />
        </div>
    </div>
    <div class="global-table-container">
        <table>
            <thead>
                <tr>
                    <th onclick="orderByTableList('ConsultantName', 'ConsultantNameTableHeader', 'sortArrowConsultantName')" data-sort="ANY" name="ConsultantNameTableHeader" class="sortable-col">
                        Consultant Name
                        <span class="sort-arrow" id="sortArrowConsultantName">
                        </span>
                    </th>
                    <th onclick="orderByTableList('IsActive', 'IsActiveTableHeader', 'sortArrowIsActive')" data-sort="ANY" name="IsActiveTableHeader" class="sortable-col">
                        User Status
                        <span class="sort-arrow" id="sortArrowIsActive"></span>
                    </th>
                    <th onclick="orderByTableList('TwoFactorEnabled', 'TwoFactorEnabledTableHeader', 'sortArrowTwoFactorEnabled')" data-sort="ANY" name="TwoFactorEnabledTableHeader" class="sortable-col">
                        Two Factor Enabled?
                        <span class="sort-arrow" id="sortArrowTwoFactorEnabled"></span>
                    </th>
                    <th onclick="orderByTableList('EmailConfirmed', 'EmailConfirmedTableHeader', 'sortArrowEmailConfirmed')" data-sort="ANY" name="EmailConfirmedTableHeader" class="sortable-col">
                        Email Confirmed?
                        <span class="sort-arrow" id="sortArrowEmailConfirmed"></span>
                    </th>
                    <th>User Blocked?</th>
                    <th onclick="orderByTableList('InternalEmail', 'InternalEmailTableHeader', 'sortArrowInternalEmail')" data-sort="ANY" name="InternalEmailTableHeader" class="sortable-col">
                        Internal Email
                        <span class="sort-arrow" id="sortArrowInternalEmail"></span>
                    </th>
                    <th onclick="orderByTableList('PersonalEmail', 'PersonalEmailTableHeader', 'sortArrowPersonalEmail')" data-sort="ANY" name="PersonalEmailTableHeader" class="sortable-col">
                        Personal Email
                        <span class="sort-arrow" id="sortArrowPersonalEmail"></span>
                    </th>
                    <th>Assigned Projects</th>
                    <th onclick="orderByTableList('CountryName', 'CountryNameTableHeader', 'sortArrowCountryName')" data-sort="ANY" name="CountryNameTableHeader" class="sortable-col">
                        Country
                        <span class="sort-arrow" id="sortArrowCountryName"></span>
                    </th>
                    <th onclick="orderByTableList('UserCategoryName', 'UserCategoryNameTableHeader', 'sortArrowUserCategoryName')" data-sort="ANY" name="UserCategoryNameTableHeader" class="sortable-col">
                        User Category
                        <span class="sort-arrow" id="sortArrowUserCategoryName"></span>
                    </th>
                    <th>Position</th>
                    <th>Primary Phone</th>
                    <th>Phone 2</th>
                    <th>Address</th>
                    @*<th>Location</th>*@
                    @* <th onclick="orderByTableList('ShirtSize', 'ShirtSizeTableHeader', 'sortArrowShirtSize')" data-sort="ANY" name="ShirtSizeTableHeader" class="sortable-col">
                        Shirt Size
                        <span class="sort-arrow" id="sortArrowShirtSize"></span>
                        </th>*@
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
        <div class="no-results"></div>
    </div>
</div>
<!--CREATE UPDATE CONSULTANT-->
<div>
    <partial name="_CreateUpdateConsultantModalPartialView" />
</div>

@section Scripts{
<script src="~/js/General/consultants.js"></script>
<script src="~/js/General/createUpdateConsultantModal.js"></script>
<script src="~/js/Shared/pagination.js"></script>
<script src="~/js/Shared/sharedComponents.js"></script>
<script src="~/js/AdminCenter/Countries/countriesFillDropdowns.js"></script>
<script src="~/js/AdminCenter/ConsultantPositions/consultantPositionsFillDropdowns.js"></script>
<script src="~/js/AdminCenter/UserRolesPermissions/rolesFillDropdowns.js"></script>
<script src="~/js/AdminCenter/PaymentMethods/paymentMethodsFillDropdowns.js"></script>
    }
