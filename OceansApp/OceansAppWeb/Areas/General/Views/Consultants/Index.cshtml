@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="~/css/General/consultants.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/pagination.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/sharedComponents.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/contentPages.css?v=@DateTime.Now.Ticks" />

<div style="margin: 0 10px 0 10px; backgroundcolor: #fff;">
    <div class="principal-header-container">
        <div class="filters-container">
            <div class="header-page">
                <h2>CONSULTANTS</h2>
            </div>
            <partial name="_Pagination" />
        </div>
        <div class="table-header-actions">
            <div class="input-container">
                <input id="search-input" onchange="enterInSearch(event)" type="text" placeholder="Search" class="form-control">
                <i class="bi bi-search placeholder-image"></i>
            </div>
            <div class="action-btns-container">
                <button title="Add new consultant" id="openSidebarBtn" onclick="displayUpdateCreateConsultantModal('modal-update-create-consultant',null)"><img src="/icons/Shared/add.svg"></button>
                <button title="See more filters" id="openSidebarBtn" onclick="displayMoreFiltersConsultants()"><img src="/icons/Shared/filter.svg"></button>
            </div>
        </div>
    </div>
    <div class="global-table-container">
        <table>
            <thead>
                <tr>
                    <th onclick="orderByTableList('ConsultantName', 'ConsultantNameTableHeader', 'sortArrowConsultantName')" data-sort="ANY" name="ConsultantNameTableHeader" class="sortable-col">
                        Consultant Name
                        <span class="sort-arrow" id="sortArrowConsultantName">
                        </span>
                    </th>
                    <th onclick="orderByTableList('IsActive', 'IsActiveTableHeader', 'sortArrowIsActive')" data-sort="ANY" name="IsActiveTableHeader" class="sortable-col">
                        User Status
                        <span class="sort-arrow" id="sortArrowIsActive"></span>
                    </th>
                    <th onclick="orderByTableList('TwoFactorEnabled', 'TwoFactorEnabledTableHeader', 'sortArrowTwoFactorEnabled')" data-sort="ANY" name="TwoFactorEnabledTableHeader" class="sortable-col">
                        Two Factor Enabled
                        <span class="sort-arrow" id="sortArrowTwoFactorEnabled"></span>
                    </th>
                    <th onclick="orderByTableList('TwoFactorRequired', 'TwoFactorRequiredTableHeader', 'sortArrowTwoFactorRequired')" data-sort="ANY" name="TwoFactorRequiredTableHeader" class="sortable-col">
                        Two Factor Required
                        <span class="sort-arrow" id="sortArrowTwoFactorRequired"></span>
                    </th>
                    <th onclick="orderByTableList('EmailConfirmed', 'EmailConfirmedTableHeader', 'sortArrowEmailConfirmed')" data-sort="ANY" name="EmailConfirmedTableHeader" class="sortable-col">
                        Email Confirmed
                        <span class="sort-arrow" id="sortArrowEmailConfirmed"></span>
                    </th>
                    <th>User Blocked</th>
                    <th onclick="orderByTableList('InternalEmail', 'InternalEmailTableHeader', 'sortArrowInternalEmail')" data-sort="ANY" name="InternalEmailTableHeader" class="sortable-col">
                        Internal Email
                        <span class="sort-arrow" id="sortArrowInternalEmail"></span>
                    </th>
                    <th onclick="orderByTableList('PersonalEmail', 'PersonalEmailTableHeader', 'sortArrowPersonalEmail')" data-sort="ANY" name="PersonalEmailTableHeader" class="sortable-col">
                        Personal Email
                        <span class="sort-arrow" id="sortArrowPersonalEmail"></span>
                    </th>
                    <th>Assigned Projects</th>
                    <th onclick="orderByTableList('CountryName', 'CountryNameTableHeader', 'sortArrowCountryName')" data-sort="ANY" name="CountryNameTableHeader" class="sortable-col">
                        Country
                        <span class="sort-arrow" id="sortArrowCountryName"></span>
                    </th>
                    <th onclick="orderByTableList('UserCategoryName', 'UserCategoryNameTableHeader', 'sortArrowUserCategoryName')" data-sort="ANY" name="UserCategoryNameTableHeader" class="sortable-col">
                        User Category
                        <span class="sort-arrow" id="sortArrowUserCategoryName"></span>
                    </th>
                    <th>Position</th>
                    <th>Primary Phone</th>
                    <th>Phone 2</th>
                    <th>Address</th>
                    <th>Location</th>
                    @* <th onclick="orderByTableList('ShirtSize', 'ShirtSizeTableHeader', 'sortArrowShirtSize')" data-sort="ANY" name="ShirtSizeTableHeader" class="sortable-col">
                    Shirt Size
                    <span class="sort-arrow" id="sortArrowShirtSize"></span>
                    </th>*@
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
        <div class="no-results"></div>
    </div>
</div>
<partial name="_SidebarRightPartial" />
<!--CREATE UPDATE CONSULTANT-->
<div>
    <partial name="_CreateUpdateConsultantModalPartialView" />
</div>

<script src="~/js/General/consultants.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/General/createUpdateConsultantModal.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/pagination.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/sharedComponents.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AdminCenter/Countries/countriesFillDropdowns.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AdminCenter/ConsultantPositions/consultantPositionsFillDropdowns.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AdminCenter/UserRolesPermissions/rolesFillDropdowns.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AdminCenter/PaymentMethods/paymentMethodsFillDropdowns.js?v=@DateTime.Now.Ticks"></script>

