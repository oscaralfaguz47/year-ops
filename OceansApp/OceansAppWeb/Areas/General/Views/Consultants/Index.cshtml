@using OceansApp.Models.ViewModels.Providers
@model ProviderGetAllForListVM
@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers


<link rel="stylesheet" href="~/css/General/consultants.css" />
<link rel="stylesheet" href="~/css/Shared/pagination.css" />


<div style="margin: 0 10px 0 10px; backgroundcolor: #fff;">
    <div class="filters-container">
        <div class="row">
            <form id="filtersPaginationForm" asp-controller="Consultants" asp-action="Index">
                <div class="search-header-container">
                    <div>
                        <h2>CONSULTORES</h2>
                        <div class="input-container">
                            <input onkeypress="enterInSearch(event)" type="text" asp-for="Filters.SearchText" placeholder="Buscar" class="form-control">
                            <i class="bi bi-search placeholder-image"></i>
                        </div>
                    </div>
                    <a id="show-hide-filters-btn" onclick="hideShowFilters()"><i class="bi bi-funnel-fill"></i> Ocultar Filtros </a>
                </div>
                <div class="more-filters-cont">
                    <div id="more-filters">
                        <div class="row">
                            <div class="col-sm-1">
                                <div class="radio-group">
                                    <label class="radio-label">
                                        <input onchange="submitFiltersForm()" asp-for="Filters.IsActive" type="radio" value="S" class="radio-input">
                                        <span class="radio-custom"></span>
                                        &nbsp; Activos
                                    </label>
                                    <label class="radio-label">
                                        <input onchange="submitFiltersForm()" asp-for="Filters.IsActive" type="radio" value="N" class="radio-input">
                                        <span class="radio-custom"></span>
                                        &nbsp; Inactivos
                                    </label>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <label for="country" class="select-label">País</label>
                                <div class="">
                                    <span class="arrow-down"></span>
                                    <select onchange="submitFiltersForm()" id="country" asp-for="Filters.CountryId" class="form-select">
                                        <option selected value="">Selecciona un País</option>
                                        @foreach (var country in Model.CountriesList)
                                        {
                                            <option value="@country.Value">@country.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <label for="client" class="select-label">Cliente</label>
                                <div class="">
                                    <span class="arrow-down"></span>
                                    <select onchange="submitFiltersForm()" id="client" asp-for="Filters.ClientId" class="form-select">
                                        <option selected value="">Selecciona un Cliente</option>
                                        @foreach (var client in Model.ClientList)
                                        {
                                            <option value="@client.Value">@client.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="radio-group">
                                    <label class="radio-label">
                                        <input onchange="submitFiltersForm()" asp-for="Filters.CompanyId" type="radio" value="OCE" class="radio-input">
                                        <span class="radio-custom"></span>
                                        &nbsp; Oceans Consulting
                                    </label>
                                    <label class="radio-label">
                                        <input onchange="submitFiltersForm()" asp-for="Filters.CompanyId" type="radio" value="LLC" class="radio-input">
                                        <span class="radio-custom"></span>
                                        &nbsp; OCE, LLC
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="principal-buttons">
                            <a asp-area="General" asp-controller="Consultants" asp-action="Index" class="cancel-btn"><i class="bi bi-eraser"></i> Limpiar Filtros</a>
                            @* <button class="btn-primary-submit" type="submit">Aplicar Filtros</button>*@
                        </div>
                    </div>
                </div>

                <div class="pagination-container">
                    <div>
                        <input type="hidden" asp-for="Pagination.PageIndex" />
                        <label>Registros por página</label>
                        <div class="">
                            <select asp-for="Pagination.PageSize" class="form-select" onchange="paginationButtonActions('firstPage'); this.form.submit();">
                                @foreach (var item in Model.Pagination.ItemsPerPageList)
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            </select>
                        </div>

                        <button type="submit" name="PageIndex" value="1" class="btn btn-sm btn-primary mr-1 pagination-button" onclick="paginationButtonActions('firstPage')"
                                @(Model.Pagination.PageIndex == 1 ? "disabled" : "")>
                            &laquo;&laquo;
                        </button>

                        <button type="submit" class="btn btn-sm btn-primary mr-1 pagination-button" onclick="paginationButtonActions('decrement')"
                                @(Model.Pagination.PageIndex == 1 ? "disabled" : "")>
                            &laquo;
                        </button>

                        <label>@Model.Pagination.PageIndex de @(Math.Ceiling((double)Model.Pagination.TotalResults / Model.Pagination.PageSize))</label>

                        @if (ViewData["TotalPages"] != null)
                        {
                            <button type="submit" class="btn btn-sm btn-primary mr-1 pagination-button" onclick="paginationButtonActions('increment')"
                                @(Model.Pagination.IsLastPage ? "disabled" : "")>
                                &raquo;
                            </button>

                            <button type="submit" class="btn btn-sm btn-primary mr-1 pagination-button" onclick="paginationButtonActions('lastPage')"
                                @(Model.Pagination.IsLastPage ? "disabled" : "")>
                                &raquo;&raquo;
                            </button>
                        }
                        <label><strong>Total Resultados: @Model.Pagination.TotalResults</strong></label>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="global-table-container">
        <table class="">
            <thead>
                <tr>
                    <th class="table-col-big">Nombre</th>
                    <th class="table-col-little">Estado</th>
                    <th class="table-col-medium">Fecha de Ingreso</th>
                    <th class="table-col-medium">Cliente</th>
                    <th class="table-col-medium">Rate Cliente(Hora)</th>
                    <th class="table-col-medium">Rate Cliente(Mensual)</th>
                    <th class="table-col-medium">Salario (Hora)</th>
                    <th class="table-col-medium">Salario (Mensual)</th>
                    <th class="table-col-medium">Posición</th>
                    <th class="table-col-little">País</th>
                    <th class="table-col-medium">Correo Interno</th>
                    <th class="table-col-medium">Correo Personal</th>
                    <th class="table-col-medium">Teléfono 1</th>
                    <th class="table-col-medium">Teléfono 2</th>
                    <th class="table-col-extra-big">Dirección</th>
                    <th class="table-col-big">Ubicación Waze/Google Maps</th>
                    <th class="table-col-big">Notas</th>
                    <th class="table-col-medium">Categoría Consultor</th>
                    <th class="table-col-medium">Talla Camiseta</th>
                    <th class="table-col-little">Empresa</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ConsultantList != null)
                {
                    @foreach (var consultant in Model.ConsultantList)
                    {
                        <tr>
                            <td>@consultant.Name</td>
                            <td class="@(consultant.IsActive == "S" ? "green-label" : "red-label")">
                                @if (@consultant.IsActive == "S")
                                {
                                   <strong> <span>Activo</span></strong>
                                }
                                else
                                {
                                    <strong><span>Inactivo</span></strong>
                                }
                            </td>
                            <td>@consultant.AdmissionDate.ToString("dd/MM/yyyy")</td>
                            @if (@consultant.ClientName == null)
                            {
                                <td>Administrativo</td>
                            }
                            else
                            {
                                <td>@consultant.ClientName</td>
                            }
                            <td>@(consultant.HourlyClientRate?.ToString("#,##0.00") ?? "El rate es Mensual")</td>
                            <td>@(consultant.MonthlyClientRate?.ToString("#,##0.00") ?? "El rate es por hora")</td>
                            <td>@(consultant.HourlySalary?.ToString("#,##0.00") ?? "El salario es Mensual")</td>
                            <td>@(consultant.MonthlySalary?.ToString("#,##0.00") ?? "El salario es por hora")</td>
                            <td>@consultant.Occupation</td>
                            <td>@consultant.CountryName</td>
                            <td>@consultant.Email</td>
                            <td>@consultant.PersonalEmail</td>
                            <td>@consultant.Phone1</td>
                            <td>@consultant.Phone2</td>
                            <td>@consultant.Address</td>
                            <td>
                                @if (consultant.Location == null)
                                {
                                    <span>Sin ubicación</span>
                                }
                                else
                                {
                                    <div class="location-cont">
                                        <button onclick="copyToClipboard('@consultant.Location', 'La ubicación de: ' + '@consultant.Name' + ' fue copiada en el portapapeles!')">
                                            <i class="bi bi-clipboard-fill"></i> Copiar Ubicación
                                        </button> &nbsp;
                                        <a href="@consultant.Location" target="_blank" class="link"><i class="bi bi-geo-alt-fill"></i> Ir a la dirección</a>
                                    </div>
                                }
                            </td>
                            <td>@consultant.Notes</td>
                            <td>@consultant.ConsultantCategory</td>
                            <td>@consultant.ShirtSize</td>
                            <td>@consultant.CompanyId</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>



@section Scripts{
    @{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Shared/pagination.js"></script>
    }
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
      function paginationButtonActions(action) {
          if(action == 'increment'){
               var currentValue = parseInt('@Model.Pagination.PageIndex');
          currentValue++;
          $('[name="Pagination.PageIndex"]').val(currentValue);
          } else if(action == 'decrement'){
               var currentValue = parseInt('@Model.Pagination.PageIndex');
          currentValue--;
           $('[name="Pagination.PageIndex"]').val(currentValue);
          $('[name="Pagination.PageIndex"]').val(currentValue);
          } else if(action == 'firstPage'){
          $('[name="Pagination.PageIndex"]').val(1);
          } else if(action == 'lastPage') {
              var newValue = Math.ceil((parseInt('@Model.Pagination.TotalResults') / parseInt('@Model.Pagination.PageSize')));
              $('[name="Pagination.PageIndex"]').val(newValue);
          }
      }

      function submitFiltersForm(){
          paginationButtonActions('firstPage');
           const form = document.getElementById('filtersPaginationForm');
      form.submit();
      }
      function enterInSearch(event) {
      if (event.keyCode === 13 || event.which === 13) {
        submitFiltersForm();
      }
    }

</script>
    }
