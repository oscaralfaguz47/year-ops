@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="~/css/Shared/pagination.css" />

<div style="margin: 0 10px 0 10px; backgroundcolor: #fff;">
    <div class="filters-container">
        <div class="row">
            <div class="search-header-container">
                <div>
                    <h2>HOLIDAYS</h2>
                    <div class="input-container">
                        <input id="search-input" onkeypress="enterInSearch(event)" type="text" placeholder="Buscar" class="form-control">
                        <i class="bi bi-search placeholder-image"></i>
                    </div>
                </div>
                <a id="show-hide-filters-btn" onclick="hideShowFilters()"><i class="bi bi-funnel-fill"></i> Ocultar Filtros </a>
            </div>
            <div class="more-filters-cont">
                <div id="more-filters">
                    <div class="row">
                        <div class="col-sm-2">
                            <label for="year" class="select-label">Año</label>
                            <div class="">
                                <span class="arrow-down"></span>
                                <select id="year" class="form-select" onchange="paginationSubmit(false, true)">
                                    <option selected value="">Selecciona el año</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="principal-buttons">
                        <a asp-area="General" asp-controller="ConsultantHolidays" asp-action="Index" class="cancel-btn"><i class="bi bi-eraser"></i> Limpiar Filtros</a>
                    </div>
                </div>
            </div>
            <partial name="_Pagination" />
        </div>
    </div>
    <div class="global-table-container">
        <table class="">
            <thead>
                <tr>
                    <th onclick="orderByTableList('Year', 'YearTableHeader')" data-sort="ANY" name="YearTableHeader" class="table-col-medium">Año <span id="sortArrow"></span></th>
                    <th class="table-col-medium">Cliente / Categoría</th>
                    <th class="table-col-medium">Fecha de Creación</th>
                    <th class="table-col-medium">Creado por</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
        <div class="no-results"></div>
    </div>
</div>

@section Scripts{
<script src="~/js/Shared/pagination.js"></script>
<script src="~/js/General/consultantHolidays.js"></script>
    }
