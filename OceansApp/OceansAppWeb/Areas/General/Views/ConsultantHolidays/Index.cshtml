@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="~/css/Shared/pagination.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/General/consultantHolidays.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/sharedComponents.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/contentPages.css?v=@DateTime.Now.Ticks" />

<div style="margin: 0 10px 0 10px; backgroundcolor: #fff;">
    <div class="filters-container">
        <div>
            <div class="search-header-container">
                <div>
                    <h2>HOLIDAYS LISTS</h2>
                    <div class="input-container">
                        <input id="search-input" onchange="enterInSearch(event)" type="text" placeholder="Search" class="form-control">
                        <i class="bi bi-search placeholder-image"></i>
                    </div>
                    <div class="action-buttons">
                        <a onclick="displayCreateUpdateModal('modal-create-holiday', 'CREATE NEW HOLIDAYS LIST',null)">Create Holidays List</a>
                    </div>
                </div>
                <a id="show-hide-filters-btn" onclick="hideShowFilters()"><i class="bi bi-funnel-fill"></i> Hide Filters </a>
            </div>
            <div class="more-filters-cont">
                <div id="more-filters">
                    <div class="row">
                    </div>
                    <div class="principal-buttons">
                        <a asp-area="General" asp-controller="ConsultantHolidays" asp-action="Index" class="cancel-btn"><i class="bi bi-eraser"></i> Clear Filters</a>
                    </div>
                </div>
            </div>
            <partial name="_Pagination" />
        </div>
    </div>
    <div class="global-table-container">
        <table class="">
            <thead>
                <tr>
                    <th onclick="orderByTableList('Name', 'NameTableHeader', 'sortArrowName')" data-sort="ANY" name="NameTableHeader" class="table-col-big sortable-col">
                        Holidays List Name
                        <span class="sort-arrow" id="sortArrowName">
                        </span>
                    </th>
                    <th class="table-col-medium">#Holidays</th>
                    <th onclick="orderByTableList('CreationDate', 'CreationDateTableHeader', 'sortArrowCreationDate')" data-sort="ANY" name="CreationDateTableHeader" class="table-col-medium sortable-col">
                        Creation Date
                        <span class="sort-arrow" id="sortArrowCreationDate">
                        </span>
                    </th>
                    <th class="table-col-medium">Created By</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
        <div class="no-results"></div>
    </div>
</div>

<!--MODAL CREATE HOLIDAY -->
<div id="modal-create-holiday" class="global-modal" style="display:none">
    <div class="global-modal-content">
        <div class="container">
            <div>

                <h2 id="create-edit-holiday-title">
                </h2>
                <form id="form-create-update">
                    <div class="inputs-header-cont">
                        <input id="holidaysListId" name="consultantHolidayId" type="hidden">
                        <input formnovalidate="holidayName" name="holidayName" type="text" class="form-control" id="holidayName" placeholder="Insert the Holidays list Name">
                    </div>
                    <div class="add-dates-btn-cont">
                        <a style="padding-right: 10px" class="blue-btn" onclick="addNewDateRow(null)"><i class="bi bi-plus"></i> Add Date</a>
                    </div>
                    <div id="holidays-dates-container" class="modal-scroll-container">
                    </div>
                </form>
                <div id="modal-btns-cont" style="display:flex; justify-content:center;">
                    <a id="btn-cancel" onclick="hideModal('modal-create-holiday')" class="cancel-btn">Cancel</a>&nbsp;
                    <button id="btn-saving" onclick="createUpdateHoliday('modal-create-holiday')" class="btn-primary-submit">
                        <div style="display:flex;align-items:center;">
                            <div style="display:none; margin-right:5px" id="spinner-saving" class="spinner-border" role="status">
                            </div><span></span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/Shared/pagination.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/General/ConsultantHolidays/consultantHolidays.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/Dates/datesMethods.js?v=@DateTime.Now.Ticks"></script>
