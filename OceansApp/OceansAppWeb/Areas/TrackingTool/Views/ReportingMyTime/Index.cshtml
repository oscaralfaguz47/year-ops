@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="~/css/TrackingTool/reportingMyTime.css" />

<div id="rmt-background">
    <div id="header">
        <div id="proj-drop-cont">
            <div id="project-name"></div>
            <div id="projectsDropdown" class="dropdown">
                <div class="dropdown-header">
                    <span class="dropdown-selected"><div class="circle"></div></span>
                </div>
                <ul class="dropdown-list"></ul>
            </div>
        </div>
    </div>

    <div id="loading-box">
        <div>
            <div class="spinner"></div>
            <div>
                <p><strong>Loading project info, wait...</strong></p>
            </div>
        </div>
    </div>

    <div id="error-Message-box">
        <div>
            <div><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div>
                <p><strong>Something went wrong!</strong></p>
            </div>
            <a asp-area="TrackingTool" asp-controller="ReportingMyTime" asp-action="Index" class="cancel-btn">Try Again</a>
        </div>
    </div>

    <div id="no-projects-box">
        <div>
            <div class="background-cont">
                <div><i>Wow!</i></div>
                <p><strong>Looks like you do not have assigned projects yet.</strong></p>
                <p><strong>Please contact the administrator to assign you a project</strong></p>
            </div>
        </div>
    </div>


    <div id="content-box">
        <div class="container">
            <!-- Date Navegation buttons -->
            <div class="row">
                <div class="col-md-8">
                    <div class="text-center mb-2"> <i class="fa-regular fa-calendar"></i> <strong>SELECT THE PERIOD</strong></div>
                    <div class="navegation-box">
                        <button class="btn-arrow" onclick="handleButtonClick('left')">< Previous</button>
                        <label id="previous-date"></label> - <label id="next-date"></label>
                        <button class="btn-arrow" onclick="handleButtonClick('right')">Next ></button>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-8">
                        <div id="tracking-tool-time-entry" style="display:none">
                            <partial name="_TrackingToolTimeEntryPartialView" />
                        </div>
                        <div id="tracking-tool-report-entry" style="display:none">
                            <partial name="_TrackingToolReportEntryPartialView" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="track-col">
                            <div id="questions">
                            </div>
                        </div>
                        <div class="track-col">
                            <div id="payment-period-container">
                            </div>
                        </div>
                        <div class="track-col">
                            <div class="submit-report">
                                Have you reported all your hours accurately? <button onclick="submitReportToBePaid()"><i class="fa-regular fa-paper-plane"></i> Submit Report to get paid</button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>



    <script src="~/js/TrackingTool/reportingMyTime.js"></script>
    <script src="~/js/AccountManagement/Projects/projectsConsultantAssigned.js"></script>
