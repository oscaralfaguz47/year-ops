@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers
<link rel="stylesheet" href="~/css/TrackingTool/trackingToolReportEntry.css?v=@DateTime.Now.Ticks" />

<div id="no-tracking-tool-sec">
    <div class="mt-3 no-tracking-tool-row">
        <input type="hidden" id="movementIdNormalHoursInput" />
        <div class="no-tracking-tool-col">
            <div class="upload-files-inputs-container">
                <div class="file-upload-container" id="primary-upload-files-input">
                    <div class="file-upload-wrapper">
                        <span class="file-input-title">
                        </span>
                        <input type="file" name="file-upload" id="file-upload-primary" class="file-upload-input" multiple hidden />
                        <label id="upload-btn-primary" for="file-upload-primary" class="file-upload-label">
                            <i class="fa fa-cloud-upload"></i>
                        </label>
                        <div class="uploaded-files-section">
                            <div>
                                <span id="file-upload-name-primary" class="file-upload-name"></span>
                                <span class="file-upload-instructions" id="info-text-primary">
                                    <strong>No files selected...</strong><br />
                                    <span>Drag and Drop, Select files or Copy and Paste screenshots here...</span>
                                </span>
                            </div>
                        </div>
                        <div class="preview-files-section">
                            <button onclick="previewPrimaryUploadedFiles('modal-preview-files')">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" width="18" height="18">
                                    <path d="M288 32c-80.8 0-145.5 36.8-192.6 80.6C48.6 156 17.3 208 2.5 243.7c-3.3 7.9-3.3 16.7 0 24.6C17.3 304 48.6 356 95.4 399.4C142.5 443.2 207.2 480 288 480s145.5-36.8 192.6-80.6c46.8-43.5 78.1-95.4 93-131.1c3.3-7.9 3.3-16.7 0-24.6c-14.9-35.7-46.2-87.7-93-131.1C433.5 68.8 368.8 32 288 32zM144 256a144 144 0 1 1 288 0 144 144 0 1 1 -288 0zm144-64c0 35.3-28.7 64-64 64c-7.1 0-13.9-1.2-20.3-3.3c-5.5-1.8-11.9 1.6-11.7 7.4c.3 6.9 1.3 13.8 3.2 20.7c13.7 51.2 66.4 81.6 117.6 67.9s81.6-66.4 67.9-117.6c-11.1-41.5-47.8-69.4-88.6-71.1c-5.8-.2-9.2 6.1-7.4 11.7c2.1 6.4 3.3 13.2 3.3 20.3z" />
                                </svg>
                                Preview Uploaded Files
                            </button>
                        </div>
                    </div>
                </div>

                <div class="file-upload-container" id="second-upload-files-input">
                    <div style="width:min-content">
                        <div class="file-upload-wrapper">
                            <span class="file-input-title">
                            </span>
                            <input type="file" name="file-upload" id="file-upload-second" class="file-upload-input" multiple hidden />
                            <label id="upload-btn-second" for="file-upload-second" class="file-upload-label">
                                <i class="fa fa-cloud-upload"></i>
                            </label>
                            <div class="uploaded-files-section">
                                <div>
                                    <span id="file-upload-name-second" class="file-upload-name"></span>
                                    <span class="file-upload-instructions" id="info-text-second">
                                        <strong>No files selected...</strong><br />
                                        <span>Drag and Drop, Select files or Copy and Paste screenshots here...</span>
                                    </span>
                                </div>
                            </div>
                            <div class="preview-files-section">
                                <button onclick="previewSecondUploadedFiles('modal-preview-files')">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" width="18" height="18">
                                        <path d="M288 32c-80.8 0-145.5 36.8-192.6 80.6C48.6 156 17.3 208 2.5 243.7c-3.3 7.9-3.3 16.7 0 24.6C17.3 304 48.6 356 95.4 399.4C142.5 443.2 207.2 480 288 480s145.5-36.8 192.6-80.6c46.8-43.5 78.1-95.4 93-131.1c3.3-7.9 3.3-16.7 0-24.6c-14.9-35.7-46.2-87.7-93-131.1C433.5 68.8 368.8 32 288 32zM144 256a144 144 0 1 1 288 0 144 144 0 1 1 -288 0zm144-64c0 35.3-28.7 64-64 64c-7.1 0-13.9-1.2-20.3-3.3c-5.5-1.8-11.9 1.6-11.7 7.4c.3 6.9 1.3 13.8 3.2 20.7c13.7 51.2 66.4 81.6 117.6 67.9s81.6-66.4 67.9-117.6c-11.1-41.5-47.8-69.4-88.6-71.1c-5.8-.2-9.2 6.1-7.4 11.7c2.1 6.4 3.3 13.2 3.3 20.3z" />
                                    </svg>
                                    Preview Uploaded Files
                                </button>
                            </div>
                        </div>
                        <div>
                            <label id="info-message-second-input"></label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="no-tracking-tool-col report-input-cont">
            <div>
                <div id="holidaysContainer" class="fields-backg">
                </div>
                <div class="fields-backg">
                    <div class="col-7">
                        <label>Total Regular Hours <span class="red-label">*</span></label>

                        <div class="tooltip-container">
                            <i class="fa-solid fa-circle-info tooltip-target"></i>
                            <div class="tooltip-content">
                                <div class="tooltip-arrow"></div>
                                Enter only regular worked hours. Exclude days off, on-call flate rates, worked on-call hours, and holidays not worked.
                            </div>
                        </div>
                    </div>
                    <div class="col-5">
                        <input type="number" placeholder="0.00" oninput="limitDigitsAndDecimals(this); handleChangeData()" class="input-time" id="quantityInput" value="0" />
                    </div>
                </div>
                <div id="on-call-section">
                    <div class="fields-backg">
                        <div class="col-7">
                            <label>On-Call Flate Rate</label>
                        </div>
                        <div class="col-5">
                            <div>
                                <span class="arrow-down"></span>
                                <select onchange="handleChangeData()" class="form-select" id="onCallFlateRateSelect">
                                    <option selected value="0">-No On-Calls-</option>
                                    <option value="1">1 On-Call</option>
                                    <option value="2">2 On-Calls</option>
                                    <option value="3">3 On-Calls</option>
                                    <option value="4">4 On-Calls</option>
                                    <option value="5">5 On-Calls</option>
                                    <option value="6">6 On-Calls</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="fields-backg">
                        <div class="col-7">
                            <label>On-Call Time Worked</label>
                        </div>
                        <div class="col-5">
                            <input type="number" placeholder="0.00" class="input-time" oninput="limitDigitsAndDecimals(this); handleChangeData()" id="onCallTimeWorkedInput" value="0" />
                        </div>
                    </div>
                </div>
                <div>
                    <label for="notesInput">Additional Notes (Optional)</label>
                    <div>
                        <textarea oninput="handleChangeData()" id="notesInput" class="input-time"></textarea>
                    </div>
                </div>
                <div class="save-report-cont">
                    <button id="save-btn" onclick="createUpdateTimeEntry()"><i class="fa-solid fa-floppy-disk"></i> Please save your changes</button>
                </div>
            </div>
        </div>

    </div>
</div>


<partial name="_TrackingToolReportPreviewUploadedFilesPartialView" />

<script src="~/js/TrackingTool/trackingToolReportEntry.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/inputValidations.js?v=@DateTime.Now.Ticks"></script>