<link rel="stylesheet" href="~/css/TrackingTool/trackingToolReportEntry.css" />

<div class="track-col">
    <div class="row">
        <input type="hidden" id="movementIdInput" />
        <div class="col-md-12 text-center report-input-cont">
            <label for="quantityInput">Total Worked Hours <span class="red-label">*</span></label>
            <div>
                <input type="number" class="input-time" id="quantityInput" />
            </div>
        </div>
        <div class="col-md-6">
        </div>
    </div>
    <div class="file-upload-container">
        <div class="file-upload-wrapper">
            <input type="file" name="file-upload" id="file-upload" class="file-upload-input" multiple hidden />
            <label for="file-upload" class="file-upload-label">
                <i class="fa fa-cloud-upload"></i> Upload your report here
            </label>
            <span id="file-upload-name" class="file-upload-name">No files selected...</span>
            <p class="file-upload-instructions">
                Drag and Drop, Select or Copy and Paste files here..
            </p>
        </div>
    </div>
    <div class="text-center mt-2">
        <label for="quantityInput">Notes (Optional)</label>
        <div>
            <textarea id="notesInput" class="input-time"></textarea>
        </div>
    </div>
    <div class="save-report-cont">
        <button onclick="createUpdateTimeEntry()"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
    </div>
</div>
<br />
<br />
<br />
<br />
<br />
<br />


<script src="~/js/TrackingTool/trackingToolReportEntry.js"></script>