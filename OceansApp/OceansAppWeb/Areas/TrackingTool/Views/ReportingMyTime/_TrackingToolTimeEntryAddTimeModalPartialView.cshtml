@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers
<link rel="stylesheet" href="~/css/TrackingTool/addTimetrackingToolModal.css" />
<link rel="stylesheet" href="~/css/Shared/sharedComponents.css" />

<div id="modal-update-create-time" class="global-modal" style="display:none">
    <div class="global-modal-content">
        <div class="container">
            <div>
                <div class="close-btn-container"><button id="close-modal-x-btn" onclick="hideModal('modal-update-create-time')">x</button></div>
                <h2 id="create-update-time-modal-title"></h2>
                <form id="form-create-update">
                    <input type="hidden" id="movementIdInput">
                    <input type="hidden" id="actionDateInput" />
                   <div class="time-inputs-container">
                        <div>
                            <label>From</label>
                            <input id="timeFromInput" type="time" class="time-from input-time" />
                        </div>
                        <div>
                            <label>To</label>
                            <input id="timeToInput" type="time" class="time-to input-time" />
                        </div>
                   </div>
                   <span id="time-zero-val-message" class="validation-message">You cannot add time equals to zero</span>
                   <label>Additional Notes</label>
                    <textarea id="addNotesInput" class="time-detail input-time"></textarea>
                </form>

                <div id="modal-btns-cont" style="display:flex; justify-content:center;">
                    <button id="btn-cancel" onclick="deleteTrackingToolTimeEntry('modal-update-create-time')" class="cancel-btn">
                        <div style="display:flex;align-items:center;">
                            <div style="display:none; margin-right:5px" class="spinner-border" role="status">
                            </div><span></span>
                        </div>
                    </button>&nbsp;
                    <button id="btn-saving" onclick="createUpdateTimeEntryTrackingTool('modal-update-create-time')" class="btn-primary-submit">
                        <div style="display:flex;align-items:center;">
                            <div style="display:none; margin-right:5px" class="spinner-border" role="status">
                            </div><span></span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/TrackingTool/addTimeTrackingToolModal.js"></script>
<script src="~/js/Shared/sharedComponents.js"></script>