<link rel="stylesheet" href="~/css/ProjectManagement/sharedProjectsMethods.css" />

<div id="modal-add-consultant" class="global-modal" style="display:none">
    <div class="global-modal-content">
        <div class="container">
            <div>
                <h2 id="add-consultant-modal-title"></h2>
                <form id="form-add-update-consultant">
                    <div id="consultants-search-cont">
                        <div class="input-container">
                            <input id="search-consultant-input" autocomplete="off" oninput="searchConsultantsBySearchText(this, 'consultantIdFromSearch', 'consultantNameInput', 'consultantEmailInput')" type="text" placeholder="Search consultant" class="form-control">
                            <i class="bi bi-search placeholder-image"></i>
                            <div id="consultant-search-results" class="search-results"></div>
                        </div>
                        <input type="hidden" name="consultantIdFromSearch" id="consultantIdFromSearch">
                    </div>
                    <div class="row">
                        <div class="col-lg-6">
                            <label>Consultant Name</label>
                            <div class="input-container">
                                <input disabled type="text" class="form-control" name="consultantNameInput" id="consultantNameInput">
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <label>Consultant Email</label>
                            <div class="input-container">
                                <input disabled type="text" class="form-control" id="consultantEmailInput">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <label>Position description</label>
                            <div class="input-container">
                                <input placeholder="Enter a position description (Full Stack Developer)" type="text" class="form-control" name="positionDetail" id="positionDetail">
                            </div>
                        </div>
                    </div>

                    <div style="margin-top: 5px" class="radio-group monthly-mode-rg">
                        <label style="margin-top: 0" class="radio-label">
                            <input onchange="validateRatesInputs()" name="client-rate-model" type="radio" value="H" checked class="radio-input">
                            <span class="radio-custom"></span>
                            &nbsp; Client rate hourly.<span style="font-weight: normal"> (Ex: $55)</span>
                        </label>
                        <label class="radio-label">
                            <input onchange="validateRatesInputs()" name="client-rate-model" type="radio" value="M" class="radio-input">
                            <span class="radio-custom"></span>
                            &nbsp; Client rate monthly.<span style="font-weight: normal"> (Monthly On Time Fee. Ex: $10,000)</span>
                        </label>
                    </div>
                    <div style="margin-top: 5px" class="radio-group">
                        <label style="margin-top: 0" class="radio-label">
                            <input onchange="validateRatesInputs()" name="consultant-rate-model" type="radio" checked value="M" class="radio-input">
                            <span class="radio-custom"></span>
                            &nbsp; Consultant rate monthly.<span style="font-weight: normal"> (The hourly rate is calculated based on business days and monthly base)</span>
                        </label>
                        <label class="radio-label">
                            <input onchange="validateRatesInputs()" name="consultant-rate-model" type="radio" value="H" class="radio-input">
                            <span class="radio-custom"></span>
                            &nbsp; Consultant rate hourly. <span style="font-weight: normal"> (Hourly rate is always the same)</span>
                        </label>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6" id="monthlyClientRateEl">
                            <label for="PaymentCondition">Monthly Client Rate</label>
                            <div class="input-container">
                                <input placeholder="Example: $10,000" type="number" class="form-control" step="0.01" name="monthlyClientRate" id="monthlyClientRate">
                            </div>
                        </div>
                        <div class="col-md-6" id="hourlyClientRateEl">
                            <label for="PaymentCondition">Hourly Client Rate</label>
                            <div class="input-container">
                                <input placeholder="Example: $55" type="number" class="form-control" step="0.01" name="hourlyClientRate" id="hourlyClientRate">
                            </div>
                        </div>
                        <div class="col-md-6" id="monthlyConsultantSalaryEl">
                            <label for="PaymentCondition">Monthly Consultant Salary</label>
                            <div class="input-container">
                                <input placeholder="Example: $5,000" type="number" class="form-control" step="0.01" name="monthlySalary" id="monthlySalary">
                            </div>
                        </div>
                        <div class="col-md-6" id="hourlyConsultantSalaryEl">
                            <label for="PaymentCondition">Hourly Consultant Salary</label>
                            <div class="input-container">
                                <input placeholder="Example: $22" type="number" class="form-control" step="0.01" name="hourlySalary" id="hourlySalary">
                            </div>
                        </div>
                    </div>
                </form>

                <div id="modal-btns-cont" style="display:flex; justify-content:center;">
                    <a id="second-btn-cancel" onclick="hideModal('modal-add-consultant')" class="cancel-btn">Cancel</a>&nbsp;
                    <button id="second-btn-saving" onclick="addConsultantToProject('modal-add-consultant')" class="btn-primary-submit">
                        <div style="display:flex;align-items:center;">
                            <div style="display:none; margin-right:5px" id="second-spinner-saving" class="spinner-border" role="status">
                            </div><span></span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/ProjectManagement/sharedProjectsMethods.js"></script>
<script src="~/js/General/sharedConsultantDetailsMethods.js"></script>