@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="~/css/Shared/pagination.css" />
<link rel="stylesheet" href="~/css/ProjectManagement/clients.css" />
<link rel="stylesheet" href="~/css/Shared/sharedInputs.css" />
<link rel="stylesheet" href="~/css/Shared/sharedComponents.css" />

<div style="margin: 0 10px 0 10px; backgroundcolor: #fff;">
    <div class="filters-container">
        <div class="row">
            <div class="search-header-container">
                <div>
                    <h2>CLIENTS</h2>
                    <div class="input-container">
                        <input id="search-input" onchange="enterInSearch(event)" type="text" placeholder="Search" class="form-control">
                        <i class="bi bi-search placeholder-image"></i>
                    </div>
                </div>
                <a id="show-hide-filters-btn" onclick="hideShowFilters()"><i class="bi bi-funnel-fill"></i> Hide Filters </a>
            </div>
            <div class="more-filters-cont">
                <div id="more-filters">
                    <div class="row">
                        <div class="col-sm-1">
                            <div class="radio-group active-inactive-rg">
                                <label class="radio-label">
                                    <input onchange="paginationSubmit(false, true)" name="active-inactive" type="radio" value="S" class="radio-input">
                                    <span class="radio-custom"></span>
                                    &nbsp; Active
                                </label>
                                <label class="radio-label">
                                    <input onchange="paginationSubmit(false, true)" name="active-inactive" type="radio" value="N" class="radio-input">
                                    <span class="radio-custom"></span>
                                    &nbsp; Inactive
                                </label>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="radio-group company-radio-rg">
                                <label class="radio-label">
                                    <input onchange="paginationSubmit(false, true)" type="radio" name="company" value="OCE" class="radio-input">
                                    <span class="radio-custom"></span>
                                    &nbsp; Oceans Consulting
                                </label>
                                <label class="radio-label">
                                    <input onchange="paginationSubmit(false, true)" type="radio" name="company" value="LLC" class="radio-input">
                                    <span class="radio-custom"></span>
                                    &nbsp; OCE, LLC
                                </label>
                            </div>
                        </div>
                        <div class="col-sm-3 text-center">
                            <div class="row">
                                <div class="col-sm-6">
                                    <label for="startDate" class="select-label">Date From</label>
                                    <input onchange="paginationSubmit(false, true)" class="form-control" type="date" id="startDate" />
                                </div>
                                <div class="col-sm-6">
                                    <label for="endDate" class="select-label">Date Until</label>
                                    <input onchange="paginationSubmit(false, true)" class="form-control" type="date" id="endDate" />
                                </div>
                            </div>
                            <span id="dates-val-message" style="font-size:15px; display:flex;" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="principal-buttons">
                        <a asp-area="ProjectManagement" asp-controller="Clients" asp-action="Index" class="cancel-btn"><i class="bi bi-eraser"></i> Clear Filters</a>
                    </div>
                </div>
            </div>
            <partial name="_Pagination" />
        </div>
    </div>
    <div class="global-table-container">
        <table>
            <thead>
                <tr>
                    <th onclick="orderByTableList('Name', 'NameTableHeader', 'sortArrowName')" data-sort="ANY" name="NameTableHeader" class="sortable-col">
                        Client Name
                        <span class="sort-arrow" id="sortArrowName">
                        </span>
                    </th>
                    <th>Is Active</th>
                    <th onclick="orderByTableList('Contact', 'StakeholderTableHeader', 'sortArrowStakeholder')" data-sort="ANY" name="StakeholderTableHeader" class="sortable-col">
                        Stakeholder
                        <span class="sort-arrow" id="sortArrowStakeholder"></span>
                    </th>
                    <th onclick="orderByTableList('ContactOccupation', 'ContactOccupationTableHeader', 'sortArrowContactOccupation')" data-sort="ANY" name="ContactOccupationTableHeader" class="sortable-col">
                        Stakeholder Title
                        <span class="sort-arrow" id="sortArrowContactOccupation">
                        </span>
                    </th>
                    <th>Emails</th>
                    <th>Send Reminders?</th>
                    <th onclick="orderByTableList('AdmissionDate', 'AdmissionDateTableHeader', 'sortArrowAdmissionDate')" data-sort="ANY" name="AdmissionDateTableHeader" class="sortable-col">
                        AdmissionDate
                        <span class="sort-arrow" id="sortArrowAdmissionDate">
                        </span>
                    </th>
                    <th onclick="orderByTableList('PaymentCondition', 'PaymentConditionTableHeader', 'sortArrowPaymentCondition')" data-sort="ANY" name="PaymentConditionTableHeader" class="sortable-col">
                        Payment Condition
                        <span class="sort-arrow" id="sortArrowPaymentCondition">
                        </span>
                    </th>
                    <th>Client Class</th>
                    <th>Address</th>
                    <th>Company</th>
                    <th>Success Manager</th>
                    <th onclick="orderByTableList('LatePaymentFee', 'LatePaymentFeeTableHeader', 'sortArrowLatePaymentFee')" data-sort="ANY" name="LatePaymentFeeTableHeader" class="sortable-col">
                        Late Payment Fee
                        <span class="sort-arrow" id="sortArrowLatePaymentFee">
                        </span>
                    </th>
                    <th>Add Emails For Notifications</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
        <div class="no-results"></div>
    </div>
</div>

<!--MODAL UPDATE CLIENT -->
<div id="modal-update-client" style="display:none">
    <div id="warning-message">
        <div class="container">
            <div class="warning-message-container">
                <div>
                    <div id="warning-message-cont">
                        <div>
                            <h2>UPDATE CLIENT</h2>
                            <form id="form-update">
                                <div class="inputs-header-cont">
                                    <div class="input-container col-sm-8" style="margin-top: 0">
                                        <input id="holidaysListId" name="consultantHolidayId" type="hidden">
                                        <input formnovalidate="holidayName" name="holidayName" type="text" class="form-control" id="holidayName" placeholder="Insert the Holidays list Name">
                                    </div>
                                    <div class="col-sm-4">
                                        <span class="arrow-down"></span>
                                        <select id="selectYear" name="holidayYear" class="form-select">
                                        </select>
                                    </div>
                                </div>
                                <div class="add-dates-btn-cont">
                                    <a style="padding-right: 10px" class="blue-btn" onclick="addNewDateRow(null)"><i class="bi bi-plus"></i> Add Date</a>
                                </div>
                                <div id="holidays-dates-container" class="modal-scroll-container">
                                </div>
                            </form>
                            <div id="modal-btns-cont" style="display:flex; justify-content:center;">
                                <a id="btn-cancel" onclick="hideModal('modal-create-holiday')" class="cancel-btn">Cancel</a>&nbsp;
                                <button id="btn-saving" onclick="createUpdateHoliday('modal-create-holiday')" class="btn-primary-submit">
                                    <div style="display:flex;align-items:center;">
                                        <div style="display:none; margin-right:5px" id="spinner-saving" class="spinner-border" role="status">
                                        </div><span></span>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
<script src="~/js/Shared/pagination.js"></script>
<script src="~/js/ProjectManagement/clients.js"></script>
    }
