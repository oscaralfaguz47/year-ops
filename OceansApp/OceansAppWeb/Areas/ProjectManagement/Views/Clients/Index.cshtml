@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="~/css/Shared/pagination.css" />
<link rel="stylesheet" href="~/css/ProjectManagement/clients.css" />

<div style="margin: 0 10px 0 10px; backgroundcolor: #fff;">
    <div class="filters-container">
        <div class="row">
            <div class="search-header-container">
                <div>
                    <h2>CLIENTS</h2>
                    <div class="input-container">
                        <input id="search-input" onkeypress="enterInSearch(event)" type="text" placeholder="Search" class="form-control">
                        <i class="bi bi-search placeholder-image"></i>
                    </div>
                </div>
                <a id="show-hide-filters-btn" onclick="hideShowFilters()"><i class="bi bi-funnel-fill"></i> Hide Filters </a>
            </div>
            <div class="more-filters-cont">
                <div id="more-filters">
                    <div class="row">

                    </div>
                    <div class="principal-buttons">
                        <a asp-area="General" asp-controller="ConsultantHolidays" asp-action="Index" class="cancel-btn"><i class="bi bi-eraser"></i> Clear Filters</a>
                    </div>
                </div>
            </div>
            <partial name="_Pagination" />
        </div>
    </div>
    <div class="global-table-container">
        <table class="">
            <thead>
                <tr>
                    <th onclick="orderByTableList('Name', 'NameTableHeader', 'sortArrowName')" data-sort="ANY" name="NameTableHeader" class="table-col-big sortable-col">
                        Holidays List Name
                        <span class="sort-arrow" id="sortArrowName">
                        </span>
                    </th>
                    <th onclick="orderByTableList('Year', 'YearTableHeader', 'sortArrowYear')" data-sort="ANY" name="YearTableHeader" class="table-col-little sortable-col">
                        Contact
                        <span class="sort-arrow" id="sortArrowYear"></span>
                    </th>
                    <th onclick="orderByTableList('CreationDate', 'CreationDateTableHeader', 'sortArrowCreationDate')" data-sort="ANY" name="CreationDateTableHeader" class="table-col-medium sortable-col">
                        Creation Date
                        <span class="sort-arrow" id="sortArrowCreationDate">
                        </span>
                    </th>
                    <th class="table-col-medium">Created By</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
        <div class="no-results"></div>
    </div>
</div>

<!--MODAL UPDATE CLIENT -->


@section Scripts{
<script src="~/js/Shared/pagination.js"></script>
<script src="~/js/ProjectManagement/clients.js"></script>
    }
