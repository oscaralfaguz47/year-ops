<link rel="stylesheet" href="~/css/AccountManagement/Projects/projectConsultantAssignedHistoryModal.css?v=@DateTime.Now.Ticks" />

<div id="modal-consultant-history" class="global-modal" style="display:none">
    <div class="global-modal-content">
        <div class="close-btn-container"><button id="close-modal-x-btn" onclick="hideModal('modal-consultant-history')">x</button></div>
        <h2>CONSULTANT HISTORY</h2>

        <div>
            <label class="titles strong-label">ASSIGNED FIRST TIME</label>
            <div class="section" id="first-record-section">
                <div class="record-header" id="first-record-header"></div>
                <div class="global-table-container">
                    <table id="first-record-table"></table>
                </div>
            </div>
            <label class="titles strong-label">MOVEMENTS HISTORY</label>
            <div class="section global-table-container" id="changes-section"></div>
        </div>

        <div id="modal-btns-cont" style="display:flex; justify-content:center;">
            <a id="second-btn-cancel" onclick="hideModal('modal-consultant-history')" class="cancel-btn">Close</a>&nbsp;
        </div>
    </div>
</div>

<script src="~/js/AccountManagement/Projects/projectConsultantAssignedHistoryModal.js?v=@DateTime.Now.Ticks"></script>
