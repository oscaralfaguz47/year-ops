@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers
<link rel="stylesheet" href="~/css/AccountManagement/sharedProjectsMethods.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/General/sharedConsultantDetailsMethods.css?v=@DateTime.Now.Ticks" />

<div id="modal-add-consultant" class="global-modal" style="display:none">
    <div style="width: 650px" class="global-modal-content">
        <div class="container">
            <div>
                <div class="close-btn-container"><button id="close-modal-x-btn" onclick="hideModal('modal-add-consultant')">x</button></div>
                <h2 id="add-consultant-modal-title"></h2>
                <form id="form-add-update-consultant">
                    <div id="consultants-search-cont">
                        <div id="search-input-cont" class="input-container">
                            <input id="search-consultant-input" autocomplete="off" oninput="searchConsultantsBySearchText(this, 'consultantIdFromSearch', 'consultantNameInput', 'consultantEmailInput')" type="text" placeholder="Search consultant" class="form-control">
                            <i class="bi bi-search placeholder-image"></i>
                            <div id="consultant-search-results" class="search-results"></div>
                        </div>
                        <input type="hidden" name="proConsAssignedId" id="proConsAssignedId">
                        <input type="hidden" name="consultantIdFromSearch" id="consultantIdFromSearch">
                    </div>
                    <div class="row">
                        <div class="col-lg-6">
                            <label>Consultant Name <span class="required-asterisk">*</span></label>
                            <div class="input-container">
                                <input disabled type="text" class="form-control" name="consultantNameInput" id="consultantNameInput">
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <label>Consultant Email <span class="required-asterisk">*</span></label>
                            <div class="input-container">
                                <input disabled type="text" class="form-control" id="consultantEmailInput">
                            </div>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-lg-6">
                            <label>Position <span class="required-asterisk">*</span></label>
                            <span class="arrow-down"></span>
                            <select class="form-select" name="position" id="positionSelect">
                            </select>
                        </div>
                    </div>

                    <div id="client-rate-section" style="margin-top: 5px" class="radio-group monthly-mode-rg">
                        <label style="margin-top: 0" class="radio-label">
                            <input onchange="validateRatesInputs()" name="client-rate-model" type="radio" value="H" checked class="radio-input">
                            <span class="radio-custom"></span>
                            &nbsp; Client rate hourly.<span style="font-weight: normal"> (Ex: $55)</span>
                        </label>
                        <label class="radio-label">
                            <input onchange="validateRatesInputs()" name="client-rate-model" type="radio" value="M" class="radio-input">
                            <span class="radio-custom"></span>
                            &nbsp; Client rate monthly.<span style="font-weight: normal"> (Monthly On Time Fee. Ex: $10,000)</span>
                        </label>
                    </div>

                    <div class="row">
                        <div id="client-rate-inputs">
                            <div class="col-md-6" id="monthlyClientRateEl">
                                <label for="PaymentCondition">Monthly Client Rate <span class="required-asterisk">*</span></label>
                                <div class="input-container">
                                    <input placeholder="$$$" oninput="limitDigitsAndDecimals(this)" type="number" class="form-control" name="monthlyClientRate" id="monthlyClientRate">
                                </div>
                            </div>
                            <div class="col-md-6" id="hourlyClientRateEl">
                                <label for="PaymentCondition">Hourly Client Rate <span class="required-asterisk">*</span></label>
                                <div class="input-container">
                                    <input placeholder="$$$" type="number" class="form-control" oninput="limitDigitsAndDecimals(this)" name="hourlyClientRate" id="hourlyClientRate">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div style="margin-top: 5px" class="radio-group">
                        <label class="radio-label">
                            <input onchange="validateRatesInputs()" name="consultant-payment-model" checked type="radio" value="O" class="radio-input">
                            <span class="radio-custom"></span>
                            &nbsp; Consultant salary Oceans. <span style="font-weight: normal"> (Is paid only by Oceans)</span>
                        </label>
                        <label class="radio-label">
                            <input onchange="validateRatesInputs()" name="consultant-payment-model" type="radio" value="Hy" class="radio-input">
                            <span class="radio-custom"></span>
                            &nbsp; Consultant salary hybrid. <span style="font-weight: normal"> (Is paid between Oceans and the partner)</span>
                        </label>
                        <label class="radio-label">
                            <input onchange="validateRatesInputs()" name="consultant-payment-model" type="radio" value="T" class="radio-input">
                            <span class="radio-custom"></span>
                            &nbsp; A single salary paid by a the partner. <span style="font-weight: normal"> (Nothing from Oceans)</span>
                        </label>
                    </div>
                    <div style="margin-top: 5px" class="radio-group" id="oceans-payment-radio-section">
                        <label style="margin-top: 0" class="radio-label">
                            <input onchange="validateRatesInputs()" name="consultant-rate-model" type="radio" checked value="M" class="radio-input">
                            <span class="radio-custom"></span>
                            &nbsp; Consultant rate monthly.<span style="font-weight: normal"> (Set Monthly rate)</span>
                        </label>
                        <label class="radio-label">
                            <input onchange="validateRatesInputs()" name="consultant-rate-model" type="radio" value="H" class="radio-input">
                            <span class="radio-custom"></span>
                            &nbsp; Consultant rate hourly. <span style="font-weight: normal"> (Hourly rate is always the same)</span>
                        </label>
                    </div>

                    <div class="row">
                        <div style="display: flex" id="oceans-payment-section">
                            <div class="col-md-6" id="monthlyConsultantSalaryEl">
                                <label for="PaymentCondition">Monthly Consultant Salary - Oceans <span class="required-asterisk">*</span></label>
                                <div class="input-container">
                                    <input placeholder="$$$" type="number" oninput="limitDigitsAndDecimals(this)" class="form-control" name="monthlySalary" id="monthlySalary">
                                </div>
                            </div>
                            <div style="text-align: center" class="col-md-6" id="isMonthlySalaryCalculatedPerHour">
                                <label for="PaymentCondition">Monthly salary calculation method</label>
                                <div class="checkbox-cont">
                                    <input type="checkbox" class="form-check-input" id="calculationMethod" checked name="isMonthlySalaryCalculatedPerHour">
                                    <label class="form-check-label" for="calculationMethod"> Is calculated per hour</label>
                                    <div class="tooltip-container ">
                                        <i class="bi bi-question-circle tooltip-target"></i>
                                        <div class="tooltip-content">
                                            <div class="tooltip-arrow"></div>
                                            Uncheck if the salary  is always the same (Monthly), salary does not change even if number of hours change.
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6" id="hourlyConsultantSalaryEl">
                                <label for="PaymentCondition">Hourly Consultant Salary - Oceans <span class="required-asterisk">*</span></label>
                                <div class="input-container">
                                    <input placeholder="$$$" type="number" oninput="limitDigitsAndDecimals(this)" class="form-control" name="hourlySalary" id="hourlySalary">
                                </div>
                            </div>
                        </div>
                        <div style="display:flex" id="thirdPartyConsultantSalaryEl">
                            <div style="padding: 0 4px" class="col-md-6">
                                <label for="PaymentCondition">Partner <span class="required-asterisk">*</span></label>
                                <select class="form-select" id="PartnerSelect" name="idPartner">
                                </select>
                            </div>
                            <div style="padding: 0 4px" class="col-md-6">
                                <label for="PaymentCondition">Consultant Monthly Salary - Partner <span class="required-asterisk">*</span></label>
                                <div class="input-container">
                                    <input placeholder="$$$" type="number" oninput="limitDigitsAndDecimals(this)" class="form-control" name="thirdPartySalary" id="thirdPartySalary">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="checkbox-cont">
                                <input type="checkbox" class="form-check-input" id="accessToTrackingTool" checked name="accessToTrackingTool">
                                <label class="form-check-label" for="accessToTrackingTool"> Access to the tracking tool? <img class="global-icon" src="~/img/globalicons/watch-blue.webp" /></label>
                            </div>
                        </div>
                        <div class="row">
                            <div class="checkbox-cont">
                                <input type="checkbox" class="form-check-input" id="isDefaultProject" name="isDefaultProject">
                                <label class="form-check-label" for="isDefaultProject"> Is default project?</label>
                                <div class="tooltip-container ">
                                    <i class="bi bi-question-circle tooltip-target"></i>
                                    <div class="tooltip-content">
                                        <div class="tooltip-arrow"></div>
                                        The default project defines the base amount of which the hour pricing will be calculated for holidays, interviews, etc.
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label for="StartDate">Action Date</label> <span class="required-asterisk">*</span> <div class="tooltip-container ">
                                    <i class="bi bi-question-circle tooltip-target"></i>
                                    <div class="tooltip-content">
                                        <div class="tooltip-arrow"></div>
                                        Date on which the changes will take effect
                                    </div>
                                </div>
                                <div class="">
                                    <input type="date" class="form-control" name="actionDate" id="actionDate">
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <div id="modal-btns-cont" style="display:flex; justify-content:center;">
                    <a id="second-btn-cancel" onclick="hideModal('modal-add-consultant')" class="cancel-btn">Cancel</a>&nbsp;
                    <button type="button" id="second-btn-saving" onclick="addConsultantToProject('modal-add-consultant')" class="btn-primary-submit">
                        <div style="display:flex;align-items:center;">
                            <div style="display:none; margin-right:5px" id="second-spinner-saving" class="spinner-border" role="status">
                            </div><span></span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/AccountManagement/Projects/addUpdateConsultantInProject.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/General/sharedConsultantDetailsMethods.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AdminCenter/ConsultantPositions/consultantPositionsFillDropdowns.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/inputValidations.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AccountManagement/Partners/partnersFillDropdown.js?v=@DateTime.Now.Ticks"></script>