@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="~/css/Shared/pagination.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/AccountManagement/projects.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/sharedInputs.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/sharedComponents.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/contentPages.css?v=@DateTime.Now.Ticks" />

<div style="margin: 0 10px 0 10px; backgroundcolor: #fff;">
    <div class="principal-header-container">
        <div class="filters-container">
            <div class="header-page">
                <h2>PROJECTS</h2>
            </div>
            <partial name="_Pagination" />
        </div>
        <div class="table-header-actions">
            <div class="input-container">
                <input id="search-input" onchange="enterInSearch(event)" type="text" placeholder="Search" class="form-control">
                <i class="bi bi-search placeholder-image"></i>
            </div>
            <div class="action-btns-container">
                <button title="Create new project" id="openSidebarBtn" onclick="displayUpdateModal('modal-update-create-project',null)"><img src="/icons/Shared/add.svg"></button>
                <button title="See more filters" id="openSidebarBtn" onclick="displayMoreFiltersProjects()"><img src="/icons/Shared/filter.svg"></button>
            </div>
        </div>
    </div>

    <div class="global-table-container">
        <table>
            <thead>
                <tr>
                    <th onclick="orderByTableList('Name', 'NameTableHeader', 'sortArrowName')" data-sort="ANY" name="NameTableHeader" class="sortable-col">
                        Project Name
                        <span class="sort-arrow" id="sortArrowName">
                        </span>
                    </th>
                    <th onclick="orderByTableList('ClientName', 'ClientNameTableHeader', 'sortArrowClientName')" data-sort="ANY" name="ClientNameTableHeader" class="sortable-col">
                        Client Name
                        <span class="sort-arrow" id="sortArrowClientName"></span>
                    </th>
                    <th onclick="orderByTableList('StartDate', 'StartDateTableHeader', 'sortArrowStartDate')" data-sort="ANY" name="StartDateTableHeader" class="sortable-col">
                        Start Date
                        <span class="sort-arrow" id="sortArrowStartDate">
                        </span>
                    </th>
                    <th>Is Active</th>
                    <th onclick="orderByTableList('SuccessManagerName', 'SuccessManagerNameTableHeader', 'sortArrowSuccessManagerName')" data-sort="ANY" name="SuccessManagerNameTableHeader" class="sortable-col">
                        Success Manager
                        <span class="sort-arrow" id="sortArrowSuccessManagerName">
                        </span>
                    </th>
                    <th>Assigned Consultants</th>
                    <th>Client has own tracking tool</th>
                    <th>Is Billable</th>
                    <th onclick="orderByTableList('Description', 'DescriptionTableHeader', 'sortArrowDescription')" data-sort="ANY" name="DescriptionTableHeader" class="sortable-col">
                        Description
                        <span class="sort-arrow" id="sortArrowDescription"></span>
                    </th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
        <div class="no-results"></div>
    </div>
</div>

<partial name="_SidebarRightPartial" />

<!--MODAL UPDATE CREATE PROJECT -->
<div id="modal-update-create-project" class="global-modal" style="display:none">
    <div class="global-modal-content">
        <div class="container">
            <div>
                <div class="close-btn-container"><button id="close-modal-x-btn" onclick="hideModal('modal-update-create-project')">x</button></div>
                <h2 id="create-Project-modal-title"></h2>
                <form id="form-create-update">
                    <input type="hidden" name="projectId">
                    <label for="Name">Project Name</label>
                    <div class="input-container">
                        <input type="text" class="form-control" name="projectName">
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <label for="Contact">Description</label>
                            <div class="input-container">
                                <input type="text" class="form-control" name="description">
                            </div>
                        </div>
                    </div>
                    <label>Project Type</label>
                    <div id="project-type-inputs-cont">
                        <div style="margin-top: 5px; margin-bottom: 10px; display: flex;" class="">
                            <label style="margin-top: 0; margin-right: 20px;" class="radio-label">
                                <input onchange="validateProjectType()" id="external-pt" name="projectTypeRb" type="radio" value="E" checked class="radio-input">
                                <span class="radio-custom"></span>
                                &nbsp; Client External
                            </label>
                            <label class="radio-label">
                                <input onchange="validateProjectType()" id="internal-pt" name="projectTypeRb" type="radio" value="I" class="radio-input">
                                <span class="radio-custom"></span>
                                &nbsp; Administrative Internal
                            </label>
                        </div>
                    </div>
                    <div id="saved-project-type-label" style="margin-bottom: 10px;">
                        <label>This project is type: <span style="font-weight: bold;" id="saved-project-type-span"></span></label>
                    </div>

                    <div class="row">
                        <div id="client-select-cont" class="col-md-7">
                            <label for="ClientSelect">Client</label>
                            <div class="custom-select">
                                <span class="arrow-down"></span>
                                <select class="form-select" id="ClientSelect" name="client">
                                </select>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label for="StartDate">Start Date</label>
                            <div class="">
                                <input type="date" class="form-control" name="startDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label for="successManager">Success Manager</label>
                            <div class="custom-select">
                                <span class="arrow-down"></span>
                                <select disabled class="form-select" id="successManagerIdSelect" name="successManager">
                                </select>
                            </div>
                        </div>
                    </div>

                    <div style="margin-top:8px">
                        <div class="checkbox-cont">
                            <input type="checkbox" class="form-check-input" id="IsActive" checked name="isActive">
                            <label class="form-check-label" for="IsActive"> Is Active</label>
                        </div>
                        <div id="billable-tracking-tool-cont" class="mb-3">
                            <div class="checkbox-cont">
                                <input type="checkbox" class="form-check-input" id="IsBillable" checked name="isBillable">
                                <label class="form-check-label" for="IsBillable"> Is billable $</label>
                            </div>
                            <div class="checkbox-cont">
                                <input type="checkbox" class="form-check-input" id="ClientHasTrackingTool" name="clientHasTrackingTool">
                                <label class="form-check-label" for="ClientHasTrackingTool"> The client has tracking tool</label>
                            </div>
                        </div>
                    </div>
                    <div class="green-label m-3" id="saved-project-message" style="text-align: center">
                        <label>Now you can add consultants to the project <i class="bi bi-check-circle-fill"></i></label>
                    </div>
                    <div id="consultants-assigned-section">
                        <div style="display: flex;justify-content: space-between;align-items: center; margin-top:5px;">
                            <label><strong>Assigned Consultants</strong></label>
                            <a style="padding-right: 10px" class="blue-btn" onclick="displayAddUpdateConsultant('modal-add-consultant', null)"><i class="bi bi-plus"></i> Add Consultant</a>
                        </div>
                        <div id="consultants-container" class="modal-scroll-container">
                        </div>
                    </div>
                </form>

                <div id="modal-btns-cont" style="display:flex; justify-content:center;">
                    <a id="btn-cancel" onclick="hideModal('modal-update-create-project')" class="cancel-btn">Cancel</a>&nbsp;
                    <button type="button" id="btn-saving" onclick="createUpdateProject('modal-update-create-project')" class="btn-primary-submit">
                        <div style="display:flex;align-items:center;">
                            <div style="display:none; margin-right:5px" id="spinner-saving" class="spinner-border" role="status">
                            </div><span></span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!--MODAL ADD CONSULTANT TO PROJECT -->
<div>
    <partial name="_AddConsultantToProjectModalPartial" />
</div>

<!--MODAL CONSULTANT HISTORY -->
<div>
    <partial name="_ProjectConsultantAssignedHistoryModalVM" />
</div>

<script src="~/js/Shared/pagination.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/sharedComponents.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AccountManagement/projects.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AccountManagement/clientsSectionFillDropdowns.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/General/generalSectionFillDropdowns.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/inputValidations.js?v=@DateTime.Now.Ticks"></script>