@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="~/css/Shared/pagination.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/AccountManagement/projects.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/sharedInputs.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/sharedComponents.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/contentPages.css?v=@DateTime.Now.Ticks" />

<div style="margin: 0 10px 0 10px; backgroundcolor: #fff;">
    <div class="principal-header-container">
        <div class="filters-container">
            <div class="header-page">
                <h2>PROJECTS</h2>
            </div>
            <partial name="_Pagination" />
        </div>
        <div class="table-header-actions">
            <div class="input-container">
                <input id="search-input" onchange="enterInSearch(event)" type="text" placeholder="Search" class="form-control">
                <i class="bi bi-search placeholder-image"></i>
            </div>
            <div class="action-btns-container">
                <button title="Create new project" id="openSidebarBtn" onclick="displayUpdateCreateProjectModal('modal-update-create-project',null)"><img src="/icons/Shared/add.svg"></button>
                <button title="See more filters" id="openSidebarBtn" onclick="displayMoreFiltersProjects()"><img src="/icons/Shared/filter.svg"></button>
            </div>
        </div>
    </div>

    <div class="global-table-container">
        <table>
            <thead>
                <tr>
                    <th onclick="orderByTableList('Name', 'NameTableHeader', 'sortArrowName')" data-sort="ANY" name="NameTableHeader" class="sortable-col">
                        Project Name
                        <span class="sort-arrow" id="sortArrowName">
                        </span>
                    </th>
                    <th onclick="orderByTableList('ClientName', 'ClientNameTableHeader', 'sortArrowClientName')" data-sort="ANY" name="ClientNameTableHeader" class="sortable-col">
                        Client Name
                        <span class="sort-arrow" id="sortArrowClientName"></span>
                    </th>
                    <th onclick="orderByTableList('StartDate', 'StartDateTableHeader', 'sortArrowStartDate')" data-sort="ANY" name="StartDateTableHeader" class="sortable-col">
                        Start Date
                        <span class="sort-arrow" id="sortArrowStartDate">
                        </span>
                    </th>
                    <th>Is Active</th>
                    <th onclick="orderByTableList('SuccessManagerName', 'SuccessManagerNameTableHeader', 'sortArrowSuccessManagerName')" data-sort="ANY" name="SuccessManagerNameTableHeader" class="sortable-col">
                        Success Manager
                        <span class="sort-arrow" id="sortArrowSuccessManagerName">
                        </span>
                    </th>
                    <th>Assigned Consultants</th>
                    <th>Client has own tracking tool</th>
                    <th>Is Billable</th>
                    <th onclick="orderByTableList('Description', 'DescriptionTableHeader', 'sortArrowDescription')" data-sort="ANY" name="DescriptionTableHeader" class="sortable-col">
                        Description
                        <span class="sort-arrow" id="sortArrowDescription"></span>
                    </th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
        <div class="no-results"></div>
    </div>
</div>

<partial name="_SidebarRightPartial" />

<!--MODAL UPDATE CREATE PROJECT -->
<div>
    <partial name="_CreateUpdateProjectModalPartial" />
</div>

<!--MODAL ADD CONSULTANT TO PROJECT -->
<div>
    <partial name="_AddConsultantToProjectModalPartial" />
</div>

<!--MODAL CONSULTANT HISTORY -->
<div>
    <partial name="_ProjectConsultantAssignedHistoryModalVM" />
</div>

<script src="~/js/Shared/pagination.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/sharedComponents.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AccountManagement/projects.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/AccountManagement/clientsSectionFillDropdowns.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/General/generalSectionFillDropdowns.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/inputValidations.js?v=@DateTime.Now.Ticks"></script>