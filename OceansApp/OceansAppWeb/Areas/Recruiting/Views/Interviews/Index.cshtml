@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="~/css/Shared/pagination.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/sharedComponents.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/contentPages.css?v=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="~/css/Shared/Labels/transactionStatuses.css?v=@DateTime.Now.Ticks" />

<div style="margin: 0 10px 0 10px; backgroundcolor: #fff;">
    <div class="principal-header-container">
        <div class="filters-container">
            <div class="header-page">
                <h2>INTERVIEWS</h2>
            </div>
            <partial name="_Pagination" />
        </div>
        <div class="table-header-actions">
            <div class="input-container">
                <input id="search-input" onchange="enterInSearch(event)" type="text" placeholder="Search" class="form-control">
                <i class="bi bi-search placeholder-image"></i>
            </div>
            <div class="action-btns-container">
                <button title="Add new interview" id="openSidebarBtn" onclick="displayUpdateCreateInterviewModal('modal-update-create-interview',null)"><img src="/icons/Shared/add.svg"></button>
            </div>
        </div>
    </div>

    <div class="global-table-container">
        <table>
            <thead>
                <tr>
                    <th onclick="orderByTableList('ConsultantName', 'ConsultantNameTableHeader', 'sortArrowConsultantName')" data-sort="ANY" name="ConsultantNameTableHeader" class="sortable-col">
                        Consultant Name
                        <span class="sort-arrow" id="sortArrowConsultantName">
                        </span>
                    </th>
                    <th onclick="orderByTableList('DurationMinutes', 'DurationMinutesTableHeader', 'sortArrowDurationMinutes')" data-sort="ANY" name="DurationMinutesTableHeader" class="sortable-col">
                        Duration in Minutes
                        <span class="sort-arrow" id="sortArrowDurationMinutes"></span>
                    </th>
                    <th>
                        Duration in Hours
                    </th>
                    <th onclick="orderByTableList('Date', 'DateTableHeader', 'sortArrowDate')" data-sort="ANY" name="DateTableHeader" class="sortable-col">
                        Action Date
                        <span class="sort-arrow" id="sortArrowDate"></span>
                    </th>
                    <th onclick="orderByTableList('TransactionStatusName', 'TransactionStatusNameTableHeader', 'sortArrowTransactionStatusName')" data-sort="ANY" name="TransactionStatusNameTableHeader" class="sortable-col">
                        Status
                        <span class="sort-arrow" id="sortArrowTransactionStatusName"></span>
                    </th>
                    <th onclick="orderByTableList('UserCreatedBy', 'UserCreatedByTableHeader', 'sortArrowUserCreatedBy')" data-sort="ANY" name="UserCreatedByTableHeader" class="sortable-col">
                        Created By
                        <span class="sort-arrow" id="sortArrowUserCreatedBy"></span>
                    </th>
                    <th onclick="orderByTableList('CreationDate', 'CreationDateTableHeader', 'sortArrowCreationDate')" data-sort="ANY" name="CreationDateTableHeader" class="sortable-col">
                        Creation Date
                        <span class="sort-arrow" id="sortArrowCreationDate"></span>
                    </th>
                    <th onclick="orderByTableList('LastUpdatedBy', 'LastUpdatedByTableHeader', 'sortArrowLastUpdatedBy')" data-sort="ANY" name="LastUpdatedByTableHeader" class="sortable-col">
                        Last Updated By
                        <span class="sort-arrow" id="sortArrowLastUpdatedBy"></span>
                    </th>
                    <th onclick="orderByTableList('LastUpdateDate', 'LastUpdateDateTableHeader', 'sortArrowLastUpdateDate')" data-sort="ANY" name="LastUpdateDateTableHeader" class="sortable-col">
                        Last Updated Date
                        <span class="sort-arrow" id="sortArrowLastUpdateDate"></span>
                    </th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
        <div class="no-results"></div>
    </div>
</div>

<!--CREATE UPDATE INTERVIEW-->
<div>
    <partial name="_CreateUpdateInterviewModalPartialView" />
</div>

<script src="~/js/Recruiting/Interviews/interviews.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/pagination.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/Labels/transactionStatuses.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/sharedComponents.js?v=@DateTime.Now.Ticks"></script>
<script src="~/js/Shared/Dates/datesMethods.js?v=@DateTime.Now.Ticks"></script>
